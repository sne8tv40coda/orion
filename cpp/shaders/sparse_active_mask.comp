#version 460
#extension GL_EXT_scalar_block_layout : require
#extension GL_GOOGLE_include_directive : require


layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0, r8ui)
uniform uimage2D sparseActiveMaskOut;

layout(binding = 1, std430) readonly buffer BlueNoiseTable
{
    uint words[64u * 128u * 128u / 4u];
} blueNoise;

#ifndef SPARSE_EDGE_AWARE
// 1 = 用上一帧的深度/亮度对比把高对比块抬到全速率（需要宿主补 binding 2/3）。
// 0 = 关闭（**默认**：宿主还没补描述符，打开会因缺绑定导致管线创建失败）。
#define SPARSE_EDGE_AWARE 0
#endif

#if SPARSE_EDGE_AWARE
layout(binding = 2, set = 0) uniform sampler2D prevDepthTex;   // 上一帧深度（rgen 的 depthImage）
layout(binding = 3, set = 0) uniform sampler2D prevColorTex;   // 上一帧颜色（rtOutput）

// 深度/亮度高对比检测：阴影边界、几何轮廓都会在这里被判出来。
bool sparseEdgeActive(uvec2 pixelCoord, uvec2 extent)
{
    const vec2 uv = (vec2(pixelCoord) + vec2(0.5)) / vec2(max(extent, uvec2(1u)));

    float d0 = textureLod(prevDepthTex, uv, 0.0).r;
    vec3  c0 = textureLod(prevColorTex, uv, 0.0).rgb;
    float l0 = dot(c0, vec3(0.2126, 0.7152, 0.0722));

    float bestDepth = 0.0;
    float bestLuma = 0.0;

    for(int i = 0; i < 4; ++i)
    {
        const vec2 offset = (i == 0) ? vec2( 1.0,  0.0)
                          : (i == 1) ? vec2(-1.0,  0.0)
                          : (i == 2) ? vec2( 0.0,  1.0)
                                     : vec2( 0.0, -1.0);
        const vec2 uvN = uv + offset / vec2(max(extent, uvec2(1u)));

        const float d1 = textureLod(prevDepthTex, uvN, 0.0).r;
        const vec3  c1 = textureLod(prevColorTex, uvN, 0.0).rgb;
        const float l1 = dot(c1, vec3(0.2126, 0.7152, 0.0722));

        bestDepth = max(bestDepth, abs(d1 - d0));
        bestLuma = max(bestLuma, abs(l1 - l0) / max(max(l1, l0), 1.0e-3));
    }

    // 经验阈值：深度 0.15（相对量级，reverse-Z 下相邻面差远大于此）；
    // 亮度 35%（相对）。命中任一 ⇒ 这一块按全速率处理。
    return bestDepth > 0.15 || bestLuma > 0.35;
}
#endif

layout(push_constant) uniform SparseMaskPush
{
    uint width;
    uint height;
    uint frameIndex;
    uint maskWidth;
    float samplingRate;
    uint pad0;
    uint pad1;
    uint pad2;
} pc;
// 与 rt_test.rgen 的 vptSparseBlueNoiseThreshold 逐行相同。
float sparseBlueNoiseThreshold(uvec2 pixelCoord, uint frameIdx)
{
    const uint x = pixelCoord.x & 127u;
    const uint y = pixelCoord.y & 127u;
    const uint layer = frameIdx & 63u;
    const uint byteIndex = 16384u * layer + 128u * y + x;
    const uint word = blueNoise.words[byteIndex >> 2u];
    const uint raw = (word >> ((byteIndex & 3u) * 8u)) & 0xFFu;
    return float(raw) * (1.0 / 255.0);
}

// =====================================================
// 2026-11-02：块内分层选点（替代逐像素蓝噪声独立抽签）。
//
// 动因：蓝噪声阈值独立抽签只保证**统计**上 rate 比例，单个 8×8 块每帧的活跃
// 个数是二项分布（k=19 时 σ≈3.6），而且某像素可能连续 3~4 帧落空、下 3 帧连着
// 命中 —— 时域 cover 不均匀，RR 的 history age 分布跟着乱。
//
// 这里换成 RTXPT `Rtxpt/Shaders/Misc/SubSampling.h` 的 BLOCK_STRATIFIED 口径
// （它自己的 SOBOL_BLOCK 也是同一个性质）：把 8×8 块看成 64 个槽位，
//   k      = round(rate * 64)            块内每帧恰好 k 个活跃
//   offset = (frameIdx * k) mod 64       起点随帧滚动
//   q      = bitReverse6(块内索引)        把连续弧打散到块内各处
//   active = ((q - offset) mod 64) < k
// 性质：块内每帧恰好 k 个；64 帧（一个 cycle）内每个像素被选中恰好 k 次
// （k 与 64 互质时一轮走遍全部 64 个起点）。空间上不再聚簇，时域上精确分层。
//
// A/B：-DSPARSE_LAYERED_PATTERN=0 回到蓝噪声独立抽签。
// =====================================================
// 2026-11-02 实测回退：默认 0（走蓝噪声）。
// 用 bitReverse6 实现"块内恰好 k 个"时出了满屏竖向黑线 —— 因为 slot = y*8+x 的
// 低 3 位是 x，bit-reverse 后 x 的位跑到高位，[offset, offset+k) 这条连续弧映射
// 回 8×8 网格就变成"不同 y、相同 x 的列同时活跃"，等于每帧画竖条纹，RR 时域平均
// 也消不掉。要重做必须换成空间上无规律的置换（Kensler permute），不能靠位反转。
#ifndef SPARSE_LAYERED_PATTERN
#define SPARSE_LAYERED_PATTERN 0
#endif

const uint kLayeredTileSize = 8u;
const uint kLayeredSlotCount = kLayeredTileSize * kLayeredTileSize;

uint sparseBitReverse6(uint value)
{
    uint reversed = 0u;
    reversed |= ((value >> 0u) & 1u) << 5u;
    reversed |= ((value >> 1u) & 1u) << 4u;
    reversed |= ((value >> 2u) & 1u) << 3u;
    reversed |= ((value >> 3u) & 1u) << 2u;
    reversed |= ((value >> 4u) & 1u) << 1u;
    reversed |= ((value >> 5u) & 1u) << 0u;
    return reversed;
}

bool sparseLayeredActive(uvec2 pixelCoord, uint frameIdx, float samplingRate)
{
    const uint slotCount =
        uint(clamp(samplingRate, 0.0, 1.0) * float(kLayeredSlotCount) + 0.5);
    if(slotCount == 0u)
    {
        return false;
    }
    if(slotCount >= kLayeredSlotCount)
    {
        return true;
    }

    const uint slot =
        (pixelCoord.y & (kLayeredTileSize - 1u)) * kLayeredTileSize +
        (pixelCoord.x & (kLayeredTileSize - 1u));
    // bit-reverse：把 [offset, offset+k) 这条连续弧打散到块内各处，
    // 避免活跃像素在块内聚成一片。
    const uint shuffled = sparseBitReverse6(slot);
    // 只取 frameIdx 的低 6 位即可 —— k*64 mod 64 恒为 0，高位不影响结果，
    // 而且这样 frameIdx 增长不会溢出。
    const uint offset = ((frameIdx & (kLayeredSlotCount - 1u)) * slotCount) &
        (kLayeredSlotCount - 1u);

    return ((shuffled + kLayeredSlotCount - offset) &
        (kLayeredSlotCount - 1u)) < slotCount;
}

#ifndef SPARSE_ORDERED_BAYER
// 1 = 有序抖动（**默认**，空间/时域都均匀）；0 = 蓝噪声独立抽签（旧行为）。
#define SPARSE_ORDERED_BAYER 1
#endif

// Bayer 4x4（0..15）。任意 k 下，相邻的 k 个阈值在 4x4 块内尽量散开：
// 既没有蓝噪声的时域空档，也没有 bit-reverse 那种竖条纹退化。
const uint kSparseBayer4x4[16] =
{
    0u,  8u,  2u, 10u,
    12u, 4u, 14u,  6u,
    3u, 11u,  1u,  9u,
    15u, 7u, 13u,  5u
};

bool sparseOrderedActive(uvec2 pixelCoord, uint frameIdx, float samplingRate)
{
    const uint slots = 16u;
    const uint activeSlots =
        uint(clamp(samplingRate, 0.0, 1.0) * float(slots) + 0.5);

    if(activeSlots == 0u)
    {
        return false;
    }
    if(activeSlots >= slots)
    {
        return true;
    }

    const uint bayer =
        kSparseBayer4x4[(pixelCoord.y & 3u) * 4u + (pixelCoord.x & 3u)];

    // 逐帧旋转相位：同一像素 16 帧内恰好命中 activeSlots 次，间隔规则。
    //
    // 2026-11-05：再按 **tile（4x4 像素）再旋转一次**。
    // 只用帧号当相位时，全屏每个 tile 的活跃图案完全相同 ⇒ 阴影里看不出，
    // 但直射光强的地方会把它显影成一张**规则网格**（用户截图）。
    // 每个 tile 带上自己的哈希旋转后：tile 内仍活跃恰好 activeSlots 个（覆盖率不变），
    // 但相邻 tile 图案不同 ⇒ 周期性被打散成噪点。
    const uint tileHash =
        ((pixelCoord.x >> 2u) * 73856093u) ^ ((pixelCoord.y >> 2u) * 19349663u);
    const uint phase = (frameIdx + (tileHash >> 4u)) & (slots - 1u);
    const uint shifted = (bayer + slots - phase) & (slots - 1u);

    return shifted < activeSlots;
}

void main()
{
    const uvec2 blockCoordinate = gl_GlobalInvocationID.xy;

    if(blockCoordinate.x >= pc.maskWidth)
    {
        return;
    }

    uint maskValue = 0u;

    for(uint localY = 0u; localY < 2u; ++localY)
    {
        for(uint localX = 0u; localX < 4u; ++localX)
        {
            const uvec2 pixelCoordinate =
                blockCoordinate * uvec2(4u, 2u) + uvec2(localX, localY);

            bool isPixelActive = false;

            if(pixelCoordinate.x < pc.width &&
               pixelCoordinate.y < pc.height)
            {
#if SPARSE_LAYERED_PATTERN
                isPixelActive =
                    sparseLayeredActive(
                        pixelCoordinate,
                        pc.frameIndex,
                        pc.samplingRate);
#else
#if SPARSE_ORDERED_BAYER
                isPixelActive =
                    sparseOrderedActive(
                        pixelCoordinate,
                        pc.frameIndex,
                        pc.samplingRate);
#if SPARSE_EDGE_AWARE
                // 高对比像素一律全速率：与 Remix 的 per-pixel rate 纹理同效。
                if(!isPixelActive)
                {
                    isPixelActive =
                        sparseEdgeActive(
                            pixelCoordinate,
                            uvec2(pc.width, pc.height));
                }
#endif
#else
                isPixelActive =
                    sparseBlueNoiseThreshold(
                        pixelCoordinate,
                        pc.frameIndex) <= pc.samplingRate;
#endif
#endif
            }

            const uint bitIndex = localY * 4u + localX;

            if(isPixelActive)
            {
                maskValue |= (1u << bitIndex);
            }
        }
    }

    imageStore(
        sparseActiveMaskOut,
        ivec2(blockCoordinate),
        uvec4(maskValue, 0u, 0u, 0u));
}
