#version 460


layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D cloudIn;
layout(set = 0, binding = 1) uniform sampler2D cloudDepthIn;
layout(rgba16f, set = 0, binding = 2) uniform writeonly image2D cloudOut;

layout(push_constant) uniform AtrousPush
{
    int   stride;
    float phiDepthRel;
    float phiAlpha;
    float phiLum;
} pc;
const vec3 LUMA = vec3(0.2126, 0.7152, 0.0722);

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(cloudOut);
    if(any(greaterThanEqual(pixel, size)))
    {
        return;
    }
    ivec2 limit = size - ivec2(1, 1);

    vec4 center = texelFetch(cloudIn, pixel, 0);
    float centerDistance = texelFetch(cloudDepthIn, pixel, 0).r;
    float centerLuminance = dot(center.rgb, LUMA);

    float luminanceSum = 0.0;
    float luminanceSquareSum = 0.0;
    for(int y = -1; y <= 1; ++y)
    for(int x = -1; x <= 1; ++x)
    {
        vec4 sampleCloud = texelFetch(cloudIn,
            clamp(pixel + ivec2(x, y), ivec2(0), limit), 0);
        float luminance = dot(sampleCloud.rgb, LUMA);
        luminanceSum += luminance;
        luminanceSquareSum += luminance * luminance;
    }
    float meanLuminance = luminanceSum / 9.0;
    float variance = max(luminanceSquareSum / 9.0 - meanLuminance * meanLuminance, 0.0);
    // 2026-10-31：亮度容差必须有一个**按信号量级的绝对下限**。
    // 雾是低频均匀场，3x3 方差趋零 ⇒ sqrt(variance)*phiLum 掉到 1e-4 量级，
    // 于是 exp(-|Δlum|/1e-4) 对任何抖动残差都判 0，4 轮 à-trous 在雾区退化成
    // “只采中心像素”，半分辨率上的抖动图案原样留到上采样 ⇒ 屏幕上的细密纱窗。
    // 下限取中心亮度的 30%（云的强边缘通常差 2 倍以上，仍被拒，保边不丢）。
    float luminanceScale = max(sqrt(variance) * pc.phiLum,
        max(centerLuminance, 1.0e-3) * 0.30);
    float depthScale = max(32.0, centerDistance * pc.phiDepthRel);
    float alphaScale = max(pc.phiAlpha, 1.0e-4);

    vec3 colorSum = vec3(0.0);
    float alphaSum = 0.0;
    float weightSum = 0.0;
    for(int y = -2; y <= 2; ++y)
    for(int x = -2; x <= 2; ++x)
    {
        ivec2 samplePixel = clamp(pixel + ivec2(x, y) * pc.stride, ivec2(0), limit);
        vec4 sampleCloud = texelFetch(cloudIn, samplePixel, 0);
        float sampleDistance = texelFetch(cloudDepthIn, samplePixel, 0).r;

        float weight = exp(-float(x * x + y * y) * 0.5);
        weight *= exp(-abs(sampleDistance - centerDistance) / depthScale);
        weight *= exp(-abs(sampleCloud.a - center.a) / alphaScale);
        weight *= exp(-abs(dot(sampleCloud.rgb, LUMA) - centerLuminance) / luminanceScale);

        colorSum += sampleCloud.rgb * weight;
        alphaSum += sampleCloud.a * weight;
        weightSum += weight;
    }

    float invWeight = 1.0 / max(weightSum, 1.0e-6);
    imageStore(cloudOut, pixel, vec4(colorSum * invWeight, alphaSum * invWeight));
}
