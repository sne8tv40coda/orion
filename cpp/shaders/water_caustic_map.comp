#version 460
#extension GL_GOOGLE_include_directive : require

// ============================================================================
// 水面焦散图 —— 光子泼溅（2026-11-20 重构）
//
// ── 为什么换掉"逐纹素雅可比" ──────────────────────────────────────────────
// 旧实现（2026-11-01 起）对每个纹素点算 dq/dp 的行列式，密度 = 1/|det|。
// 数学没错，但它把"点密度"直接当成"光强"：
//   · det 在焦散线（caustic cusp）上穿过 0，1/|det| 是一条 1/x 的尖峰，
//     离散采样下必然变成逐纹素的针状尖刺；
//   · 水面斜率场在 tile=128/512² 下的 RMS 斜率实测 ≈1.1（45°+），
//     1 格参考深度下每个波峰折叠 3~5 次 ⇒ 焦散线密度远高于图的分辨率，
//     整张图退化成椒盐噪声（离线复刻 2026-11-20 的 PNG 可复现）。
// 结果就是"水底碎玻璃/静电"，随波浪逐帧闪。
//
// ── 现在（照抄 HPWater 的 HPWaterCausticCompute.compute）───────────────────
// HPWater 的焦散不是算密度，而是 **光子泼溅**：水面每一点把折射后的光
// 打到接收面上，落在哪个像素就给哪个像素 +1（InterlockedAdd），再做 à-trous
// 模糊。本质上是同一份雅可比，但被"按桶累加"积分掉了：
//   · 焦散线变成一条有宽度（≈ 图纹素）的亮线，而不是 1/x 尖峰；
//   · 亮度的动态范围天然由"落进来的光子数"给出 —— 平水恒等于 1，
//     聚焦处 3~40，散焦处 0，能量守恒，不需要 1/|det| 的 clamp 修补；
//   · 折叠再多也只是把光子堆到同一桶里，不会产生采样噪声。
//
// 与 HPWater 的差异（本机没有光栅管线、也没有屏幕空间深度图）：
//   · 他们是**屏幕空间**泼溅（源 = 屏幕像素，桶 = 屏幕像素，落到真实场景深度）；
//   · 我们是**世界空间**泼溅（源 = 水面上 1024² 的规则网格，桶 = 参考接收面
//     1024² 的规则网格）。平水时源格与桶一一对应 ⇒ 每个桶恰好 1 个光子，
//     "1 = 未扰动"的旧口径逐字保留，消费端不需要换约定。
//   · 只有一张单通道累加图（R32_UINT），RGB 色散移到消费端做（见
//     rgen_water_caustics.glsl 的 3 次偏移采样，等同 HPWater 的非 RGB 路径）。
//
// 会话链：[本文件] 泼溅 → water_caustic_resolve.comp（模糊 + 归一 + 软膝压缩）
// → 宿主 mip 链 → 消费端采样。
// ============================================================================

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D waterFftSlope;
// 落到接收面后按桶累加：每格一个光子，计数用整数原子加。
layout(r32ui, set = 0, binding = 1) uniform uimage2DArray causticAccum;

layout(push_constant) uniform WaterCausticMapPush
{
    vec4 sunDirection;   // xyz = 指向太阳（单位向量，y > 0）；w 保留
    vec4 params;         // x = tile 周期（格）；y = 折射参考深度；z = 反射参考高度；w 保留
} pc;

// 与 VulkanCore / OrionInternal.h 的 WATER_CAUSTIC_MAP_RESOLUTION 逐字对应。
const uint CAUSTIC_RESOLUTION = 1024u;
const float CAUSTIC_RESOLUTION_F = 1024.0f;

const float DETAIL_TILE = 32.0f;

// 细节层（.ba，32 格域）参与焦散的权重。
// 它的波长细到 0.32 格，而本图一个桶 = 0.125 格 —— 原样参与会在桶一级
// 欠采样，泼溅出来是"每桶一跳"的颗粒。0.35 + LOD 1.5 让它在焦散里只做
// 低频调制（表面法线仍然吃全量细节，见 water_wave_field.glsl）。
#ifndef WATER_CAUSTIC_SPLAT_DETAIL_WEIGHT
#define WATER_CAUSTIC_SPLAT_DETAIL_WEIGHT 35   // 百分之一：35 = 0.35
#endif
#ifndef WATER_CAUSTIC_SPLAT_DETAIL_LOD
#define WATER_CAUSTIC_SPLAT_DETAIL_LOD 15      // 百分之一：15 = 1.5
#endif

const float kDetailWeight = float(WATER_CAUSTIC_SPLAT_DETAIL_WEIGHT) / 100.0;
const float kDetailLod = float(WATER_CAUSTIC_SPLAT_DETAIL_LOD) / 100.0;

// 折射/反射光线"能送光到接收面"的最小竖直分量。0.05 ⇒ 最远 20 格。
#ifndef WATER_CAUSTIC_MIN_VERTICAL
#define WATER_CAUSTIC_MIN_VERTICAL 0.050f
#endif

// 与旧 vert 的两段斜率叠加同一口径（base = .rg，detail = .ba，detail 以
// DETAIL_TILE 为周期重采一次）。
vec2 slopeAt(vec2 uv)
{
    const vec2 baseSlope = textureLod(waterFftSlope, uv, 0.0).rg;
    const vec2 detailSlope = textureLod(
        waterFftSlope,
        uv * (pc.params.x / DETAIL_TILE),
        kDetailLod
    ).ba;
    return baseSlope + detailSlope * kDetailWeight;
}

// 水面点 -> 参考接收面上的落点。valid = false 表示这一格的水面法线太陡，
// 折射光几乎水平或干脆朝上 —— 它没有能力把光送到接收面，直接丢弃光子
// （HPWater 同一处也是 continue）。丢弃而不是"钳到上限"，因为钳制会把所有
// 无效面元堆到同一条半径 20 格的圆上，糊出一个假的光环。
vec2 projectToReceiver(
    vec2 sourceXZ,
    vec2 slope,
    float refHeight,
    bool reflectLayer,
    float ior,
    out bool valid)
{
    valid = true;
    const vec3 normal = normalize(vec3(-slope.x, 1.0, -slope.y));
    const vec3 incoming = -normalize(pc.sunDirection.xyz);

    if(reflectLayer)
    {
        const vec3 outgoing = normalize(reflect(incoming, normal));
        if(outgoing.y < WATER_CAUSTIC_MIN_VERTICAL)
        {
            valid = false;
            return sourceXZ;
        }
        return sourceXZ + outgoing.xz * (refHeight / outgoing.y);
    }

    const vec3 refracted = refract(incoming, normal, 1.0 / ior);
    // 掠射阈值：|y| 小于它时落点在 20 格开外，已经不属于同一块水面
    // （而且跨图丢光子）。真实世界里这些面元走全反射/白沫，不往水底送光。
    if(-refracted.y < WATER_CAUSTIC_MIN_VERTICAL)
    {
        valid = false;
        return sourceXZ;
    }
    return sourceXZ + refracted.xz * (refHeight / -refracted.y);
}

void main()
{
    const ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    const int layer = int(gl_GlobalInvocationID.z);

    if(texel.x >= int(CAUSTIC_RESOLUTION) ||
       texel.y >= int(CAUSTIC_RESOLUTION) ||
       layer >= 1)
    {
        return;
    }

    const float tilePeriod = max(pc.params.x, 1.0e-3);
    const bool reflectLayer = (layer == 1);
    const float refHeight = max(reflectLayer ? pc.params.z : pc.params.y, 0.0);

    const vec2 uv = (vec2(texel) + 0.5) / CAUSTIC_RESOLUTION_F;
    const vec2 sourceXZ = uv * tilePeriod;
    const vec2 slope = slopeAt(uv);

    bool valid = false;

    const vec2 receiverXZ = projectToReceiver(
        sourceXZ, slope, refHeight, reflectLayer, 1.3335, valid);

    if(!valid || any(isnan(receiverXZ)) || any(isinf(receiverXZ)))
    {
        return;
    }

    // 回卷到 tile：平水时 q == p，桶号与源格一一对应 ⇒ 每桶恰好 1 个光子。
    vec2 wrapped = receiverXZ / tilePeriod;
    wrapped -= floor(wrapped);
    const ivec2 bin = ivec2(wrapped * CAUSTIC_RESOLUTION_F);

    imageAtomicAdd(causticAccum, ivec3(bin, layer), 1u);
}
