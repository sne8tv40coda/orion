const bool DBG_MARK_VLI_EMITTER = false;

// =====================================================
// 判决实验 BEHIND（2026-09-22 20:50）：玻璃后接收面三项分色。
//   R = directAndEmission     payload.emission + 太阳/环境反射
//   G = localEntityIrradiance 本地光 RIS（已修染色）
//   B = hitAlbedo * ambient   纯 albedo 环境底光（无任何染色）
// 用法：把准星对准天花板白光斑，看它是哪个通道（纯红/绿/蓝 ⇒ 该项主导）。
// 之后可用下面的 KILL 开关单独验证。
// =====================================================
// Build-time switch (see the BEHIND banner at ~11880):
// -DDBG_BEHIND_SPLIT_MACRO=1 paints the three behind-glass receiver terms to
// RGB: R=directAndEmission G=localEntityIrradiance B=ambientTerm.
// ⚠️ 2026-10-01 临时诊断（跑完即回 0）：玻璃后三项分色，用来一次定位"颗粒属于谁"。
//   R = directAndEmission      太阳 + 自发光（无估计量：只有解析光照与阴影射线）
//   G = localEntityIrradiance  本地光 RIS + 8 帧屏幕空间历史（**唯一的估计量**）
//   B = ambientTerm            albedo * ambient（无估计量）
// 判据：把准星对准玻璃里那层均匀颗粒，看它是纯红 / 纯绿 / 纯蓝。
//   · 纯绿 ⇒ 元凶就是那个 8 帧历史估计量 ⇒ 正解是修它的时域累积（长度/键/权重），
//     与降噪器无关 —— 也解释了为什么之前动 RR 的一切都没有效果。
//   · 纯红 ⇒ 在解析太阳/自发光那一支（无估计量）⇒ 查 payload.emission 的取值来源
//     与阴影射线的抖动，而不是采样数。
//   · 纯蓝 ⇒ 环境底光项（无估计量）⇒ 查 ambient 的取值来源。
#ifndef DBG_BEHIND_SPLIT_MACRO
#define DBG_BEHIND_SPLIT_MACRO 0
#endif
const bool DBG_BEHIND_SPLIT = (DBG_BEHIND_SPLIT_MACRO != 0);
const bool DBG_KILL_BEHIND_AMBIENT = false;  // 2026-10-28 临时判决
// 2026-10-28 判决结果：置 true 后橙色玻璃掠射面的绿色颗粒**毫无变化** ⇒
// 该颗粒与 localEntityIrradiance（本地光 RIS + 8 帧屏幕空间历史）无关。
// 本轮为"三项全杀"诊断，临时置 true。
const bool DBG_KILL_BEHIND_LOCAL = false;
const bool DBG_KILL_BEHIND_DIRECT = false;   // 2026-10-28 临时判决

// =====================================================
// 判决实验 GLASSTINT（2026-09-22 21:06）：直接读出摄像面玻璃透射率。
// 假设：玻璃后所有项（payload.emission/太阳/环境/本地光）都被
//       behindRadiance × glassTransmission 统一相乘；若 glassSurface.tint
//       是白的 ⇒ glassTransmission=(1,1,1) ⇒ 整片恒不染色 ⇒ 用户症状。
// 而二级弹射用的是独立的体素 DDA 透射率，所以它有色 —— 对应用户
// 「只有二次弹射有颜色」的观察。
// =====================================================
const bool DBG_SHOW_GLASSTINT = false;
// 1 = 原始 glassTint(=unpackAlbedoUnorm(payload.albedoPacked))  2 = blockTransmission  3 = sheetTransmission
const uint DBG_GLASSTINT_STAGE = 1u;

// 判决实验 Z：main 入口可达性探针。true 时整屏输出纯品红。
// 用途：一次性判定「当前加载执行的 raygen 是否就是这个文件的 main」。
// ✅ 已验证成立（2026-09-22 20:10 用户确认整屏品红）。现关闭。
const bool DBG_REACH_MAIN = false;

// =====================================================
// 判决实验 H（ablation，逐项物理隔离；DBG_SPLIT_ABLATION=false 时才生效）
// =====================================================
const bool DBG_KILL_EMITTER_TERM = false;
const bool DBG_KILL_SECONDARY_TERM = false;

// =====================================================
// 判决实验 LL-P3.3（route A，定位用）：只显示本地光**弹射**，即每个 GI 顶点
// 新增的那条本地光 NEE（emitter -> 该命中面 -> 接收面）。
// true 时 litColor 被替换成该累积项（乘上 GI 的 1.8 * rtaoFactor），于是
// 「这条路到底往画面里放了什么」一张截图就能读出来，不必在太阳 GI 和
// 直射光斑底下猜。默认关闭；读数用的临时开关，定案后删除。
// =====================================================
const bool DBG_LOCAL_BOUNCE_ONLY = false;

// =====================================================
// 判决实验 E：直接暴露二级弹射的染料与能量（同上编码，只作用于
// evaluateVPTLocalSecondaryBounce）。默认关闭，置 true 即启用。
// =====================================================
// 只作用二级弹射，本实验关闭，避免与 D 总开关叠加污染读数。
const bool DBG_GLASS_DYE_VS_ENERGY_SECONDARY = false;

// =====================================================
// 判决实验 F：读出二级弹射的**色调纯度**（比值型，不受末端裁剪影响）。
//
// 上一版读绝对峰值失败：R = clamp(peak / SCALE) 之后仍要走 rr_sdr_post，
// 而那里对 >1 的通道逐通道硬裁 ⇒ R 恒被钉在 1，读不出任何量级。
// 把尺子伸进它自己要测的裁切区里，是编码错误。
//
// 这一版只读**比值**，恒 <= 1，永远不会被裁：
//   R = 染料纯度 = (max3 - min3) / max3   （纯色⇒1，白⇒0）
//   G = 弱通道占比 = 第二通道 / max3       （纯红(1,0,0)⇒0，泛白(1,.8,.8)⇒0.8）
//
// 判读近段光斑：
//   G 暗（<0.2）  => 颜色是纯的，泛白只是高亮度的主观感受 => 只需压整体亮度
//   G 亮（>0.5）  => 弱通道真被抬起 => 有第二个源在同一处加白，顺着找它
// =====================================================
// 判决实验 G：把「有没有染色」与「弱通道占比」分开编码。
//
// F-2 的结果（整屏纯绿）有两种完全不同的解释，必须分开：
//   (a) glassTransmission 真的接近白  ⇒ 纯度和弱通道占比都退化成 1（纯绿）
//   (b) 这项返回值被用在大量像素上、且该项根本没被染色 ⇒ 也是纯绿
// 判据：把「透射率是否严格等于 (1,1,1)」单独拿出来：
//   R = 1 - 弱通道占比（(b) 那种「颜色纯」的度量）
//   G = 1 - 纯度        （白 ⇒ 1；有色 ⇒ 0）
//   B = 纯白标记         （transmission == (1,1,1) ⇒ 1，否则 0）
// 判读：
//   B 亮  ⇒ 根本没染色（透射率恒白）——染色链路在那处没生效
//   B 暗 + G 亮 ⇒ 有染色但接近白（被抬灰）
//   B 暗 + G 暗 ⇒ 染色饱和、颜色纯
vec3 dbgHuePurity2(vec3 transmission)
{
    vec3 v = max(transmission, vec3(0.0));
    float peak = max(v.r, max(v.g, v.b));
    float floorValue = min(v.r, min(v.g, v.b));
    bool isPureWhite = all(equal(v, vec3(1.0)));
    if(peak <= 1.0e-6)
    {
        return vec3(0.0, 1.0, isPureWhite ? 1.0 : 0.0);
    }
    float second = 0.0;
    if(peak == v.r)
    {
        second = max(v.g, v.b);
    }
    else if(peak == v.g)
    {
        second = max(v.r, v.b);
    }
    else
    {
        second = max(v.r, v.g);
    }
    return vec3(
        clamp(1.0 - (peak - floorValue) / peak, 0.0, 1.0),
        clamp(1.0 - second / peak, 0.0, 1.0),
        isPureWhite ? 1.0 : 0.0
    );
}

const bool DBG_GLASS_PEAK_READOUT = false;
const float DBG_PEAK_SCALE = 64.0;

const vec3 DBG_TERM_LUMA = vec3(0.2126, 0.7152, 0.0722);

float dbgTermLuma(vec3 value)
{
    return clamp(dot(max(value, vec3(0.0)), DBG_TERM_LUMA), 0.0, 1.0);
}

// 染色浓度：纯色 ⇒ 1，中性白 ⇒ 0。拒绝任何整体亮度的干扰。
float dbgDyeConcentration(vec3 value)
{
    vec3 v = max(value, vec3(0.0));
    return clamp(
        max(v.r, max(v.g, v.b)) - min(v.r, min(v.g, v.b)),
        0.0,
        1.0
    );
}
// User-confirmed global local-light energy. Sampling, emitter geometry,
// candidate count, and attenuation curves remain unchanged.
// This is the *base*: the settings-screen slider「本地光源照射强度」multiplies
// it through localLightIntensity() below, and 1.0 there is exactly this value.
const float LOCAL_LIGHT_ENERGY_SCALE = 0.35;

// =====================================================
// 用户旋钮：本地光源照射强度（设置界面滑块）。
//
// 主机把它按 float 位型写进 CameraUBO.historyPadding1 —— 该车道全仓没有
// 任何读取点，且 UBO 填充本来就把 0 写进去，所以不动 std140 布局、不动
// 描述符绑定，也就不存在"改了偏移把别的读取点整体平移"的风险。这与
// cam.padding 装水钟时间（uintBitsToFloat(cam.padding)）是同一个手法。
//
// 编码约定：主机写的是 intensity + 1.0，这里减 1 还原。这样 0.0 就不是
// 合法强度值，而是"主机从没下发过"的标记 —— 旧 DLL 把该车道清零、旧
// 配置里没有这个字段，着色器都会解出 -1.0 并退回 1.0，于是
// 「新 spv + 旧 DLL」与「旧 spv + 新 DLL」两个方向都能安静降级；同时
// 用户真的把滑块拖到 0（关掉本地光源）也不会被误判成未下发。
// =====================================================
float localLightIntensity()
{
    float user = uintBitsToFloat(cam.historyPadding1) - 1.0;
    return (user >= 0.0 && user <= 16.0) ? user : 1.0;
}

// Local-light exposure guard: hue-preserving peak fold-back.
//
// The fold itself now lives in glass_tint_common.glsl (glassTintExposureFold)
// so the direct term and the secondary bounce cannot drift apart again.  Only
// the two judgement-experiment switches stay here: they want the raw energy.
vec3 toneKeepHueLocal(vec3 value)
{
    // 判决实验期间关闭压制，只读原始能量（见 DBG_GLASS_DYE_VS_ENERGY_*）
    if(DBG_GLASS_DYE_VS_ENERGY || DBG_GLASS_DYE_VS_ENERGY_SECONDARY)
    {
        return value;
    }
    return glassTintExposureFold(value);
}
// VPT-3.4A: one local-light indirect DDA from the primary receiver.
const float VPT_LOCAL_BOUNCE_MAX_DISTANCE = 12.0;


uint vliHash32(ivec3 sectionCoord)
{
    uint h = uint(sectionCoord.x) * 0x8da6b343u;
    h ^= uint(sectionCoord.y) * 0xd8163841u;
    h ^= uint(sectionCoord.z) * 0xcb1ab31fu;
    h ^= h >> 16u;
    h *= 0x7feb352du;
    h ^= h >> 15u;
    h *= 0x846ca68bu;
    h ^= h >> 16u;
    return h;
}


bool vliLookupSectionPage(ivec3 sectionCoord, out uint pageIndex)
{
    uint slot = vliHash32(sectionCoord) & (VLI_PAGE_TABLE_CAPACITY - 1u);
    for(uint probe = 0u; probe < VLI_PAGE_TABLE_CAPACITY; ++probe)
    {
        uint base = slot * 4u;
        uint pagePlusOne = vliPageTableBuffer.words[base + 3u];
        if(pagePlusOne == 0u)
        {
            pageIndex = 0u;
            return false;
        }

        if(
            int(vliPageTableBuffer.words[base + 0u]) == sectionCoord.x &&
            int(vliPageTableBuffer.words[base + 1u]) == sectionCoord.y &&
            int(vliPageTableBuffer.words[base + 2u]) == sectionCoord.z
        )
        {
            pageIndex = pagePlusOne - 1u;
            return true;
        }

        slot = (slot + 1u) & (VLI_PAGE_TABLE_CAPACITY - 1u);
    }

    pageIndex = 0u;
    return false;
}


int vliFloorDiv(int value, int divisor)
{
    return value >= 0 ? value / divisor : -((-value + divisor - 1) / divisor);
}


int vliPositiveMod(int value, int divisor)
{
    int result = value % divisor;
    return result < 0 ? result + divisor : result;
}


// =====================================================
// VPT-P2（2026-09-29）单入口 section 页表 memo；2026-10-02 上移到本文件更前面，
// 让**两条**读体素入口共用它。
//
// 二级弹射 / 玻璃透射 / 面缓存读取这些 DDA 每走一步都要把世界坐标换算成 section
// 再做一次页表哈希（hash + 线性探测），而一条 ≤12 格的射线最多跨 2~3 个 section ——
// 把"上一次查到的 (section → page)"留在寄存器里，绝大多数步只剩一次比较。
// 页表在一次 dispatch 内不变，键值比对保证了正确性；未命中的 section 不进缓存
// （不缓存"缺失"）。
//
// 为什么现在要合并：`vliReadSourceVoxel` 此前**不走** memo（每次都全量哈希 + 探测），
// 而它与紧随其后的 `evaluateVPTRISDirectLightingSingle`（读 source 目录）在同一次
// 调用里查的是**同一个 section** ⇒ 同一像素内重复一次哈希 + 线性探测。
// 本改动只影响性能，取值逐位不变。A/B：-DVLI_SOURCE_MEMO=0
// =====================================================
#ifndef VLI_SOURCE_MEMO
#define VLI_SOURCE_MEMO 1
#endif
bool g_vptMemoPageValid = false;
ivec3 g_vptMemoSection = ivec3(0);
uint g_vptMemoPage = 0u;


uint vliReadSourceVoxel(ivec3 worldBlock)
{
    ivec3 sectionCoord = ivec3(
        vliFloorDiv(worldBlock.x, 16),
        vliFloorDiv(worldBlock.y, 16),
        vliFloorDiv(worldBlock.z, 16)
    );
    uint pageIndex;
#if VLI_SOURCE_MEMO
    // 与 vptReadSourceVoxel 共用同一个 section memo（见文件前面的说明）。
    if(g_vptMemoPageValid && all(equal(g_vptMemoSection, sectionCoord)))
    {
        pageIndex = g_vptMemoPage;
    }
    else
    {
        if(!vliLookupSectionPage(sectionCoord, pageIndex))
        {
            return 0u;
        }
        g_vptMemoSection = sectionCoord;
        g_vptMemoPage = pageIndex;
        g_vptMemoPageValid = true;
    }
#else
    if(!vliLookupSectionPage(sectionCoord, pageIndex))
    {
        return 0u;
    }
#endif

    ivec3 local = ivec3(
        vliPositiveMod(worldBlock.x, 16),
        vliPositiveMod(worldBlock.y, 16),
        vliPositiveMod(worldBlock.z, 16)
    );
    uint index = uint(local.x) + 16u * (uint(local.z) + 16u * uint(local.y));
    return vliPagesBuffer.words[pageIndex * VLI_PAGE_WORDS + index];
}


// 发射色：查光源档案表（local_light_profile.glsl）。
// 2026-10-31：原来的 6 档硬编码调色板已并入档案表 —— 那里不只是颜色，
// 还有每档的满级亮度与基础传播距离，火把/岩浆/信标不再共用一个口径。
vec3 vliDecodeEmitterColor(uint typeCode)
{
    return localLightProfileColor(typeCode);
}

vec3 sampleHemisphereCosine(vec3 normal, inout uint state);
vec3 vptDominantBlockFaceNormal(vec3 normal);

// Defined next to the glass optical model; needed by the local-light direct
// lighting path above it.  strengthenLocalGlassTint itself now comes from
// glass_tint_common.glsl (included at the top of this file).
vec3 applyLocalGlassTint(vec3 radiance, vec3 transmittance);

// =====================================================
// VLI-2.0 partial occluders (voxel class 3)
//
// `canOcclude()` is a *block-level* flag -- default true and inherited verbatim
// by `ofLegacyCopy` -- so a bottom slab, a stair, a wall or a fence all reported
// `canOcclude() == true` and SectionCompilerMixin encoded the whole 1x1x1 cell
// as class 1.  Every voxel DDA below then stopped at that cell, which is why a
// torch threw a 1x1x1 box shadow over a half slab or a fence instead of the
// block's real silhouette.
//
// Such a block is now class 3 and carries the free fraction of its cell in bits
// 27..31 (5 bits, 31 = fully transparent).  A non-cube shape is modelled as a
// uniform attenuation of the marched ray, which is an approximation, but it
// removes the full-cube phantom.  Keep in lockstep with VLI_PARTIAL_SHIFT /
// VLI_PARTIAL_MAX in SectionCompilerMixin and with rt_vpt_irradiance.comp.
// 2026-10-31：7 bit 压到 5 bit，腾出的两位给了光源档案 id（bits 6..10）。
// =====================================================
const uint VPT_PARTIAL_TRANSMISSION_SHIFT = 27u;
const uint VPT_PARTIAL_TRANSMISSION_MAX = 31u;

float vptPartialTransmission(uint source)
{
    return float((source >> VPT_PARTIAL_TRANSMISSION_SHIFT) &
        VPT_PARTIAL_TRANSMISSION_MAX) * (1.0 / 31.0);
}

// Occupied cell: a full cube (class 1) or a partial occluder (class 3).
bool vptVoxelOccupied(uint source)
{
    uint voxelClass = source & 3u;
    return voxelClass == 1u || voxelClass == 3u;
}

vec3 evaluateOpaqueSurfaceRadiance(
    vec3 hitPos,
    vec3 hitNormal,
    vec3 viewDir,
    vec3 hitAlbedo,
    float hitRoughness,
    float hitF0Metal,
    vec3 hitEmission,
    float pomSelfShadow,
    vec3 sunDirection
);


// =====================================================
// 2026-10-01 修复「方块角落漏光」（用户报：角落有光线，与本地光有关，把本地光
// 距离调小会缓解）
//
// 本项（evaluateVLIEmitterRadianceAtHit）的语义是"**命中面所属的那一块**自己
// 在发光，所以它的面跟着亮"：它取 `hitPos - 外法线 * 0.02` 落进体内那一格，读
// 该格的 emission，**不投可见性射线**（这是设计，不是缺陷）。
//
// 但旧实现的"外法线"取的是**着色法线**的 dominant 轴（vptDominantBlockFaceNormal
// (hitNormal)）。着色法线带纹理浮雕扰动，在**拐角/棱上它的 dominant 轴会翻到另一
// 条轴** ⇒ 那 0.02 格落进**邻块**：只要邻块的 emission 不为 0（正是被 VLI 场的
// 扩散/传播半径覆盖到的体素），这块本不该发光的面上就出现一条亮边 ——
// 这就是"方块角落有光线"，也解释了为什么**把本地光距离调小（扩散半径变小）会缓解**。
//
// 本文件 1253-1262 的既有记载早就写明了同一类失效："浮雕纹素会让它倾斜越过几何
// 面的地平线，正是本地直射泄漏的成因"，并为此做了 vptGeometricFaceNormalFromRay。
//
// 修法：命中点若**确实落在体素面上**（几何判据：fract 到最近整轴的距离 ≈ 0），
// 就由**几何**决定是哪条轴（离得最近的那一面），只把**符号**留给着色法线；
// 非体素对齐的几何（voxy/DH 远景 LOD 大四边形、实体网格）两侧本来就落在同一体素
// 里，轴向怎么选都不改变结果 ⇒ 保持旧行为。
//
// A/B：-DVLI_EMITTER_GEOMETRIC_AXIS=0 回到"着色法线 dominant 轴"。
// =====================================================
#ifndef VLI_EMITTER_GEOMETRIC_AXIS
#define VLI_EMITTER_GEOMETRIC_AXIS 1
#endif
// "落在体素面上"的容差：按格计的分数坐标距离。
#ifndef VLI_EMITTER_FACE_EPS
#define VLI_EMITTER_FACE_EPS 1.0e-3
#endif

vec3 evaluateVLIEmitterRadianceAtHit(
    vec3 hitPos,
    vec3 hitNormal,
    vec3 hitAlbedo
)
{
    vec3 blockFaceNormal = vptDominantBlockFaceNormal(hitNormal);
#if VLI_EMITTER_GEOMETRIC_AXIS
    {
        vec3 fracPos = fract(hitPos);
        vec3 distToFace = min(fracPos, vec3(1.0) - fracPos);
        float nearestFace = min(distToFace.x, min(distToFace.y, distToFace.z));
        if(nearestFace <= VLI_EMITTER_FACE_EPS)
        {
            // 最近的那条轴就是命中点所在的面；符号沿用着色法线在该轴上的方向
            // （外法线方向）。这样"往体内 0.02 格"必然落在**本块**里。
            vec3 sampleNormal = normalize(hitNormal);
            int axis = 0;
            if(distToFace.y == nearestFace)
            {
                axis = 1;
            }
            else if(distToFace.z == nearestFace)
            {
                axis = 2;
            }
            vec3 geometricFace = vec3(0.0);
            geometricFace[axis] = sampleNormal[axis] >= 0.0 ? 1.0 : -1.0;
            blockFaceNormal = geometricFace;
        }
    }
#endif
    ivec3 sourceBlock;
    uint source = 0u;
#if VLI_EMITTER_SOLID_SIDE
    {
        // 两侧各退半格，取**占用**那一侧（class 1 整格，或 class 3 半砖/栅栏
        // 这类部分遮挡方块——它们同样是命中面的所有者）。见 VLI_EMITTER_SOLID_SIDE。
        ivec3 cellInside = ivec3(floor(hitPos - blockFaceNormal * 0.5));
        ivec3 cellOutside = ivec3(floor(hitPos + blockFaceNormal * 0.5));
        uint insideSource = 0u;
        uint outsideSource = 0u;
        bool insideSolid = vptReadSourceVoxel(cellInside, insideSource) &&
            vptVoxelOccupied(insideSource);
        bool outsideSolid = vptReadSourceVoxel(cellOutside, outsideSource) &&
            vptVoxelOccupied(outsideSource);
        if(insideSolid)
        {
            sourceBlock = cellInside;
            source = insideSource;
        }
        else if(outsideSolid)
        {
            // 法线符号在缝上翻了面：以**占用**为准，不信符号。
            sourceBlock = cellOutside;
            source = outsideSource;
        }
        else
        {
            sourceBlock = cellInside;
            source = 0u;
        }
    }
#else
    sourceBlock = ivec3(floor(hitPos - blockFaceNormal * 0.02));
    source = vliReadSourceVoxel(sourceBlock);
#endif
    uint emission = (source >> 2u) & 15u;
    if(emission == 0u)
    {
        return vec3(0.0);
    }

    // 诊断（B 通道）：唯一**既无玻璃过滤、也无可见性射线/遮挡**的本地光
    // 贡献——它直接把命中面背后那个发光方块的发射色当光叠加。
    vec3 safeAlbedo = max(hitAlbedo, vec3(0.0));
    vec3 emitterTerm = vliDecodeEmitterColor((source >> 6u) & 31u) *
        3.2 *
        LOCAL_LIGHT_ENERGY_SCALE * localLightIntensity() *
        localLightProfileBrightness((source >> 6u) & 31u, float(emission)) *
        safeAlbedo;
    // ===== DBG_KILL_VLI_EMITTER: 无玻璃过滤项归零（判决实验）=====
    if(DBG_KILL_VLI_EMITTER)
    {
        return vec3(0.0);
    }
    // ===== DBG_MARK_VLI_EMITTER: 该项触发处标纯品红（看它覆盖哪些像素）=====
    if(DBG_MARK_VLI_EMITTER)
    {
        return vec3(1.0, 0.0, 1.0) * dbgTermLuma(emitterTerm) * 20.0;
    }
#if DBG_LOCAL_TERM_MAP_MACRO
    if(DBG_LOCAL_TERM_MAP)
    {
        // 第二轮：表内改为**原值返回**。旧版把这一项折成只有蓝通道，而它在 GI 顶点
        // （indirectLight 内）也出现一次 —— 按 luma 读 GI 通道时会被读小 13.8 倍
        // （0.0722），第一轮的 GI 读数是不可信的。本项自己改由表里的 G 通道承载。
        return emitterTerm;
    }
#else
    if(DBG_LOCAL_TERM_MAP)
    {
        return vec3(0.0, 0.0, dbgTermLuma(emitterTerm));
    }
#endif
    if(DBG_GLASS_DYE_VS_ENERGY)
    {
        // R = 该项的染料浓度（它**没有**做玻璃过滤，所以应当恒为 0）
        // G = 该项的能量
        return vec3(
            dbgDyeConcentration(vliDecodeEmitterColor((source >> 6u) & 31u)),
            dbgTermLuma(emitterTerm),
            0.0
        );
    }
    return emitterTerm;
}


vec3 vliUnpackRadiance(uint packed)
{
    return vec3(
        float( packed        & 255u),
        float((packed >> 8u) & 255u),
        float((packed >> 16u) & 255u)
    ) * (1.0 / 32.0);
}

vec3 vptDominantBlockFaceNormal(vec3 normal)
{
    vec3 n = normalize(normal);
    vec3 a = abs(n);
    if(a.x >= a.y && a.x >= a.z)
    {
        return vec3(n.x >= 0.0 ? 1.0 : -1.0, 0.0, 0.0);
    }
    if(a.y >= a.z)
    {
        return vec3(0.0, n.y >= 0.0 ? 1.0 : -1.0, 0.0);
    }
    return vec3(0.0, 0.0, n.z >= 0.0 ? 1.0 : -1.0);
}

// 主命中的**几何面法线**：由主光线跨过体素边界的那个轴恢复。
//
// 为什么不能拿 payload.normal 当几何面法线：rchit 里 worldNormal = tbn * tangentNormal
// （LabPBR 法线贴图重建后），payload.normal 写的就是它 —— 那是**着色法线**，
// 浮雕纹素会让它倾斜越过几何面的地平线，正是本地直射泄漏的成因。
//
// 而 POM 只位移着色 UV / 位移射线，不改命中点：hitPos 仍落在几何面上。
// 于是「光线从命中点往两侧各走 1e-3 格属于哪个体素」就能精确定位入面：
// 跨过 +X 边界说明看到的是该方块的 -X 面，法线取 -sign(该轴步进)。
// 非体素对齐的几何（voxy/DH 远景 LOD 大四边形、实体网格）两侧体素相同，
// 返回 vec3(0)，调用方回退到旧的浮雕量化口径。
vec3 vptGeometricFaceNormalFromRay(vec3 hitPos, vec3 rayDirection)
{
    vec3 direction = normalize(rayDirection);
    ivec3 blockOutside = ivec3(floor(hitPos - direction * 1.0e-3));
    ivec3 blockInside = ivec3(floor(hitPos + direction * 1.0e-3));
    ivec3 delta = blockInside - blockOutside;
    if(delta.x != 0) return vec3(delta.x > 0 ? -1.0 : 1.0, 0.0, 0.0);
    if(delta.y != 0) return vec3(0.0, delta.y > 0 ? -1.0 : 1.0, 0.0);
    if(delta.z != 0) return vec3(0.0, 0.0, delta.z > 0 ? -1.0 : 1.0);
    return vec3(0.0);
}

uint vptFaceIndexFromBlockFaceNormal(vec3 normal)
{
    if(normal.x > 0.5) return 0u;
    if(normal.x < -0.5) return 1u;
    if(normal.y > 0.5) return 2u;
    if(normal.y < -0.5) return 3u;
    if(normal.z > 0.5) return 4u;
    return 5u;
}

// One baked block-face irradiance sample.  Returns false when the owning Section
// is not resident or the voxel is not solid, so interpolating callers can
// renormalise over the samples that do exist instead of treating an unloaded
// page as black -- that would draw seams along Section borders.
bool vptBakedFaceSample(ivec3 block, uint dirIndex, out vec3 value)
{
    ivec3 sectionCoord = ivec3(
        vliFloorDiv(block.x, 16),
        vliFloorDiv(block.y, 16),
        vliFloorDiv(block.z, 16)
    );
    uint pageIndex;
    if(!vliLookupSectionPage(sectionCoord, pageIndex))
    {
        value = vec3(0.0);
        return false;
    }

    ivec3 local = ivec3(
        vliPositiveMod(block.x, 16),
        vliPositiveMod(block.y, 16),
        vliPositiveMod(block.z, 16)
    );
    uint voxelIndex = uint(local.x) + 16u *
        (uint(local.z) + 16u * uint(local.y));
    uint source = vliPagesBuffer.words[
        pageIndex * VLI_PAGE_WORDS + voxelIndex
    ];
    // Partial occluders are baked too (see rt_vpt_irradiance.comp
    // solveSurfaceFace), so a slab or fence must be allowed to read its own
    // face back instead of being rejected as "not a solid".
    if(!vptVoxelOccupied(source))
    {
        value = vec3(0.0);
        return false;
    }

    value = vliUnpackRadiance(vptSurfaceFaceBuffer.words[
        pageIndex * VPT_SURFACE_FACE_WORDS +
        voxelIndex * VPT_DIRECTION_COUNT +
        dirIndex
    ]);
    return true;
}

// The bake stores IRRADIANCE arriving on the face (it already carries the
// emitter-to-receiver cosine and the distance attenuation, see
// rt_vpt_irradiance.comp solveDirectIrradiance), so the diffuse outgoing
// radiance this receiver adds is albedo/pi * E.  The other consumer of the very
// same buffer -- the secondary bounce -- divides by pi, and this term shipped
// without that divisor, which multiplied the whole contribution by about 3.14
// and made walls look self-lit.  The 0.92 matches the secondary term's constant.
const float VPT_EXACT_FACE_DIFFUSE_SCALE =
    0.92 / 3.14159265359;

// Readout helper: puts this term's energy in R, the channel the other two local
// light terms leave free (see DBG_LOCAL_TERM_MAP: R = this exact baked direct
// term, G = secondary bounce, B = unfiltered emitter emission), so one screenshot
// names the term that owns a suspicious light patch without colour guesswork.
vec3 vptExactFaceDirectReadout(vec3 value)
{
    return DBG_LOCAL_TERM_MAP
        ? vec3(dbgTermLuma(value), 0.0, 0.0)
        : value;
}

// 2026-10-01：面缓存双线性插值在"邻居无效"处保持**连续**（用接收面自己的样本
// 兜底，而不是丢弃+归一化）。见使用点处的完整说明。
#ifndef VPT_EXACT_FACE_CONTINUOUS
#define VPT_EXACT_FACE_CONTINUOUS 1
#endif

// Exact primary local-light response.  payload.normal may include POM detail,
// so only its dominant axis is used to recover the owning Minecraft block
// face.  The current PBR/POM albedo is applied once after the cached
// face-to-emitter DDA irradiance lookup.
vec3 evaluateVPTExactFaceDirectLighting(
    vec3 hitPos,
    vec3 shadingNormal,
    vec3 hitAlbedo
)
{
    vec3 blockFaceNormal = vptDominantBlockFaceNormal(shadingNormal);
    uint dirIndex = vptFaceIndexFromBlockFaceNormal(blockFaceNormal);
    ivec3 block = ivec3(floor(hitPos - blockFaceNormal * 0.02));

    // The baked cache stores one value per block face, so reading only the
    // receiver's block makes every 1x1 face a hard-edged tile -- the squares the
    // user sees.  Blend bilinearly over the two axes TANGENT to the face, which
    // is where the visible block-to-block steps are, and keep the receiver's own
    // block along the face axis: the sample lives on the boundary plane the ray
    // hit, and stepping inward would read the wall's interior (air, or a face
    // that is not exposed).  Samples that are missing (unloaded Section) or not
    // solid are dropped and the weights renormalised, so a Section border or a
    // doorway cannot draw a seam or go black.
    vec3 axes[3] = vec3[3](
        vec3(1.0, 0.0, 0.0),
        vec3(0.0, 1.0, 0.0),
        vec3(0.0, 0.0, 1.0)
    );
    int faceAxis = blockFaceNormal.x != 0.0 ? 0 :
        (blockFaceNormal.y != 0.0 ? 1 : 2);
    vec3 unitU = axes[faceAxis == 0 ? 1 : 0];
    vec3 unitV = axes[faceAxis == 2 ? 1 : 2];
    ivec3 stepU = ivec3(unitU);
    ivec3 stepV = ivec3(unitV);

    // Reconstruction knots sit at the patch centres, i.e. at block coordinate
    // plus 0.5, so the two nearest patches per tangent axis are the ones whose
    // centres bracket the hit; cellBase is their offset from the receiver's
    // block and therefore lands in {-1, 0}.  (An earlier version added the
    // absolute coordinate here instead of the offset, which made every neighbour
    // lookup miss and silently fell back to the un-interpolated value.)
    float coordU = dot(hitPos, unitU) - 0.5;
    float coordV = dot(hitPos, unitV) - 0.5;
    float fracU = fract(coordU);
    float fracV = fract(coordV);
    ivec3 cellBase = ivec3(
        unitU * (floor(coordU) - dot(vec3(block), unitU))
    ) + ivec3(
        unitV * (floor(coordV) - dot(vec3(block), unitV))
    );

    vec3 sum = vec3(0.0);
    float totalWeight = 0.0;
    // 2026-10-01：接收面自身那一份缓存样本，用作"邻块无效"时的兜底值。
    // 见下面的 VPT_EXACT_FACE_CONTINUOUS。
    vec3 ownSample = vec3(0.0);
    bool hasOwnSample = vptBakedFaceSample(block, dirIndex, ownSample);
    for(int i = 0; i < 4; ++i)
    {
        float weightU = (i & 1) == 0 ? (1.0 - fracU) : fracU;
        float weightV = (i & 2) == 0 ? (1.0 - fracV) : fracV;
        float weight = weightU * weightV;
        ivec3 cell = block + cellBase;
        if((i & 1) != 0)
        {
            cell += stepU;
        }
        if((i & 2) != 0)
        {
            cell += stepV;
        }

        vec3 bakedSample;
        if(vptBakedFaceSample(cell, dirIndex, bakedSample))
        {
            sum += bakedSample * weight;
            totalWeight += weight;
        }
#if VPT_EXACT_FACE_CONTINUOUS
        else if(hasOwnSample)
        {
            // ===== 2026-10-01：修"沿格缝的细亮线"=====
            // 原实现把无效邻居**丢弃并把权重归一化**（sum/totalWeight）。归一化本身
            // 没错，但它让取值在"邻居由实心变空气 / 页未驻留"的那条线上**不连续**：
            // 线的两侧参与平均的样本集合不同 ⇒ 分母 1 → 变小 ⇒ 值突跳，屏幕上就是
            // 一条一像素宽的亮线，而且**恰好沿格缝/几何棱** —— 用户截图正是这种形状
            // （暗面上沿棱的 Y 形细亮线）。本地光距离越近，缓存值越小，亮线越淡，
            // 也就是用户报的"距离调小会缓解"。
            //
            // 改用**接收面自己的样本**兜底并照常计入权重：处处连续；邻居无效时结果
            // 退化为"自己那一份按该权重混合"，与注释里想要的"不画缝、不发黑"一致。
            // A/B：-DVPT_EXACT_FACE_CONTINUOUS=0 回到丢弃+归一化。
            sum += ownSample * weight;
            totalWeight += weight;
        }
#endif
    }

    if(totalWeight <= 0.0)
    {
        // Every neighbour was absent: fall back to the receiver's own face.
        vec3 own;
        if(!vptBakedFaceSample(block, dirIndex, own))
        {
            return vec3(0.0);
        }
        return vptExactFaceDirectReadout(
            own * max(hitAlbedo, vec3(0.0)) * VPT_EXACT_FACE_DIFFUSE_SCALE
        );
    }

    return vptExactFaceDirectReadout(
        (sum / totalWeight) * max(hitAlbedo, vec3(0.0)) *
        VPT_EXACT_FACE_DIFFUSE_SCALE
    );
}

// VPT-2 stores a small history count in bits 24..30 and marks cache probes
// placed inside solid voxels in bit 31.  RGB remains the existing lower 24
// bit fixed-point encoding, so no packed-float extension is required.
bool vptProbeHasRadiance(uint packed)
{
    return (packed & 0x7f000000u) != 0u &&
           (packed & 0x80000000u) == 0u;
}

// VPT-P2 的单入口 section 页表 memo 已上移到 `vliReadSourceVoxel` 之前
// （2026-10-02），由 vliReadSourceVoxel 与下面的 vptReadSourceVoxel 共用。
bool vptReadSourceVoxel(ivec3 worldBlock, out uint source)
{
    ivec3 sectionCoord = ivec3(
        vliFloorDiv(worldBlock.x, 16),
        vliFloorDiv(worldBlock.y, 16),
        vliFloorDiv(worldBlock.z, 16)
    );
    uint pageIndex;
    if(g_vptMemoPageValid && all(equal(g_vptMemoSection, sectionCoord)))
    {
        pageIndex = g_vptMemoPage;
    }
    else
    {
        if(!vliLookupSectionPage(sectionCoord, pageIndex)) return false;
        g_vptMemoSection = sectionCoord;
        g_vptMemoPage = pageIndex;
        g_vptMemoPageValid = true;
    }
    ivec3 local = ivec3(
        vliPositiveMod(worldBlock.x, 16),
        vliPositiveMod(worldBlock.y, 16),
        vliPositiveMod(worldBlock.z, 16)
    );
    uint index = uint(local.x) + 16u * (uint(local.z) + 16u * uint(local.y));
    source = vliPagesBuffer.words[pageIndex * VLI_PAGE_WORDS + index];
    return true;
}

// =====================================================
// 2026-10-13 增量式体素读取（逐位等价）。
//
// 病灶：`vptReadSourceVoxel` 每步要算 3 次 `vliFloorDiv` + 3 次 `vliPositiveMod`。
// 在 GPU 上整数除法与取模都是 emulated（高延迟、低吞吐单元），而 DDA 每步只动
// **一个轴** ⇒ 这六次除法里有五次是白算的。两条热循环各要跑几十步，所以它值得消。
//
// 做法：把 (section, local) 做成游标，只在跨 16 边界时 ±1，其余步只做加减。
//   · section = floorDiv(cell, 16)，local = cell − section*16 ∈ [0, 15]；
//   · 不变量与 `vptReadSourceVoxel` 的算法**逐位一致**，含负坐标：floorDiv 向 −∞
//     取整，所以 local 为 0 再退一步要回卷成 15 并把 section 减 1；反之亦然。
//   · 页表 memo（g_vptMemo*）完全沿用：三条键值比对一条不少，未命中的 section
//     依旧不进缓存 ⇒ 语义不变。
//   · `cell` 本身在两条循环里照旧维护（别处还要用它），游标只是并行跟着走。
//
// 成分访问一律用静态分量（.x/.y/.z）而不是 `[axis]` 动态下标 —— 动态下标会把
// 向量压到栈上，反而比除法更慢，这一点是刻意的。
// =====================================================
struct VptVoxelCursor
{
    ivec3 section;
    ivec3 local;
};

VptVoxelCursor vptMakeCursor(ivec3 cell)
{
    VptVoxelCursor cursor;
    cursor.section = ivec3(
        vliFloorDiv(cell.x, 16),
        vliFloorDiv(cell.y, 16),
        vliFloorDiv(cell.z, 16)
    );
    cursor.local = cell - cursor.section * 16;
    return cursor;
}

// axis: 0/1/2；stepSign: ±1。只有跨 16 边界的那一步会改 section。
void vptCursorStep(inout VptVoxelCursor cursor, int axis, int stepSign)
{
    if(axis == 0)
    {
        cursor.local.x += stepSign;
        if(cursor.local.x >= 16)
        {
            cursor.local.x = 0;
            cursor.section.x += 1;
        }
        else if(cursor.local.x < 0)
        {
            cursor.local.x = 15;
            cursor.section.x -= 1;
        }
    }
    else if(axis == 1)
    {
        cursor.local.y += stepSign;
        if(cursor.local.y >= 16)
        {
            cursor.local.y = 0;
            cursor.section.y += 1;
        }
        else if(cursor.local.y < 0)
        {
            cursor.local.y = 15;
            cursor.section.y -= 1;
        }
    }
    else
    {
        cursor.local.z += stepSign;
        if(cursor.local.z >= 16)
        {
            cursor.local.z = 0;
            cursor.section.z += 1;
        }
        else if(cursor.local.z < 0)
        {
            cursor.local.z = 15;
            cursor.section.z -= 1;
        }
    }
}

// 与 vptReadSourceVoxel 同义，只是 section/local 由游标给出（见上面的推导）。
bool vptReadSourceVoxelAt(VptVoxelCursor cursor, out uint source)
{
    uint pageIndex;
    if(g_vptMemoPageValid && all(equal(g_vptMemoSection, cursor.section)))
    {
        pageIndex = g_vptMemoPage;
    }
    else
    {
        if(!vliLookupSectionPage(cursor.section, pageIndex)) return false;
        g_vptMemoSection = cursor.section;
        g_vptMemoPage = pageIndex;
        g_vptMemoPageValid = true;
    }

    const uint index = uint(cursor.local.x) +
        16u * (uint(cursor.local.z) + 16u * uint(cursor.local.y));
    source = vliPagesBuffer.words[pageIndex * VLI_PAGE_WORDS + index];
    return true;
}

// Analytic ray/AABB entry distance of one voxel.  The local-light transmission
// march uses it to stop just before entering the emitter's own cell, so the
// emitter mesh cannot shadow its own emitted sample.  Returns a negative value
// when the segment misses the cell.
float vptEmitterVoxelEntryDistance(
    vec3 origin,
    vec3 target,
    ivec3 block
)
{
    vec3 segment = target - origin;
    float segmentLength = length(segment);
    if(segmentLength <= 1.0e-6)
    {
        return -1.0;
    }

    vec3 direction = segment / segmentLength;
    // Keep every component away from zero: an exactly parallel axis would
    // otherwise evaluate 0/0 = NaN and poison the min/max reduction below.
    vec3 safeDirection = mix(
        direction,
        vec3(1.0e-6),
        lessThan(abs(direction), vec3(1.0e-6))
    );

    vec3 boxMin = vec3(block);
    vec3 boxMax = boxMin + vec3(1.0);
    vec3 t0 = (boxMin - origin) / safeDirection;
    vec3 t1 = (boxMax - origin) / safeDirection;
    vec3 tNear = min(t0, t1);
    vec3 tFar = max(t0, t1);
    float tEnter = max(max(tNear.x, tNear.y), tNear.z);
    float tExit = min(min(tFar.x, tFar.y), tFar.z);
    if(tEnter > tExit || tExit < 0.0)
    {
        return -1.0;
    }
    return max(tEnter, 0.0);
}

// =====================================================
// 2026-10-01：本地直射的**几何面集合**余弦上限（用户定位：亮线只出现在地形折角，
// 比如墙与墙的夹角）
//
// 折角那一列像素同时贴着**两条**体素面。它们各自的面朝不同：一面朝灯、一面背灯。
// 只取"一条"几何面时，那一列像素会取到**朝灯的那面墙**的法线 ⇒ 余弦被放行 ⇒
// 屏幕上就是**沿夹角的一条亮线**（而两侧墙面本身各自正常）。
// 前几版都在换"怎么挑那一条"（浮雕主轴 → 射线入面 → 位置 + 占用），只要仍在"挑一条"，
// 折角上就总有一半像素挑错。
//
// 正解：**不挑**。命中点贴着几条**暴露面**就取几条，每条都按同一原则（几何面背对灯
// ⇒ 不放行）衰减，最后取**最小**。于是折角上的歧义只可能衰减、不可能放大 ——
// 与文件里那句"浮雕只能衰减，不能放大"是同一条原则。
//
// 只计**暴露面**：两侧同为实心（墙内平面）或同为空气（空腔）的平面不算面。
// 这一条很关键 —— 否则同一面墙上相邻两块方块的**共面接缝**也会被当成候选面
// （其法线沿墙面、余弦≈0），把每块方块的接缝都压暗。
// =====================================================
#ifndef VPT_LOCAL_FACE_SET_CONSERVATIVE
#define VPT_LOCAL_FACE_SET_CONSERVATIVE 1
#endif

// =====================================================
// 2026-10-02：本地直射的**体素保守遮挡**（这次是真正命中的那一条）
//
// 用户的关键描述：**封闭正方体，人在里面，灯在外面，每条棱上都有亮线** —— 立方体
// 的结构决定了"外面的灯照不到里面"，所以那是**从棱缝漏进来**的光。
//
// 机制：本地直射的可见性是一次**硬件射线**。网格在两面相交的**棱**上并不保证水密
// （相邻块各自生成的四边形只在棱上共边，浮点/精度下可以"从棱缝擦过去"）。
// 于是"接收点 → 灯"的射线在棱附近那一层方向的集合里能穿过去 ⇒ 每个棱在内部面上
// 都对应一条**细亮线** —— 与用户看到的"每个棱都有亮线"完全一致。这也解释了为什么
// 我此前所有"着色侧"（余弦/法线/取源/插值）的修改都毫无效果：射线路径没变。
//
// 这条体素 DDA 作为**补充门**（与硬件射线取"或"）：接收点 → 发光体采样点的路径上
// 只要穿过任何**实心**（class == 1）体素（不含发光体自己那一格）就判遮挡；射线贴棱/
// 贴角通过时按遮挡处理（保守）。玻璃/水（class != 1）照旧放行；Section 未驻留按本文件
// 既有口径当作"未知"、不判遮挡（否则会在未加载区画出硬边）。
//
// ⚠️ 2026-10-01 那一次失败的原因已查明：本宏的 `#ifndef/#define` 块当时**没有真正
// 落盘**（只留下了使用点），未定义标识符在 `#if` 里按 0 处理 ⇒ 那一版的门根本没编译。
// 现在补齐定义并逐项核对（编译后用 -D 反证）。
//
// A/B：-DVPT_LOCAL_CONSERVATIVE_VOXEL_OCCLUSION=0 回到纯硬件射线。
// =====================================================
#ifndef VPT_LOCAL_CONSERVATIVE_VOXEL_OCCLUSION
#define VPT_LOCAL_CONSERVATIVE_VOXEL_OCCLUSION 1
#endif

// =====================================================
// GI 弹射顶点上的本地光 NEE 开关（**仅用于性能对照**）。
//
// 背景：本地光不只在主不透明面上算一次。这条 NEE 在 diffuse GI 的每个弹射顶点上
// 还会各算一次（循环次数 = giBounceLimit，即 UI「GI 跳数」，0..2）。每次都是完整的
// 一套：RIS 候选扫描（约 5 次随机 SSBO 读 × 候选数）+ 一条硬件可见性射线 + 一次
// 体素 DDA。
//
// 而 evaluateVPTRISDirectLighting 里那句「keepProbability literally 就是每像素的
// 期望射线数」只对**主命中**成立：弹射顶点距相机的距离与主命中同量级，它自己的
// keepProbability 挡不掉多少。所以 GI 跳数 = 2 时，一个不透明像素最多付 3 次估值。
//
// 本宏 = 0 时把整段 GI 顶点本地光编译掉，主命中那一路原样保留。它**不提供**替代
// 估计量，所以画面会变暗（间接项少了本地光来源）——这是刻意的：拿它和基线做差分，
// 得到的 rt pass 时间差就是这条链的成本上界。
//
// A/B：-DVPT_GI_VERTEX_LOCAL_LIGHT=0
// =====================================================
#ifndef VPT_GI_VERTEX_LOCAL_LIGHT
#define VPT_GI_VERTEX_LOCAL_LIGHT 1
#endif

// 命中点贴近的那条体素面（axis = 0/1/2）。只有**一侧实心、另一侧空**才算暴露面；
// 符号由占用给出（哪一侧空，外法线就指向哪一侧），与浮雕无关。
bool vptVoxelFaceNormalFromHit(
    vec3 hitPos,
    int axis,
    out vec3 faceNormal
)
{
    vec3 axisVector =
        axis == 0 ? vec3(1.0, 0.0, 0.0) :
        (axis == 1 ? vec3(0.0, 1.0, 0.0) : vec3(0.0, 0.0, 1.0));

    uint positiveSource = 0u;
    uint negativeSource = 0u;
    bool positiveSolid =
        vptReadSourceVoxel(ivec3(floor(hitPos + axisVector * 0.5)), positiveSource) &&
        ((positiveSource & 3u) == 1u);
    bool negativeSolid =
        vptReadSourceVoxel(ivec3(floor(hitPos - axisVector * 0.5)), negativeSource) &&
        ((negativeSource & 3u) == 1u);

    if(positiveSolid == negativeSolid)
    {
        faceNormal = vec3(0.0);
        return false;
    }

    faceNormal = positiveSolid ? -axisVector : axisVector;
    return true;
}

// 几何面集合上的余弦上限：primaryKnown 是射线法给出的那一面（可能没有），
// 再加上命中点贴近的所有暴露面，取最小。
// 容差必须在本函数之前可见（本文件里同名宏的另一处定义在调用点之后，
// 预处理器是顺序展开的 ⇒ 必须先有一份，否则 "undeclared identifier"）。
// 2026-10-31：1.0e-3 → 5.0e-3。壳实验（ORION_OPAQUE_SHELL_OFFSET）把可见面沿
// 平面外推 ~2e-3 格 ⇒ 命中点离开体素边界 1e-3 邻域 ⇒ 两处消费点（本函数的
// 保守面集合、VPT_LOCAL_FACE_AXIS_FROM_POSITION 的几何面恢复）双双失效，
// 回退到浮雕量化法线 ⇒ 10-01 那类"沿棱亮线"在壳开启时整片回来。
// 真实地形面全部精确贴在体素边界（fract≈0，1e-3 本就覆盖），1e-3~5e-3 区间
// 只有被壳位移过的面会落进去；半砖/雪层/水面都在 0.125 档位上，远在容差外。
// ⚠ 本文件同名宏有两份定义（预处理器取第一份），改这里才是改生效值。
#ifndef VPT_LOCAL_FACE_AXIS_EPS
#define VPT_LOCAL_FACE_AXIS_EPS 5.0e-3
#endif

// =====================================================
// 2026-10-02：本地直射的**体素保守遮挡**（用户"封闭立方体内部每个棱都有亮线"驱动）
//
// 机制：可见性是一次**硬件射线**，而网格在两面相交的**棱**上并不保证水密（相邻块各自
// 生成的四边形只在棱上共边，精度下可以"从棱缝擦过去"）⇒ 外面的灯通过每条棱在内部面
// 上留下一条细亮线。着色侧的修改（余弦/法线/取源/插值）都改不了射线路径，所以全都无效。
//
// 本 DDA 与硬件射线取"或"：路径上穿过任何**实心**（class == 1）体素（不含发光体自己
// 那一格）判遮挡；贴棱/贴角通过时保守判遮挡；玻璃/水（class != 1）放行；Section 未驻留
// 按本文件既有口径当作"未知"、不判遮挡。
// A/B：-DVPT_LOCAL_CONSERVATIVE_VOXEL_OCCLUSION=0
// =====================================================
#ifndef VPT_VOXEL_PATH_CORNER_EPS
#define VPT_VOXEL_PATH_CORNER_EPS 1.0e-3
#endif
#ifndef VPT_VOXEL_PATH_MAX_STEPS
#define VPT_VOXEL_PATH_MAX_STEPS 256
#endif

bool vptVoxelPathBlocked(
    vec3 origin,
    vec3 target,
    ivec3 emitterBlock,
    float stopDistance
)
{
    // 2026-10-13 stage 16：剥离臂直接当"没有遮挡"（见 perfL10DisableVoxelDda）。
    if(perfL10DisableVoxelDda())
    {
        return false;
    }

    vec3 segment = target - origin;
    float fullLength = length(segment);
    if(fullLength <= 1.0e-4)
    {
        return false;
    }
    float limit = min(fullLength, max(stopDistance, 0.0));
    if(limit <= 1.0e-4)
    {
        return false;
    }

    vec3 direction = segment / fullLength;
    ivec3 cell = ivec3(floor(origin));
    ivec3 stepVector = ivec3(sign(direction));
    vec3 invAbs = 1.0 / max(abs(direction), vec3(1.0e-6));
    vec3 boundary = vec3(cell) + vec3(max(stepVector, ivec3(0)));
    vec3 tMax = (boundary - origin) / direction;
    if(stepVector.x == 0) tMax.x = 1.0e30;
    if(stepVector.y == 0) tMax.y = 1.0e30;
    if(stepVector.z == 0) tMax.z = 1.0e30;

    // 2026-10-13：增量游标（见 vptMakeCursor / vptCursorStep 的说明）。
    VptVoxelCursor vptCursor = vptMakeCursor(cell);

    for(int i = 0; i < VPT_VOXEL_PATH_MAX_STEPS; ++i)
    {
        int axis = tMax.x < tMax.y
            ? (tMax.x < tMax.z ? 0 : 2)
            : (tMax.y < tMax.z ? 1 : 2);
        float t = axis == 0 ? tMax.x : (axis == 1 ? tMax.y : tMax.z);
        if(t >= limit)
        {
            return false;
        }

        // 棱/角：射线贴着两块相接的棱通过 ⇒ 网格那里没有面、硬件射线会滑过去，
        // 这里保守判遮挡（这正是"封闭立方体内部每条棱都亮"的那条通道）。
        float otherA = axis == 0 ? tMax.y : tMax.x;
        float otherB = axis == 2 ? tMax.y : tMax.z;
        if(min(abs(otherA - t), abs(otherB - t)) <=
            VPT_VOXEL_PATH_CORNER_EPS * (1.0 + abs(t)))
        {
            return true;
        }

        if(axis == 0)
        {
            cell.x += stepVector.x;
            vptCursorStep(vptCursor, 0, stepVector.x);
            tMax.x += invAbs.x;
        }
        else if(axis == 1)
        {
            cell.y += stepVector.y;
            vptCursorStep(vptCursor, 1, stepVector.y);
            tMax.y += invAbs.y;
        }
        else
        {
            cell.z += stepVector.z;
            vptCursorStep(vptCursor, 2, stepVector.z);
            tMax.z += invAbs.z;
        }

        if(all(equal(cell, emitterBlock)))
        {
            return false;
        }

        uint source;
        if(vptReadSourceVoxelAt(vptCursor, source) && ((source & 3u) == 1u))
        {
            return true;
        }
    }
    return false;
}

float vptLocalFaceSetCosineBound(
    bool primaryKnown,
    vec3 primaryFaceNormal,
    vec3 hitPos,
    vec3 lightDirection
)
{
    float bound = primaryKnown
        ? max(dot(primaryFaceNormal, lightDirection), 0.0)
        : 1.0;

#if VPT_LOCAL_FACE_SET_CONSERVATIVE
    vec3 fracPos = fract(hitPos);
    vec3 distToFace = min(fracPos, vec3(1.0) - fracPos);
    for(int c = 0; c < 3; ++c)
    {
        float faceDistance =
            c == 0 ? distToFace.x : (c == 1 ? distToFace.y : distToFace.z);
        if(faceDistance > VPT_LOCAL_FACE_AXIS_EPS)
        {
            continue;
        }
        vec3 faceNormal;
        if(vptVoxelFaceNormalFromHit(hitPos, c, faceNormal))
        {
            bound = min(
                bound,
                max(dot(faceNormal, lightDirection), 0.0)
            );
        }
    }
#endif

    return bound;
}

// Superseded by vptEmitterVoxelEntryDistance(); no call sites remain.
//
// This walk is not only page-table dependent, it also caps at 96 steps while
// the local-light budget reaches 160 blocks (~277 steps along a diagonal
// segment), so any emitter farther than roughly 55-96 blocks reported "path
// not loaded" - and because the cap scaled with the ray direction, the failure
// boundary was direction dependent.  Callers used that result as a visibility
// gate, which hard-zeroed the entire local-light term on an invisible distance
// shell instead of letting the hardware occlusion query decide.
//
// It is retained only as a loaded-world boundary test.  It must not decide
// material visibility: its compact source word has no transparent-material
// class or RGB transmission, so treating occupancy as visibility would make
// coloured glass opaque to local RIS lighting.
bool vptLoadedPathToCandidateEmitter(
    vec3 origin,
    vec3 target,
    ivec3 targetBlock,
    out float targetVoxelEntryDistance
)
{
    vec3 segment = target - origin;
    float maxDistance = length(segment);
    targetVoxelEntryDistance = maxDistance;
    if(maxDistance <= 1.0e-4)
    {
        return true;
    }

    vec3 direction = segment / maxDistance;
    // A ray can cross at most one voxel per axis unit.  Bound the loop by
    // the actual segment while retaining the old worst-case cap.
    int maxTraversal = min(
        96,
        int(ceil(maxDistance * dot(abs(direction), vec3(1.0)))) + 2
    );
    ivec3 cell = ivec3(floor(origin));
    ivec3 step = ivec3(sign(direction));
    vec3 invAbs = 1.0 / max(abs(direction), vec3(1.0e-6));
    vec3 boundary = vec3(cell) + vec3(max(step, ivec3(0)));
    vec3 tMax = (boundary - origin) / direction;
    if(step.x == 0) tMax.x = 1.0e30;
    if(step.y == 0) tMax.y = 1.0e30;
    if(step.z == 0) tMax.z = 1.0e30;

    for(int traversal = 0; traversal < maxTraversal; ++traversal)
    {
        int axis = tMax.x < tMax.y
            ? (tMax.x < tMax.z ? 0 : 2)
            : (tMax.y < tMax.z ? 1 : 2);
        float travel = axis == 0 ? tMax.x : (axis == 1 ? tMax.y : tMax.z);
        if(travel >= maxDistance)
        {
            return true;
        }

        if(axis == 0)
        {
            cell.x += step.x;
            tMax.x += invAbs.x;
        }
        else if(axis == 1)
        {
            cell.y += step.y;
            tMax.y += invAbs.y;
        }
        else
        {
            cell.z += step.z;
            tMax.z += invAbs.z;
        }

        if(all(equal(cell, targetBlock)))
        {
            targetVoxelEntryDistance = travel;
            return true;
        }

        uint source;
        if(!vptReadSourceVoxel(cell, source))
        {
            return false;
        }
    }
    return false;
}

// Defined after the ray payload and ray-mode declarations.  The selected
// local-light sample uses exactly one of these queries; the M=2 proposals
// remain cheap and do not trace visibility individually.  The body now lives
// further down (judgement-experiment probe wrapper around the shared march).
vec3 vptTraceGlassTransmissionToEmitter(
    vec3 origin,
    vec3 target,
    float targetVoxelEntryDistance
);

// 2026-09-25: the local-light NEE must use the hardware visibility contract,
// not the dye-only voxel march.  glassTraceTransmissionToEmitter() performs NO
// occlusion test (its own comment says so: "an opaque wall between the receiver
// and the selected emitter does not stop the term"), which is exactly how local
// light reached ACROSS a wall -- reported as "隔墙的直射光能穿墙" and scaling with
// 「本地光最远照明距离」 because a longer range lets more receivers sample the same
// emitter.  rt_restir_final.rgen already made this swap for the primary
// ReSTIR DI term (LOCAL_DI_FINAL_VISIBILITY_RAY); this brings the same model to
// the route-A NEE and to the glass/water receivers that share this estimator.
// false = the old occlusion-blind march, kept as the ablation arm.
const bool VPT_LOCAL_NEE_VISIBILITY_RAY =
    true;

// 2026-10-07：多了 cullMask 参数 —— 移动光源要**忽略本地玩家自身代理**（手里的灯不该
// 被自己的模型/手持物挡住），而方块光维持原样。见定义处与 DYNAMIC_LIGHT_CULL_MASK。
vec3 traceVptLocalLightVisibility(
    vec3 origin,
    vec3 target,
    float targetVoxelEntryDistance,
    uint cullMask
);

// rainWallParams1.w = 「本地光距离系数」（0.25 ~ 2.0，1.0 = 标准）。
// 旧 DLL 恒写 0（reserved 位）⇒ 回落 1.0，双向兼容。
float vptLocalLightRangeScale()
{
    float user = cam.rainWallParams1.w;
    return (user >= 0.05 && user <= 8.0) ? user : 1.0;
}

// 传播距离 = 该光源档案的基础距离 × 用户系数，封顶 30 格。
// 2026-10-31：不再用"emission × 2 格"这一个口径 —— 火把 11 格、营火 15 格、
// 荧石 18 格、岩浆 26 格、信标 28 格，各自在 local_light_profile.glsl 里定好。
float vptLocalLightRange(uint typeCode, float emissionLevel)
{
    float base = localLightProfileBaseRange(typeCode, emissionLevel);
    return clamp(base * vptLocalLightRangeScale(), 1.5, VPT_LOCAL_MAX_DISTANCE);
}

float vptLocalLightRangeFade(
    float distanceToLight,
    uint typeCode,
    float emissionLevel)
{
    float range = vptLocalLightRange(typeCode, emissionLevel);
    return 1.0 - smoothstep(
        range * VPT_LOCAL_FADE_START_FRACTION,
        range,
        distanceToLight
    );
}

float vptLocalLightDistanceAttenuation(float distanceToLight)
{
    return 0.55 / (1.0 + 0.18 * distanceToLight +
        0.025 * distanceToLight * distanceToLight);
}

float rand(inout uint state);

// Deterministic base-2 radical inverse for the 96-sample fixed sequence.
float vptRadicalInverseBase2(uint value)
{
    float result = 0.0;
    float weight = 0.5;
    for(int bit = 0; bit < 7; ++bit)
    {
        if((value & 1u) != 0u)
        {
            result += weight;
        }
        value >>= 1u;
        weight *= 0.5;
    }
    return result;
}

// A fixed low-discrepancy distribution over a 2.0 x 2.0 area emitter.  It
// has no stochastic phase, so visibility integration is temporally stable.
vec2 vptAreaLightStratum(uint sampleIndex)
{
    return vec2(
        (float(sampleIndex) + 0.5) / float(VPT_AREA_LIGHT_HISTORY_SAMPLES) - 0.5,
        vptRadicalInverseBase2(sampleIndex) - 0.5
    );
}

// VPT-3.3D.7 single-frame RIS: propose from every non-empty source Section in
// the complete local 5x5x5 neighborhood, then from that Section's exact
// emitter index.  There is still just one selected voxel-DDA visibility path.
// Unlike the old Binding 29 Top-8 list, crossing a receiver Section boundary
// cannot silently remove a still-in-range light from the proposal domain.
// One independent RIS estimate: two proposals and exactly one visibility path.
// The distance-budget wrapper below invokes this one or more times as needed.
uint pcg_hash(inout uint state);

// Defined with the VPT temporal helpers below. ReSTIR DI shares their
// world-space reprojection contract but owns independent reservoir storage.
bool vptReprojectPreviousPixel(
    vec3 worldPosition,
    ivec2 renderSize,
    out uint previousIndex
);


// =====================================================
// 2026-10-24：RIS 提案数默认值（修"候选数旋钮断线"⇒ 每帧只抽 1 个提案）
//
// perfPrimary/perfSecondary 两条 lane 在 Perf-L10 改造后已无任何写入方
// （VulkanCore.cpp / Java 全仓 grep 无命中 ⇒ 恒 0），而本文件三处读
// perfSecondary.x 当"提案数"：clamp(0, 1, 32) = 1 ⇒ 本地光 RIS 从那时起
// 一直只抽 **1 个**提案 —— 权重归一里 weightSum/(proposals×selectedWeight)
// 在 proposals=1 时逐位等于 1，估计值就是"随机一个发射体的全额贡献"，
// 方差最大档。09-30 用户实测"候选数怎么调都不动"正是因为设置旋钮从来没
// 接到过这条 lane。
//
// 提案是纯 buffer 读 + 权重 ALU，**不新增可见性射线**（仍然每次调用恰好
// 1 条，见 VPT_LOCAL_KEEP 处的记载）；1 → 16 只花 ALU，直接压掉"挑选
// 方差"这一层。lane 将来若重新接线，非 0 值仍然生效。
// A/B：-DVPT_RIS_PROPOSAL_OVERRIDE=1 回到旧档（死 lane ⇒ 恒 1）。
// =====================================================
#ifndef VPT_RIS_PROPOSAL_FLOOR
#define VPT_RIS_PROPOSAL_FLOOR 16
#endif

uint vptRisProposalCount()
{
#if VPT_RIS_PROPOSAL_OVERRIDE
    return clamp(cam.perfSecondary.x, 1u, 32u);
#else
    uint proposalLane = cam.perfSecondary.x;
    return proposalLane != 0u
        ? clamp(proposalLane, 1u, 32u)
        : uint(VPT_RIS_PROPOSAL_FLOOR);
#endif
}

// 2026-10-26 RTXDI 式直接光 reservoir 的合并/可见性尾段。定义在
// evaluateVPTCandidateDirectTemporal 之后（重投影与抖动补偿helper 都在那里），
// 这里先给原型 —— 与文件里 getDLSSFrameJitter 的前向声明同一手法。
vec3 evaluateVPTDirectLightReservoirTail(
    vec3 hitPos,
    vec3 N,
    vec3 hitAlbedo,
    bool waterColumnReceiver,
    bool geometricFaceKnown,
    vec3 geometricFaceRecovered,
    float currentWeightSum,
    vec3 currentContribution,
    vec3 currentSample,
    uint currentEmission,
    uint currentTypeCode,
    bool shadingActive,
    inout uint rngState
);

vec3 evaluateVPTRISDirectLightingSingle(
    vec3 hitPos,
    vec3 hitNormal,
    vec3 hitAlbedo,
    vec3 geometricFaceNormal,
    bool useTemporalReservoir,
    bool shadingActive,
    inout uint rngState
)
{
    // ===== DBG_LADDER_C: 单个本地光 RIS 可达 → 纯黄 =====
    if(DBG_LADDER_C) { return vec3(1.0, 1.0, 0.0); }

    // =====================================================
    // 2026-10-03 **消灭明暗分界线（1/3）：目录查找抖动**。
    //
    // risInitial() 的口径：
    //   "Stochastically blend across hard section boundaries. Every cell proposal
    //    retains full global support, so conditioning on this independently
    //    jittered lookup remains unbiased."
    // 我们此前的目录是**按接收点硬选 Section**（floor(hitPos/16)）⇒ 候选域跨过
    // 16 格平面时整体突变 ⇒ 屏幕上一条笔直的分界线。这里照抄同一招：把**用于选
    // 目录的位置**抖动 ±半 Section。真实着色位置（hitPos/法线/余弦/权重 target）
    // 一律不动，只有"去哪个目录取候选"被随机化，而提案 pdf 始终按**实际使用的
    // 那个目录**计算（下面 sourceDirectoryEntry.selectionProbability）⇒ RIS 仍无偏。
    // =====================================================
    const vec3 directoryJitter = vec3(
        rand(rngState), rand(rngState), rand(rngState)) - vec3(0.5);
    ivec3 receiverSection = ivec3(floor((hitPos + directoryJitter * 16.0) / 16.0));
    uint receiverPage;
    // Section whose source directory we actually read.  It is normally the
    // receiver's own Section; see the miss path below.
    ivec3 directorySection = receiverSection;
    // 2026-10-03 借目录混合（消除明暗分界线的候选修复 #2）：接收点自有页缺失
    // 时，旧实现按 +x→−x→+y→… 的**固定顺序**取第一个有页邻居当唯一捐助者 ⇒
    // 接收点跨 Section 边界时捐助者可能在两个邻居间翻转 ⇒ 提案权重离散跳变
    // ⇒ 可见的明暗分界。新实现取**距离最近的两个**有页邻居，按距离连续混合
    //（等距时 0.5/0.5），pdf 乘对应混合权重保持无偏。自有页存在时混合不生效，
    // 行为与旧版逐位一致。
    float borrowDonorWeightA = 1.0;
    bool borrowDonorBValid = false;
    ivec3 borrowDonorBSection = ivec3(0);
    uint borrowDonorBPage = 0u;
    float borrowDonorBDistanceSquared = 1.0e30;
    if(!vliLookupSectionPage(receiverSection, receiverPage))
    {
        // A Section missing from the VPT page table is *unknown*, not black.
        // Returning zero here removed the complete local-light term over whole
        // 16-block Sections, which is what painted the hard, un-jittered
        // terminators along the Section grid on otherwise uniformly lit walls.
        //
        // Borrow the first resident axis neighbour instead.  Directory offsets
        // are stored relative to the Section that owns the directory, so every
        // emitter is still reconstructed at its true absolute position by
        // offsetting from `directorySection` rather than `receiverSection`.
        // Only the Section-level proposal weights become the donor's, which is
        // a bounded approximation versus a hard black band.
        bool borrowedDirectory = false;
        ivec3 donorASection = ivec3(0);
        uint donorAPage = 0u;
        float donorADistanceSquared = 1.0e30;
        for(uint neighbourIndex = 0u; neighbourIndex < 6u; ++neighbourIndex)
        {
            ivec3 neighbour = receiverSection + (
                neighbourIndex == 0u ? ivec3( 1,  0,  0) :
                neighbourIndex == 1u ? ivec3(-1,  0,  0) :
                neighbourIndex == 2u ? ivec3( 0,  1,  0) :
                neighbourIndex == 3u ? ivec3( 0, -1,  0) :
                neighbourIndex == 4u ? ivec3( 0,  0,  1) :
                                       ivec3( 0,  0, -1)
            );
            uint neighbourPage;
            if(vliLookupSectionPage(neighbour, neighbourPage))
            {
                borrowedDirectory = true;
                const vec3 neighbourCenter =
                    vec3(neighbour) * 16.0 + vec3(8.0);
                const vec3 toNeighbour = hitPos - neighbourCenter;
                const float neighbourDistanceSquared =
                    dot(toNeighbour, toNeighbour);
                if(neighbourDistanceSquared < donorADistanceSquared)
                {
                    borrowDonorBSection = donorASection;
                    borrowDonorBPage = donorAPage;
                    borrowDonorBDistanceSquared = donorADistanceSquared;
                    donorASection = neighbour;
                    donorAPage = neighbourPage;
                    donorADistanceSquared = neighbourDistanceSquared;
                }
                else if(neighbourDistanceSquared < borrowDonorBDistanceSquared)
                {
                    borrowDonorBSection = neighbour;
                    borrowDonorBPage = neighbourPage;
                    borrowDonorBDistanceSquared = neighbourDistanceSquared;
                }
            }
        }
        if(!borrowedDirectory)
        {
            return vec3(0.0);
        }
        directorySection = donorASection;
        receiverPage = donorAPage;
        // 混合权重：越近的捐助者权重越大（w_A = d_B/(d_A+d_B)，等距 0.5/0.5）。
        // 只有一个有页邻居时 w_A = 1（退化为旧行为）。
        borrowDonorBValid = borrowDonorBDistanceSquared < 1.0e29;
        if(borrowDonorBValid)
        {
            const float donorADistance = sqrt(donorADistanceSquared);
            const float donorBDistance = sqrt(borrowDonorBDistanceSquared);
            borrowDonorWeightA =
                donorBDistance / max(donorADistance + donorBDistance, 1.0e-6);
        }
    }

    // A zero normal is the dedicated water-column receiver.  It has no
    // Lambert-facing hemisphere: a submerged light may arrive from above,
    // below or the side, while the proposal stays on the normal M=2 RIS
    // budget.
    bool waterColumnReceiver = dot(hitNormal, hitNormal) <= 1.0e-8;
    vec3 N = waterColumnReceiver
        ? vec3(0.0, 1.0, 0.0)
        : normalize(hitNormal);

    // 2026-09-30 / 2026-10-01：「木块视差在无受光面上发光」。
    //
    // 这条路径的余弦只认浮雕法线（payload.normal 已经带上了 POM 位移后采样的
    // 法线贴图），而它既没有太阳路径的 8 向软阴影，也没有 pomSelfShadow 兜底 ——
    // 唯一的可见性射线起点是平面 hitPos 上的 receiverOrigin，与浮雕无关。于是
    // 浮雕里朝光倾斜的纹素（灰缝/板缝的侧壁）会越过几何面的地平线被点亮：无受
    // 光面上出现一层与浮雕同周期的亮纹，且只跟本地直射光走 —— 太阳那边同样的
    // 浮雕余弦被 shadowTransmittance 乘掉了，所以「跟太阳无关」。
    //
    // 第一版用 vptDominantBlockFaceNormal(N) 取浮雕法线的 dominant 轴当几何面，
    // 实测无效（2026-10-01 的 DBG_LOCAL_TERM_MAP 表确认 R = 本项，亮纹与浮雕同
    // 周期）。原因是 dominant 轴取的是 N 的**符号**：浮雕法线倾角越过 45° 的纹素
    // 会把面朝向翻到相邻轴甚至反号，恰好就在「越过地平线」的那些纹素上放行，而
    // 那正是亮纹所在。
    //
    // 第二版改用主命中处的 primaryGeometricNormal，**仍然无效**：它其实就是
    // payload.normal —— rchit 里 worldNormal = tbn * tangentNormal 写出的着色法线，
    // 浮雕早就在里面，于是 min(cos(N), cos(几何面)) 退化成恒等。
    //
    // 所以几何面法线必须另取：当前由 vptGeometricFaceNormalFromRay（主光线跨过
    // 体素边界的入面）就地恢复，精确且不受浮雕法线影响。浮雕只能衰减、不能放大：
    // 浮雕法线越过几何面地平线的纹素直接判不可达。调用方没给几何面法线（vec3(0)）
    // 时回退到旧的浮雕量化，行为与旧版一致。
    // -DVPT_LOCAL_GEOMETRIC_COSINE_BOUND=0 可回到旧行为做 A/B。
#ifndef VPT_LOCAL_GEOMETRIC_COSINE_BOUND
#define VPT_LOCAL_GEOMETRIC_COSINE_BOUND 1
#endif

// =====================================================
// 2026-10-01 第三版（用户读数驱动）：几何面法线在**擦边/轮廓**处的兜底
//
// 前两版失败的记录见上面的长注释。第三版（vptGeometricFaceNormalFromRay）在**射线
// 擦着面走**的像素上会失效：它靠"沿射线前后各走 1e-3 格是否跨体素边界"判入面，
// 而擦边像素沿射线方向**不跨**任何边界 ⇒ 返回 vec3(0) ⇒ 代码回退到
// vptDominantBlockFaceNormal(N)（**浮雕量化**法线）⇒ 恰好在这些像素上让浮雕越过
// 几何面地平线放行 ⇒ **沿棱的一条亮线**。用户用 DBG_LOCAL_TERM_MAP 读出该亮线是
// 纯红（R = RIS 本地直射），与本项吻合。
//
// 兜底改用**两个都不看浮雕的几何量**：
//   · 轴：命中点分数坐标离哪条轴边界最近（体素面就是 fract ≈ 0 或 1）；
//   · 符号：**占用**——哪一侧不是实心，外法线就指向那一侧。
// 于是浮雕无论怎么倾斜都无法把面"翻"到朝向灯的方向，正好落实本文件那句
// "浮雕只能衰减，不能放大"。
// 非体素对齐几何（voxy/DH LOD 大四边形、实体网格）的 fract 不贴边界 ⇒ 不介入，
// 保持旧的浮雕回退（与旧版一致）。
//
// A/B：-DVPT_LOCAL_FACE_AXIS_FROM_POSITION=0 回到旧回退。
// =====================================================
#ifndef VPT_LOCAL_FACE_AXIS_FROM_POSITION
#define VPT_LOCAL_FACE_AXIS_FROM_POSITION 1
#endif
// 2026-10-31：1.0e-3 → 5.0e-3。原因：不透明面外扩壳实验（ORION_OPAQUE_SHELL_OFFSET，
// 见 VulkanCore.cpp uploadChunk）把可见面沿平面外推 ~2e-3 格，命中点不再落在体素
// 边界的 1e-3 邻域内 ⇒ 本恢复失败 ⇒ 回退到浮雕量化法线 ⇒ 10-01 那类"沿棱亮线"
// 在壳开启时整片回来。真实地形面全部精确贴在体素边界（fract≈0，1e-3 本就覆盖），
// 1e-3~5e-3 区间只有被壳位移过的面会落进去 ⇒ 放宽容差不影响任何真实几何的判定。
// 半砖/楼梯顶（fract≈0.5）、雪层（0.125 的倍数）都远在容差外，不受影响。
#ifndef VPT_LOCAL_FACE_AXIS_EPS
#define VPT_LOCAL_FACE_AXIS_EPS 5.0e-3
#endif

#if VPT_LOCAL_GEOMETRIC_COSINE_BOUND
    bool geometricFaceKnown =
        dot(geometricFaceNormal, geometricFaceNormal) > 0.25;
    vec3 geometricFaceRecovered = geometricFaceNormal;
#if VPT_LOCAL_FACE_AXIS_FROM_POSITION
    if(!waterColumnReceiver && !geometricFaceKnown)
    {
        vec3 fracPos = fract(hitPos);
        vec3 distToFace = min(fracPos, vec3(1.0) - fracPos);
        float nearestFace = min(distToFace.x, min(distToFace.y, distToFace.z));
        if(nearestFace <= VPT_LOCAL_FACE_AXIS_EPS)
        {
            int faceAxis = 0;
            if(distToFace.y == nearestFace)
            {
                faceAxis = 1;
            }
            else if(distToFace.z == nearestFace)
            {
                faceAxis = 2;
            }
            vec3 axisVector = vec3(0.0);
            axisVector[faceAxis] = 1.0;

            uint positiveSource = 0u;
            uint negativeSource = 0u;
            // 占用 = 整格(class 1) 或部分遮挡(class 3)。半砖/栅栏也是该面的所有者，
            // 若只认 class 1，它们的轮廓像素会退回浮雕量化法线（本项要修的亮线）。
            bool positiveSolid =
                vptReadSourceVoxel(ivec3(floor(hitPos + axisVector * 0.5)), positiveSource) &&
                vptVoxelOccupied(positiveSource);
            bool negativeSolid =
                vptReadSourceVoxel(ivec3(floor(hitPos - axisVector * 0.5)), negativeSource) &&
                vptVoxelOccupied(negativeSource);

            geometricFaceRecovered = vec3(0.0);
            geometricFaceRecovered[faceAxis] =
                (positiveSolid && !negativeSolid) ? -1.0 : 1.0;
            geometricFaceKnown = true;
        }
    }
#endif
    vec3 localGeometricN = waterColumnReceiver
        ? vec3(0.0, 1.0, 0.0)
        : (geometricFaceKnown
            ? normalize(geometricFaceRecovered)
            : vptDominantBlockFaceNormal(N));
#endif
#if !VPT_LOCAL_GEOMETRIC_COSINE_BOUND
    // WRS 尾段按统一签名接收这两个量；关闭几何面余弦上界时它们不参与计算。
    bool geometricFaceKnown = false;
    vec3 geometricFaceRecovered = vec3(0.0);
#endif

    vec3 selectedContribution = vec3(0.0);
    vec3 selectedSample = vec3(0.0);
    ivec3 selectedBlock = ivec3(0);
    // 灯的持久身份（WRS 历史只存世界坐标/发射强度/类型，不存临时索引）。
    uint selectedEmission = 0u;
    uint selectedTypeCode = 0u;
    float weightSum = 0.0;
    uint directoryBase = receiverPage * VPT_SOURCE_DIRECTORY_ENTRIES_PER_PAGE;
    uint sourceSectionCount = min(
        vptSourceDirectoryPagesBuffer.entries[directoryBase].pageIndex,
        VPT_SOURCE_DIRECTORY_MAX_SECTIONS
    );
    if(sourceSectionCount == 0u)
    {
        // =====================================================
        // 2026-10-03 **消灭明暗分界线（2/3）：空目录向外借**。
        //
        // 旧实现：所选 Section 的目录为空（它 ±2 圈内没有发射体）⇒ 整项归零。
        // 接收点跨过 16 格平面时，一侧目录非空、另一侧为空 ⇒ 一侧有光、另一侧
        // 全黑 —— 又是一条笔直的分界线（与"页缺失"同类，只是发生在目录层面）。
        //
        // 这里向外借**邻居的目录**（不只是页）：取第一个非空的。发射体的绝对位置
        // 按 donor 的 Section 重建（偏移本就是相对目录拥有者存的），提案权重用
        // donor 目录自己的 selectionProbability ⇒ RIS 仍无偏，最坏的代价只是
        // "Section 级提案权重变成 donor 的"，绝不会归零。
        // =====================================================
        bool borrowedDirectoryEntries = false;
        for(uint neighbourIndex = 0u; neighbourIndex < 6u; ++neighbourIndex)
        {
            ivec3 neighbour = directorySection + (
                neighbourIndex == 0u ? ivec3( 1,  0,  0) :
                neighbourIndex == 1u ? ivec3(-1,  0,  0) :
                neighbourIndex == 2u ? ivec3( 0,  1,  0) :
                neighbourIndex == 3u ? ivec3( 0, -1,  0) :
                neighbourIndex == 4u ? ivec3( 0,  0,  1) :
                                       ivec3( 0,  0, -1)
            );
            uint neighbourPage;
            if(!vliLookupSectionPage(neighbour, neighbourPage))
            {
                continue;
            }
            const uint neighbourBase =
                neighbourPage * VPT_SOURCE_DIRECTORY_ENTRIES_PER_PAGE;
            const uint neighbourCount = min(
                vptSourceDirectoryPagesBuffer.entries[neighbourBase].pageIndex,
                VPT_SOURCE_DIRECTORY_MAX_SECTIONS
            );
            if(neighbourCount == 0u)
            {
                continue;
            }
            directorySection = neighbour;
            receiverPage = neighbourPage;
            directoryBase = neighbourBase;
            sourceSectionCount = neighbourCount;
            borrowedDirectoryEntries = true;
            break;
        }
        if(!borrowedDirectoryEntries)
        {
            return vec3(0.0);
        }
    }

    for(uint proposalIndex = 0u;
        proposalIndex < vptRisProposalCount();
        ++proposalIndex)
    {
        // 2026-10-03 借目录混合：本次提案按权重挑捐助者目录（自有页存在时
        // borrowDonorBValid = false，恒用 A，行为与旧版一致）。
        ivec3 proposalDirectorySection = directorySection;
        uint proposalDirectoryBase = directoryBase;
        uint proposalSectionCount = sourceSectionCount;
        float proposalDonorWeight = borrowDonorWeightA;
        if(borrowDonorBValid && rand(rngState) >= borrowDonorWeightA)
        {
            proposalDirectorySection = borrowDonorBSection;
            proposalDirectoryBase =
                borrowDonorBPage * VPT_SOURCE_DIRECTORY_ENTRIES_PER_PAGE;
            proposalSectionCount = min(
                vptSourceDirectoryPagesBuffer.entries[proposalDirectoryBase].pageIndex,
                VPT_SOURCE_DIRECTORY_MAX_SECTIONS
            );
            proposalDonorWeight = 1.0 - borrowDonorWeightA;
        }
        if(proposalSectionCount == 0u || proposalDonorWeight <= 0.0)
        {
            continue;
        }
        uint sourceDirectoryBucket = min(
            uint(rand(rngState) * float(proposalSectionCount)),
            proposalSectionCount - 1u
        );
        VPTSourceDirectoryEntry sourceDirectoryBucketEntry =
            vptSourceDirectoryPagesBuffer.entries[
            proposalDirectoryBase + 1u + sourceDirectoryBucket
        ];
        uint sourceDirectoryIndex = rand(rngState) <=
            float(sourceDirectoryBucketEntry.aliasThresholdQ16) / 65535.0
            ? sourceDirectoryBucket
            : min(sourceDirectoryBucketEntry.aliasIndex, proposalSectionCount - 1u);
        VPTSourceDirectoryEntry sourceDirectoryEntry =
            vptSourceDirectoryPagesBuffer.entries[
                proposalDirectoryBase + 1u + sourceDirectoryIndex
            ];
        uint sourcePage = sourceDirectoryEntry.pageIndex;
        uint sourceMetadata = sourceDirectoryEntry.emitterCountAndOffset;
        uint emitterCount = sourceMetadata & 0x1fffu;
        if(emitterCount == 0u)
        {
            continue;
        }

        uint emitterBucket = min(
            uint(rand(rngState) * float(emitterCount)),
            emitterCount - 1u
        );
        uint emitterAliasWord = vptEmitterAliasPagesBuffer.words[
            sourcePage * VPT_EMITTER_PAGE_WORDS +
            VPT_EMITTER_HEADER_WORDS + emitterBucket
        ];
        uint emitterIndex = rand(rngState) <=
            float(emitterAliasWord & 0xffffu) / 65535.0
            ? emitterBucket
            : min(emitterAliasWord >> 16u, emitterCount - 1u);
        uint packedEmitter = vptEmitterIndexPagesBuffer.words[
            sourcePage * VPT_EMITTER_PAGE_WORDS +
            VPT_EMITTER_HEADER_WORDS + emitterIndex
        ];
        uint emission = (packedEmitter >> 12u) & 15u;
        if(emission == 0u) continue;

        ivec3 sourceSection = proposalDirectorySection + ivec3(
            int((sourceMetadata >> 13u) & 7u) - 2,
            int((sourceMetadata >> 16u) & 7u) - 2,
            int((sourceMetadata >> 19u) & 7u) - 2
        );
        ivec3 emitterBlock = sourceSection * 16 + ivec3(
            int(packedEmitter & 15u),
            int((packedEmitter >> 4u) & 15u),
            int((packedEmitter >> 8u) & 15u)
        );

        vec3 emitterCenter = vec3(emitterBlock) + vec3(0.5);
        vec3 toLight = emitterCenter - hitPos;
        float distanceSquared = dot(toLight, toLight);
        if(distanceSquared <= 1.0e-6)
        {
            continue;
        }
        float distanceToLight = sqrt(distanceSquared);
        float emissionLevel = float(emission);
        // 2026-10-31：档案 id 扩到 5 bit，距离/亮度都按档案走 ⇒ 先取 id。
        uint typeCode = (packedEmitter >> 16u) & 31u;
        if(distanceToLight > vptLocalLightRange(typeCode, emissionLevel))
        {
            continue;
        }

        float receiverCosine = waterColumnReceiver
            ? 1.0
            : max(dot(N, toLight / distanceToLight), 0.0);
#if VPT_LOCAL_GEOMETRIC_COSINE_BOUND
        // 浮雕只能衰减：几何面本身背对这颗灯时直接判不可达，旧行为会在浮雕
        // 越过地平线的那些纹素上放行。
        receiverCosine = min(
            receiverCosine,
            max(dot(localGeometricN, toLight / distanceToLight), 0.0)
        );
#endif
        if(receiverCosine <= 0.0)
        {
            continue;
        }

        vec3 centreDirection = toLight / distanceToLight;
        vec3 referenceAxis = abs(centreDirection.y) < 0.95
            ? vec3(0.0, 1.0, 0.0)
            : vec3(1.0, 0.0, 0.0);
        vec3 tangent = normalize(cross(referenceAxis, centreDirection));
        vec3 bitangent = normalize(cross(centreDirection, tangent));

        vec2 sampleUv = vec2(rand(rngState), rand(rngState)) - vec2(0.5);
        vec3 emitterSample = emitterCenter +
            (tangent * sampleUv.x + bitangent * sampleUv.y) *
            VPT_LOCAL_LIGHT_AREA_SIZE;
        // 2026-09-30: 夹回发射体体素。下面的入面缩短与玻璃染色都建立在
        // 「采样点仍在这个发光方块内」这一前提上（sampledPointInsideEmitterVoxel
        // 就是它的判据）；斜向射线的切向基斜跨 XZ 时，面积/2 的偏移能越出方块
        // 约 0.2 格，夹回后该前提对所有方向都成立。夹回只收紧散布，scale 里没有
        // 面积因子，因此本地光能量不变。
        emitterSample = clamp(
            emitterSample,
            vec3(emitterBlock) + vec3(0.001),
            vec3(emitterBlock) + vec3(0.999)
        );
        vec3 sampledToLight = emitterSample - hitPos;
        float sampledDistance = length(sampledToLight);
        if(sampledDistance <= 1.0e-6) continue;
        vec3 lightDirection = sampledToLight / sampledDistance;
        float sampledCosine = max(dot(N, lightDirection), 0.0);
#if VPT_LOCAL_GEOMETRIC_COSINE_BOUND
        sampledCosine = min(
            sampledCosine,
            vptLocalFaceSetCosineBound(
                geometricFaceKnown,
                geometricFaceRecovered,
                hitPos,
                lightDirection
            )
        );
#endif
        if(sampledCosine <= 0.0) continue;
        float scale = 3.2 * LOCAL_LIGHT_ENERGY_SCALE * localLightIntensity() *
            localLightProfileBrightness(typeCode, emissionLevel) *
            vptLocalLightDistanceAttenuation(sampledDistance) *
            vptLocalLightRangeFade(sampledDistance, typeCode, emissionLevel);
        vec3 contribution = vliDecodeEmitterColor(typeCode) * scale * sampledCosine;
        // The section Alias table already includes power and distance; the
        // emitter Alias table uses exact emission power.  Keep the real PDF
        // explicit so RIS remains unbiased after hierarchical importance
        // sampling instead of retaining the old uniform reciprocal.
        float target = max(dot(contribution, vec3(0.2126, 0.7152, 0.0722)), 0.0);
        uint totalEmitterPower = vptEmitterIndexPagesBuffer.words[
            sourcePage * VPT_EMITTER_PAGE_WORDS + 2u
        ];
        float proposalPdf = max(
            // 混合提案的 pdf：w_D × p_D(x)（x 不在捐助者 D 目录里时 p_D = 0，
            // 与采样规则一致，RIS 保持无偏）。
            proposalDonorWeight *
            sourceDirectoryEntry.selectionProbability *
            (float(emission) / float(max(totalEmitterPower, 1u))),
            1.0e-8
        );
        float weight = target / proposalPdf;
        if(weight <= 0.0) continue;
        weightSum += weight;
        if(rand(rngState) * weightSum < weight)
        {
            selectedContribution = contribution;
            selectedSample = emitterSample;
            selectedBlock = emitterBlock;
            selectedEmission = emission;
            selectedTypeCode = typeCode;
        }
    }

    // =====================================================
    // 2026-10-26 RTXDI 式时域 reservoir（设置项：直接光模式 = 1）。
    //
    // 放在 weightSum <= 0 的早退**之前**：本帧提案全部落空时，上一帧的
    // reservoir 仍要参与合并（官方 RTXDI 也是先合并、后判可见性）。
    // =====================================================
    if(useTemporalReservoir && cam.sparseParams.x >= 0.5)
    {
        return evaluateVPTDirectLightReservoirTail(
            hitPos,
            N,
            hitAlbedo,
            waterColumnReceiver,
            geometricFaceKnown,
            geometricFaceRecovered,
            weightSum,
            selectedContribution,
            selectedSample,
            selectedEmission,
            selectedTypeCode,
            shadingActive,
            rngState
        );
    }
    if(weightSum <= 0.0)
    {
        return vec3(0.0);
    }

    // 2026-09-25: the visibility ray starts ON the ray, not along the shading
    // normal.  The normal-based 0.035 offset is what left thin bright lines
    // along block edges ("缝"): where the interpolated / quantised normal tilts
    // across a block edge, the origin lands past the surface it belongs to (or
    // inside the neighbouring block), so the blocker that should stop the ray
    // has its near face BEHIND the origin and is never tested.  The sun / AO
    // visibility rays have always used the safe form -- origin along the ray,
    // tmin 0.02 -- and rt_restir_final.rgen's notes already name the offset
    // DIRECTION, not its length, as the deciding factor.  N is still used for
    // the shading cosine below.
    vec3 neeRayDirection = normalize(selectedSample - hitPos);
    vec3 receiverOrigin = hitPos + neeRayDirection * 0.001;
    // Stop the transmission march just before it enters the emitter's own
    // voxel, so the emitter mesh cannot shadow its own emitted sample.  This
    // used to run vptLoadedPathToCandidateEmitter() and treat "path not
    // loaded" as "light invisible", which hard-zeroed the whole term beyond
    // ~64 blocks on a direction-dependent distance shell.  No occlusion test
    // remains on this path at all.
    // The shortening below exists for exactly ONE reason: stop the ray before
    // the emitter's own voxel so the emitter mesh cannot shadow its own sample.
    // That reason only holds while the sampled point lies INSIDE that voxel.
    // The virtual area emitter is 2x2 blocks wide, so a fringe sample can land
    // inside -- or beyond -- a wall that is adjacent to the emitter, and the
    // shortened ray then stops BEFORE that wall and never tests it.  That is
    // how local light reached across a wall (reported 2026-09-25, scaled with
    // "本地光最远照明距离" because a longer range lets more receivers sample the
    // same emitter).  Outside the emitter's own voxel the full distance is
    // used, so every blocker on the segment -- including the emitter's own
    // block -- is tested.
    bool sampledPointInsideEmitterVoxel =
        all(greaterThanEqual(selectedSample, vec3(selectedBlock))) &&
        all(lessThanEqual(
            selectedSample,
            vec3(selectedBlock) + vec3(1.0)
        ));
    float targetVoxelEntryDistance = vptEmitterVoxelEntryDistance(
        receiverOrigin, selectedSample, selectedBlock
    );
    if(!sampledPointInsideEmitterVoxel || targetVoxelEntryDistance < 0.0)
    {
        targetVoxelEntryDistance = distance(selectedSample, receiverOrigin);
    }

    // The visibility model below is the shared one: RT_PURPOSE_GLASS_VISIBILITY on
    // SBT record 0 / miss record 0, TerminateOnFirstHit + SkipClosestHitShader.
    // A blocker leaves payload.hitDistance at its +1.0 seed (rt_test.rmiss writes
    // -1.0 on an unblocked ray); crossed panes filter the ray through the
    // Any-Hit sheet model instead of stopping it.  Before 2026-09-25 this call
    // used vptTraceGlassTransmissionToEmitter(), a dye-only voxel march with NO
    // occlusion test at all, which let local light shine through walls.
    // 2026-10-07：方块光维持 0xff（含玩家自身代理）—— 只有移动光源那一路改 mask，
    // 见 DYNAMIC_LIGHT_CULL_MASK 的说明。
    vec3 transmittance = VPT_LOCAL_NEE_VISIBILITY_RAY
        ? traceVptLocalLightVisibility(
            receiverOrigin,
            selectedSample,
            targetVoxelEntryDistance,
            0xffu
        )
        : vptTraceGlassTransmissionToEmitter(
            receiverOrigin,
            selectedSample,
            targetVoxelEntryDistance
        );
    if(max(transmittance.r, max(transmittance.g, transmittance.b)) <= 0.0)
    {
        return vec3(0.0);
    }
#if VPT_LOCAL_CONSERVATIVE_VOXEL_OCCLUSION
    // 见 vptVoxelPathBlocked：补齐"硬件射线从两块相接的棱缝里滑过去"这条漏光路径
    // （用户报的"方块角落的亮线"正好沿棱出现）。
    if(vptVoxelPathBlocked(
        receiverOrigin,
        selectedSample,
        selectedBlock,
        targetVoxelEntryDistance
    ))
    {
        return vec3(0.0);
    }
#endif

    // Local emitters are the only light this path handles, so the coloured
    // transmission - and the exposure guard that keeps its hue from being
    // clipped to white - are applied here and nowhere else.
    float selectedWeight = max(dot(selectedContribution,
        vec3(0.2126, 0.7152, 0.0722)), 1.0e-6);
    return applyLocalGlassTint(
        selectedContribution * (weightSum /
            (float(vptRisProposalCount()) * selectedWeight)) *
            max(hitAlbedo, vec3(0.0)) * 0.92,
        transmittance
    );
}

// Distance budget for local direct lighting, measured from the camera in
// Minecraft blocks.  Since 2026-09-25 evaluateVPTRISDirectLightingSingle()
// spends exactly ONE hardware visibility ray per call (SER aside, the RIS
// candidate search itself is buffer reads only), so the keep probability below
// is literally the expected ray count per pixel as well.
//
// The budget is expressed as a *keep probability*: the fraction of pixels that
// run that search at all.  The expected cost per pixel scales with it, so the
// profile below is still the real cost.
//
//   0-56 blocks    (0-3.5 chunks): keep 1.00
//   56-72 blocks  : keep 1.00 -> 0.50
//   72-120 blocks : keep 0.50
//   120-136 blocks: keep 0.50 -> 0.25
//   136-152 blocks: keep 0.25
//   152-200 blocks: keep 0.25 -> 0.00
//   200+ blocks   : keep 0.00
//
// This used to be four *hard* bands on the camera-centred distance sphere: the
// visibility count (and therefore the noise level) stepped at 64 and 128
// blocks, and the whole term was clipped to zero at 160 blocks.  A hard
// mean-step on a camera-centred sphere is a hard edge in the image, and because
// the sphere follows the camera it crosses walls, ceilings and terrain
// identically -- which reads as an un-jittered light/dark boundary, i.e. a
// hacked-in hard shadow terminator, no matter what local-light model feeds it.
// Every band edge is now a smoothstep ramp of finite width, the ramp position
// is dithered per pixel so the transitions cannot line up into a contour, and
// the range extends smoothly to 200 blocks instead of clipping at 160.
//
// The plateau values are the previous band values, so the expected cost (and
// therefore the frame time) stays within a few percent of the hard-banded
// scheme: the only new work is the 160-200 block tail that used to be free
// because it was simply disabled.
const float VPT_LOCAL_KEEP_RAMP_BLOCKS = 16.0;
const float VPT_LOCAL_KEEP_TAIL_END_BLOCKS = 200.0;

float vptLocalLightKeepProbability(float cameraDistance)
{
    if(cameraDistance <= 56.0) return 1.0;
    if(cameraDistance <= 72.0)
    {
        return mix(1.0, 0.5,
            smoothstep(0.0, 1.0, (cameraDistance - 56.0) / VPT_LOCAL_KEEP_RAMP_BLOCKS));
    }
    if(cameraDistance <= 120.0) return 0.5;
    if(cameraDistance <= 136.0)
    {
        return mix(0.5, 0.25,
            smoothstep(0.0, 1.0, (cameraDistance - 120.0) / VPT_LOCAL_KEEP_RAMP_BLOCKS));
    }
    if(cameraDistance <= 152.0) return 0.25;
    if(cameraDistance <= VPT_LOCAL_KEEP_TAIL_END_BLOCKS)
    {
        return mix(0.25, 0.0,
            smoothstep(0.0, 1.0,
                (cameraDistance - 152.0) /
                (VPT_LOCAL_KEEP_TAIL_END_BLOCKS - 152.0)));
    }
    return 0.0;
}

// =====================================================
// 2026-10-07 动态光源（移动光源）采样端
// =====================================================
// 2026-10-07（用户反馈）：**移动光源对金属等 PBR 表面无反应**。
//
// 原因：这条链原来只做 Lambert —— dynamicLightContribution 返回
// `color * scale * max(dot(N,L),0)`，再由调用方乘 `hitAlbedo * 0.92`。而金属
// （LabPBR metallic ≈ 1）的 diffuse albedo 接近黑，于是"金属收不到这盏灯"。
//
// 修法：把返回项改成完整的材质 BRDF（漫反射 + Cook-Torrance 镜面），标定与数值全部
// 复用本文件**已有的方块光点光**那一套（LOCAL_LIGHT_L7_*，见其定义处），函数定义放在
// 那组标定旁边 —— 因为 fresnelSchlick / distributionGGX / geometrySmith 在那里都已
// 定义，而 GLSL 要求先声明后使用。这里只放原型（与 traceVptLocalLightVisibility 同一
// 写法）。材质由各调用点解码后传入：拿不到材质的路径传 f0 = vec3(-1.0) ⇒ 逐位退回
// 纯 Lambert（kD 恒 0.92，与改动前完全等价）。
// =====================================================

vec3 dynamicLightBRDF(
    vec3 N,
    vec3 V,
    vec3 L,
    vec3 albedo,
    vec3 f0,
    float metallic,
    float roughness
);
// 为什么长这样：
//   · **独立光源集 + 均匀提案**：动态光源与方块发射体是不相交的两个集合，所以自己
//     跑一次均匀提案 RIS（pdf = 1/条数，不需要 alias 表）就已经无偏，最后与体素那套
//     结果**相加** —— 两个各自无偏的估计器相加仍无偏，也不可能与 VLI 双重计数。
//     反过来若把动态光塞进下面那个分层 alias 提案里，就要改 proposalPdf 的混合结构，
//     风险高得多，收益只是省几条提案。
//   · **接在包装层**（evaluateVPTRISDirectLighting）而不是各调用点 ⇒ 主路径、GI 顶点、
//     玻璃透射全部自动覆盖，帧一致性不用另外维护（半帧有半帧没有会撕裂时域滤波）。
//   · 能量/距离衰减/范围淡出/颜色全部复用方块光那套函数 ⇒ 观感同源，不引入第二套标定。
//   · 遮挡复用共享可见性模型（含染色玻璃透射与任意命中面片过滤）。
// =====================================================

// 强度旋钮：主机写 intensity + 1.0，这里减 1 还原（与 localLightIntensity() 同一约定：
// 0.0 = 从没下发过 ⇒ 退回 1.0；用户真拖到 0 时是 1.0 ⇒ 解出 0）。
float dynamicLightIntensity()
{
    float user = uintBitsToFloat(dynamicLights.header.y) - 1.0;
    return (user >= 0.0 && user <= 16.0) ? user : 1.0;
}

// 可见性射线在到达光心前的收短量（格）。
//
// 为什么必须收短：光心就在**发光体自己身上**（手持物约在胸前、实体在包围盒中心），
// 而实体在动态 BLAS 里、参与遮挡测试 ⇒ 不收短的话射线必然先撞到发光体自身表面，
// 表现为"光源被自己挡住、几乎照不亮任何东西"（烈焰人最典型：光心在身体内部）。
// 0.6 格覆盖常见实体半径，并让手持光停在手的位置。
// 代价：紧贴光心 0.6 格以内的薄墙（玻璃板一类）会漏光 —— v1 接受，别把光源放在贴墙处。
const float DYNAMIC_LIGHT_VISIBILITY_SHORTEN = 0.6;

// 移动光源可见性射线的 cull mask（2026-10-07，用户要求"无视玩家自身实体"）。
//
// 0xfd = "除本地玩家自身代理之外的一切"。Vulkan 的判定是
// (rayMask & instanceMask) != 0，而 VulkanCore 给两类玩家几何的 instance.mask 是：
//   · 第一人称本地玩家代理（玩家模型 + 手持物）：0x02
//     （VulkanCore 的 SECTION_AS_CLASS_LOCAL_PLAYER 分支）—— 主相机射线用 0x01
//     正是为了看不见它；
//   · 普通实体（含第三人称下的玩家本体）：0xff。
// 这条射线原来与方块光共用 0xff ⇒ 手里那盏灯会被**自己**挡住：射线从光心出发，
// 第一段就撞在自己模型/手持物上，表现为"光源几乎照不亮任何东西"。
// 清掉 0x02 后自己的代理不再遮挡，而其他实体（0xff）照常遮挡 —— 正是用户要的语义。
//
// 注意第三人称：玩家本体那时走普通实体路（0xff），当前与别的实体无法区分，所以仍会挡光。
// 要让那时也放行，需要给"本地玩家实体"单独一个 mask 位（native 按实体打标），留待需要时。
//
// 回退：改成 0xffu 即逐位回到改动前（包含"自己的模型挡自己的光"）。
const uint DYNAMIC_LIGHT_CULL_MASK = 0xfdu;

// 颜色：优先用记录里带的**任意 RGB**（meta.y 的 8/8/8）；为 0 时回退到既有调色板
// （vliDecodeEmitterColor）—— 于是"只给 typeCode"的记录仍然有效，两条路在火把上的
// 取值也刻意取成一致（见 Java 侧 heldLightColor）。
// 想要任意颜色的理由：调色板只有 5 档，而实体的"发光色"彼此差别很大（荧光鱿鱼青、
// 末影水晶品红、经验/烟花偏黄白），挤进 5 档会丢掉辨识度。
vec3 dynamicLightColor(uint typeCode, uint packedRgb)
{
    if(packedRgb != 0u)
    {
        return vec3(
            float((packedRgb >> 16u) & 255u),
            float((packedRgb >> 8u) & 255u),
            float(packedRgb & 255u)
        ) * (1.0 / 255.0);
    }
    return vliDecodeEmitterColor(typeCode);
}

vec3 dynamicLightContribution(
    vec3 hitPos,
    vec3 N,
    vec3 V,
    vec3 albedo,
    vec3 f0,
    float metallic,
    float roughness,
    float emissionLevel,
    uint typeCode,
    uint packedRgb,
    vec3 lightPosition
)
{
    vec3 toLight = lightPosition - hitPos;
    float distanceSquared = dot(toLight, toLight);
    if(distanceSquared <= 1.0e-6)
    {
        return vec3(0.0);
    }
    float distanceToLight = sqrt(distanceSquared);
    if(distanceToLight > vptLocalLightRange(typeCode, emissionLevel))
    {
        return vec3(0.0);
    }
    vec3 lightDirection = toLight / distanceToLight;
    float receiverCosine = max(dot(N, lightDirection), 0.0);
    if(receiverCosine <= 0.0)
    {
        return vec3(0.0);
    }
    // 与 evaluateVPTRISDirectLightingSingle 的 scale **逐项同构**，只多乘一个动态光源
    // 自己的强度旋钮。2026-10-31 起亮度/距离也走档案表（动态光源 id 一般是 0，
    // 即"未分类"，退回旧口径）。
    float scale = 3.2 * LOCAL_LIGHT_ENERGY_SCALE * localLightIntensity() *
        dynamicLightIntensity() *
        localLightProfileBrightness(typeCode, emissionLevel) *
        vptLocalLightDistanceAttenuation(distanceToLight) *
        vptLocalLightRangeFade(distanceToLight, typeCode, emissionLevel);
    // 2026-10-17 修复「移动光源把周围糊成一层平色」：调用方早已不再乘 albedo / 0.92
    //（见 evaluateDynamicLightRISDirect 末尾），但这里一直只返回 `color * scale * N·L`
    // ⇒ albedo 与镜面项被整个丢掉，灯把纯色直接糊在任何表面上（暗方块也被染满）。
    // 现在接入 dynamicLightBRDF：f0.x<0（无材质）分支逐位等价于旧的 albedo*0.92*N·L，
    // 有材质时补回漫反射 kD 与 Cook-Torrance 镜面。
    vec3 brdf = dynamicLightBRDF(
        N, V, lightDirection, albedo, f0, metallic, roughness);
    return dynamicLightColor(typeCode, packedRgb) * scale * brdf;
}

vec3 evaluateDynamicLightRISDirect(
    vec3 hitPos,
    vec3 hitNormal,
    vec3 hitAlbedo,
    float receiverCameraDistance,
    vec3 f0,
    float metallic,
    float roughness,
    inout uint rngState
)
{
    // 视图方向由本函数自己取（相机位置在包装层也是一次 mat4 乘，这里再来一次更清晰）：
    // 镜面项要用它，而它只依赖 hitPos 与相机。
    vec3 dynamicLightCameraPosition =
        (cam.viewInverse * vec4(0.0, 0.0, 0.0, 1.0)).xyz;
    vec3 viewDirection = normalize(dynamicLightCameraPosition - hitPos);

    uint lightCount = min(dynamicLights.header.x, 128u);
    if(lightCount == 0u)
    {
        return vec3(0.0);
    }

    // 相机距离门（纯省成本，**不改变 80 格以内的任何像素**）：
    // 动态光源全部在玩家（≈相机）48 格内采集（Java 侧 MAX_DISTANCE），而单条光源的
    // 最远照明由 vptLocalLightRange 决定（上限 30 格）⇒ 接收点离相机超过 48+30 时，
    // 任何一条动态光源都不可能贡献能量。
    // 没有这道门的话，全屏每个像素都要跑 1~4 次提案读取 + 距离衰减计算才轮到下面
    // 逐光源的 range 判定把它丢掉。
    // 80 = 48 + 30 + 2 余量（第三人称下相机离玩家最多几格，已含在余量里）。
    const float DYNAMIC_LIGHT_RECEIVER_GATE = 80.0;
    if(receiverCameraDistance > DYNAMIC_LIGHT_RECEIVER_GATE)
    {
        return vec3(0.0);
    }

    vec3 N = normalize(hitNormal);
    // 提案数取「局部光 RIS 候选」同一档（vptRisProposalCount，死 lane ⇒ 16），
    // 但上限压到 4：动态光源通常只有个位数条，再多提案边际收益很低，
    // 而每条被接受的候选要付一条可见性射线。
    uint proposals = min(vptRisProposalCount(), 4u);
    vec3 selectedContribution = vec3(0.0);
    vec3 selectedPosition = vec3(0.0);
    float weightSum = 0.0;

    for(uint proposalIndex = 0u; proposalIndex < proposals; ++proposalIndex)
    {
        uint lightIndex = min(
            uint(rand(rngState) * float(lightCount)),
            lightCount - 1u
        );
        DynamicLightRecord light = dynamicLights.lights[lightIndex];
        float emissionLevel = light.worldPosEmission.w;
        if(emissionLevel <= 0.0)
        {
            continue;   // 空槽 / 已离开范围
        }
        vec3 contribution = dynamicLightContribution(
            hitPos, N, viewDirection, hitAlbedo, f0, metallic, roughness,
            emissionLevel, light.meta.x, light.meta.y,
            light.worldPosEmission.xyz);
        float target = max(dot(contribution, vec3(0.2126, 0.7152, 0.0722)), 0.0);
        if(target <= 0.0)
        {
            continue;
        }
        // 均匀提案 ⇒ pdf = 1/lightCount ⇒ 权重 = target * lightCount。
        float weight = target * float(lightCount);
        weightSum += weight;
        if(rand(rngState) * weightSum < weight)
        {
            selectedContribution = contribution;
            selectedPosition = light.worldPosEmission.xyz;
        }
    }

    if(weightSum <= 0.0)
    {
        return vec3(0.0);
    }

    // 一条可见性射线（带遮挡）。起点与方块光同款：沿射线方向偏置，而不是沿法线
    //（沿法线的 0.035 偏置正是"方块边缘亮缝"的成因，见 Single 里那段复盘）。
    vec3 neeRayDirection = normalize(selectedPosition - hitPos);
    vec3 receiverOrigin = hitPos + neeRayDirection * 0.001;
    float targetDistance = max(
        distance(selectedPosition, receiverOrigin) - DYNAMIC_LIGHT_VISIBILITY_SHORTEN,
        0.05
    );
    vec3 transmittance = VPT_LOCAL_NEE_VISIBILITY_RAY
        ? traceVptLocalLightVisibility(
            receiverOrigin,
            selectedPosition,
            targetDistance,
            DYNAMIC_LIGHT_CULL_MASK)
        : vptTraceGlassTransmissionToEmitter(
            receiverOrigin,
            selectedPosition,
            targetDistance);
    if(max(transmittance.r, max(transmittance.g, transmittance.b)) <= 0.0)
    {
        return vec3(0.0);
    }

    float selectedWeight = max(dot(selectedContribution,
        vec3(0.2126, 0.7152, 0.0722)), 1.0e-6);
    // 2026-10-07：这里不再乘 albedo / 0.92 —— 它们已经并进 dynamicLightBRDF
    //（无材质路径的 0.92 就是同一个 BSDF_LOCAL_DIFFUSE_SCALE，所以逐位等价）。
    return applyLocalGlassTint(
        selectedContribution * (weightSum /
            (float(proposals) * selectedWeight)),
        transmittance
    );
}

// 2026-10-07：多了 f0 / metallic / roughness 三个材质入参 —— 移动光源的镜面项要用。
// 调用点拿不到材质时传 f0 = vec3(-1.0)（见 4 参重载），动态光源于是退回纯 Lambert，
// 与改动前逐位相同；方块光那条链完全不受影响。
vec3 evaluateVPTRISDirectLighting(
    vec3 hitPos,
    vec3 hitNormal,
    vec3 hitAlbedo,
    vec3 geometricFaceNormal,
    vec3 f0,
    float metallic,
    float roughness,
    inout uint rngState
)
{
    vec3 cameraPosition =
        (cam.viewInverse * vec4(0.0, 0.0, 0.0, 1.0)).xyz;
    float receiverCameraDistance = length(hitPos - cameraPosition);

    // 2026-10-03（用户要求）：**撤掉 keep probability 距离预算**。这套按距离分档
    // + 按像素随机丢弃 + 补权的机制（前身是 64/128/160 的硬距离球带，注释里自己
    // 承认在墙/天花板上表现为"un-jittered light/dark boundary"）就是用户看到的
    // 明暗分界线与"prob"观感的来源。现在本地光恢复为每像素必算、不丢弃、不加权
    // —— 与旧版 Orion 的行为一致。代价：>56 格的像素也要跑候选搜索 + 1 条可视
    // 性射线；如果帧时间不可接受，再谈别的限距方案（不用概率）。
    vec3 voxelDirect = evaluateVPTRISDirectLightingSingle(
        hitPos, hitNormal, hitAlbedo, geometricFaceNormal, false, true, rngState);

    // 2026-10-07 动态光源（移动光源）：**相加**，不并进上面那次 RIS —— 理由见函数上方
    // 那段说明。条数为 0 时这里立刻返回 0，整条链逐位回到改动前。
    return voxelDirect + evaluateDynamicLightRISDirect(
        hitPos, hitNormal, hitAlbedo, receiverCameraDistance,
        f0, metallic, roughness, rngState);
}

// 2026-10-26：主表面直射的运行时入口（唯一允许 RTXDI WRS 的调用点）。
// GI 顶点 NEE / 透明接收路径仍走上面的 evaluateVPTRISDirectLighting。
vec3 evaluateVPTRISDirectLightingPrimary(
    vec3 hitPos,
    vec3 hitNormal,
    vec3 hitAlbedo,
    vec3 geometricFaceNormal,
    vec3 f0,
    float metallic,
    float roughness,
    bool temporalReservoir,
    bool shadingActive,
    inout uint rngState
)
{
    vec3 cameraPosition =
        (cam.viewInverse * vec4(0.0, 0.0, 0.0, 1.0)).xyz;
    float receiverCameraDistance = length(hitPos - cameraPosition);

    vec3 voxelDirect = evaluateVPTRISDirectLightingSingle(
        hitPos, hitNormal, hitAlbedo, geometricFaceNormal,
        temporalReservoir, shadingActive, rngState);

    // 2026-10-26 稀疏渲染：动态光源没有可老化的 reservoir，非活跃像素
    // 直接跳过（与本地光的 enableRtxdiReuseForInactivePixels 语义对齐 ——
    // 那条复用只对灯表 reservoir 成立）。
    if(!shadingActive)
    {
        return voxelDirect;
    }

    return voxelDirect + evaluateDynamicLightRISDirect(
        hitPos, hitNormal, hitAlbedo, receiverCameraDistance,
        f0, metallic, roughness, rngState);
}

// 4 参重载：调用方拿不到 POM 之前的几何面法线（透明接收路径、GI 顶点等），
// 传 vec3(0) 让 Single 回退到旧的浮雕量化，行为与本次修改前一致。
vec3 evaluateVPTRISDirectLighting(
    vec3 hitPos,
    vec3 hitNormal,
    vec3 hitAlbedo,
    inout uint rngState
)
{
    // f0 = vec3(-1.0)：未知材质 ⇒ 移动光源退回纯 Lambert（与本次改动前逐位相同）。
    return evaluateVPTRISDirectLighting(
        hitPos, hitNormal, hitAlbedo, vec3(0.0), vec3(-1.0), -1.0, 1.0, rngState);
}

// =====================================================
// 2026-10-24 透明接收面的多样本直射估计（修"静止时彩色玻璃上积累的噪点"）
//
// 透过玻璃/水看到的接收面写不进主 G-buffer ⇒ DLSS-RR 拿不到它的表面历史；
// 它唯一的时域平均是 evaluateVPTCandidateDirectTemporal 的世界空间历史。
// 而那份历史每帧只喂入 **1 个** RIS 样本（1 次发射体选择 + 1 条可见性射线），
// 历史封顶后残余方差仍有 1/sqrt(N_history) ≈ 14% 的 1spp 量级 —— 隔着染色
// 玻璃看就是一层持续闪烁的彩色颗粒。09-30 用户实测"采样数/候选数怎么调都
// 还在"指的是设置面板旋钮（太阳阴影采样 / RIS 提案数），它们不改变这条
// 路径**每帧只有 1 个独立样本**的结构。
//
// 这里给这条路径（且只有这条路径）把每帧样本数提高到 N：方差 ÷ sqrt(N)，
// 与历史长度相乘。rngState 由 inout 链式推进 ⇒ N 个样本相互独立。
// 动态（移动）光源保持单样本 —— 它必须逐帧响应，不该被平均拖慢。
// 调用点：evaluateVPTCandidateDirectTemporal（透明/水下接收面，唯一消费者）。
// A/B：-DVPT_TRANSPARENT_RECEIVER_RIS_SAMPLES=1 回到单样本。
// =====================================================
#ifndef VPT_TRANSPARENT_RECEIVER_RIS_SAMPLES
#define VPT_TRANSPARENT_RECEIVER_RIS_SAMPLES 4
#endif

vec3 evaluateVPTRISDirectLightingMultiSample(
    vec3 hitPos,
    vec3 hitNormal,
    vec3 hitAlbedo,
    vec3 geometricFaceNormal,
    inout uint rngState
)
{
    vec3 cameraPosition =
        (cam.viewInverse * vec4(0.0, 0.0, 0.0, 1.0)).xyz;
    float receiverCameraDistance = length(hitPos - cameraPosition);

    vec3 voxelDirect = vec3(0.0);
    for(int sampleIndex = 0;
        sampleIndex < VPT_TRANSPARENT_RECEIVER_RIS_SAMPLES;
        ++sampleIndex)
    {
        voxelDirect += evaluateVPTRISDirectLightingSingle(
            hitPos, hitNormal, hitAlbedo, geometricFaceNormal, false, true, rngState);
    }
    voxelDirect *= 1.0 / float(VPT_TRANSPARENT_RECEIVER_RIS_SAMPLES);

    return voxelDirect + evaluateDynamicLightRISDirect(
        hitPos, hitNormal, hitAlbedo, receiverCameraDistance,
        vec3(-1.0), -1.0, 1.0, rngState);
}

// VPT-3.4A: cosine-sample one true voxel surface, then read that surface's
// event-driven local direct irradiance from Binding 30.  This never samples
// Binding 24 air probes and a missing Section terminates the ray as opaque.
// 2026-11-03 拐角光斑修正的接触尺寸（格）。0.5 = 1x1 格面片的等效半径
// （A=1 ⇒ 等面积圆半径 0.564，取半格 0.5 与之同量级）。调小 ⇒ 修正更弱；
// 设 0 ⇒ 完全回到旧行为（斑会回来）。
#ifndef VPT_LOCAL_BOUNCE_CONTACT_SIZE
#define VPT_LOCAL_BOUNCE_CONTACT_SIZE 0.5
#endif

vec3 evaluateVPTLocalSecondaryBounce(
    vec3 hitPos,
    vec3 hitNormal,
    vec3 hitAlbedo,
    inout uint rngState
)
{
    // 2026-10-13 stage 16：剥离臂把本地光二级弹射整项归零（见 perfL10DisableVoxelDda）。
    if(perfL10DisableVoxelDda())
    {
        return vec3(0.0);
    }

    vec3 N = normalize(hitNormal);
    vec3 direction = sampleHemisphereCosine(N, rngState);
    int maxTraversal = min(
        48,
        int(ceil(VPT_LOCAL_BOUNCE_MAX_DISTANCE *
            dot(abs(direction), vec3(1.0)))) + 2
    );
    vec3 origin = hitPos + N * 0.035;
    ivec3 cell = ivec3(floor(origin));
    ivec3 step = ivec3(sign(direction));
    vec3 invAbs = 1.0 / max(abs(direction), vec3(1.0e-6));
    vec3 boundary = vec3(cell) + vec3(max(step, ivec3(0)));
    vec3 tMax = (boundary - origin) / direction;
    if(step.x == 0) tMax.x = 1.0e30;
    if(step.y == 0) tMax.y = 1.0e30;
    if(step.z == 0) tMax.z = 1.0e30;
    // Stained glass between the receiver and the sampled radiance must tint
    // the bounce exactly like the rt_vpt_irradiance.comp bake does.  Without
    // this the DDA treated every pane as air and torch light behind coloured
    // glass reached the receiver as raw white emitter colour.
    vec3 glassTransmission = vec3(1.0);

    // VPT-P3（2026-09-29）：起点嵌入检测（拐角光斑修复 A）。
    // 法线贴图/插值法线在拐角处会把起点 hitPos + N*0.035 压进相邻的完全
    // 遮挡方块；下面的循环是"先步进后测试"，嵌入的起点不会被自己所在的
    // 方块挡住，而是穿过它读到墙另一侧的烘焙辐照度 —— 表现为拐角处的
    // 透墙亮斑。嵌入即视为无弹射（保守且正确：嵌入的接收点本就看不见
    // 任何弹射面）。彩玻/未知 section 不算嵌入，与循环内的走行策略一致。
    {
        uint startSource;
        if(vptReadSourceVoxel(cell, startSource) && (startSource & 3u) == 1u)
        {
            return vec3(0.0);
        }
    }

    // 2026-10-13：增量游标（见 vptMakeCursor / vptCursorStep 的说明）。起点一次性
    // 算好 section/local，之后每步只做加减 —— 循环里再不做整数除法。
    VptVoxelCursor vptCursor = vptMakeCursor(cell);

    for(int traversal = 0; traversal < maxTraversal; ++traversal)
    {
        int axis = tMax.x < tMax.y
            ? (tMax.x < tMax.z ? 0 : 2)
            : (tMax.y < tMax.z ? 1 : 2);
        float travel = axis == 0 ? tMax.x : (axis == 1 ? tMax.y : tMax.z);
        if(travel > VPT_LOCAL_BOUNCE_MAX_DISTANCE) return vec3(0.0);

        vec3 faceNormal;
        if(axis == 0)
        {
            cell.x += step.x;
            vptCursorStep(vptCursor, 0, step.x);
            tMax.x += invAbs.x;
            faceNormal = vec3(-step.x, 0.0, 0.0);
        }
        else if(axis == 1)
        {
            cell.y += step.y;
            vptCursorStep(vptCursor, 1, step.y);
            tMax.y += invAbs.y;
            faceNormal = vec3(0.0, -step.y, 0.0);
        }
        else
        {
            cell.z += step.z;
            vptCursorStep(vptCursor, 2, step.z);
            tMax.z += invAbs.z;
            faceNormal = vec3(0.0, 0.0, -step.z);
        }

        uint source;
        // A Section that is absent from the VPT page table is *unknown*, not
        // black.  Returning zero here extinguished the whole local-light
        // secondary term the moment the bounce ray left the loaded page set,
        // which drew a straight, completely noise-free light/dark seam along the
        // 16-block Section grid -- the same failure mode already removed from the
        // direct local-light paths.  An unknown Section is skipped like air, so a
        // missing table entry can never change lighting.
        if(!vptReadSourceVoxelAt(vptCursor, source)) continue;
        // Same voxel classification as the comp's transmissionToEmitter: a
        // stained pane multiplies the RGB filter and stays transparent; the
        // 1/31 floor stops a quantized RGB555 zero becoming a hard shadow.
        if((source & VPT_STAINED_GLASS_BIT) != 0u)
        {
            glassTransmission *=
                max(glassDecodeVoxelAlbedo(source), vec3(1.0 / 31.0));
        }
        uint voxelClass = source & 3u;
        if(voxelClass == 3u)
        {
            // Slab / stairs / wall / fence: attenuate by the free fraction of
            // the cell and keep marching, exactly like the comp's
            // transmissionToEmitter.  Treating it as a blocker here would make
            // the fence stop the bounce outright, which is the "handled as a
            // full block" behaviour this class exists to remove.
            glassTransmission *=
                max(vec3(vptPartialTransmission(source)), vec3(1.0 / 31.0));
            continue;
        }
        if(voxelClass != 1u) continue;

        vec3 bounceAlbedo = glassDecodeVoxelAlbedo(source);
        if(max(bounceAlbedo.r, max(bounceAlbedo.g, bounceAlbedo.b)) <= 0.0)
        {
            continue;
        }

        ivec3 sectionCoord = ivec3(
            vliFloorDiv(cell.x, 16), vliFloorDiv(cell.y, 16),
            vliFloorDiv(cell.z, 16)
        );
        uint pageIndex;
        if(!vliLookupSectionPage(sectionCoord, pageIndex)) continue;
        ivec3 local = ivec3(
            vliPositiveMod(cell.x, 16), vliPositiveMod(cell.y, 16),
            vliPositiveMod(cell.z, 16)
        );
        uint voxelIndex = uint(local.x) + 16u *
            (uint(local.z) + 16u * uint(local.y));
        uint packedDirect = vptSurfaceFaceBuffer.words[
            pageIndex * VPT_SURFACE_FACE_WORDS +
            voxelIndex * VPT_DIRECTION_COUNT +
            vptFaceIndexFromBlockFaceNormal(faceNormal)
        ];
        vec3 outgoingRadiance = vliUnpackRadiance(packedDirect) *
            bounceAlbedo * (1.0 / 3.14159265359);
        // Attenuate by the distance the bounce travelled to reach this voxel.
        // This is the only local-light path that skipped the distance term, which
        // is exactly why a concave corner -- where the cosine hemisphere reaches
        // the neighbouring torch-lit wall after about one block -- was the
        // brightest place in the room. The range fade is deliberately not applied
        // here: the baked value carries no emitter identity, so its emission
        // level, and therefore its range, is unknown.
        // ================================================================
        // 2026-11-03 拐角光斑（自古以来的老问题，本次收口）
        //
        // 机理：这条链是"余弦半球 1 条射线 → 撞到哪个体素面就读那个面的
        // 烘焙辐照度"。在凹角处射线几乎必然在 0.1~0.5 格内撞到**刚被照亮的
        // 邻墙**，而这份贡献原来按面片整份计入：
        //     vptLocalLightDistanceAttenuation(0.1) ≈ 0.55（= 该函数的上限）
        //     vptLocalLightRangeFade 又按注释被**故意跳过**
        // ⇒ 等于把邻墙的直射光 ×albedo×0.92 全额搬过来；而离墙角 1.5 格外
        // 射线基本打空、贡献归零。两者的落差 = 那个软斑（2026-09-24 的分屏
        // 判决实验也是这个结论，见文件头 DBG_SPLIT_ABLATION 的注释）。
        //
        // 修法：1×1 格的面片在 d 处的立体角 ∝ 1/(1+(0.5/d)²)。补上这个因子，
        // 贴面（d→0）趋于 0，d≈1.5 格以上 ≈0.9（中远距观感基本不动）。
        // 0.25 = 面片半格尺寸的平方（A=1 格² 的等效半径 0.5）。
        // 回退：把 VPT_LOCAL_BOUNCE_CONTACT_SIZE 调小（0 = 完全关闭本修正）。
        // ================================================================
        float patchSolidAngle = 1.0;
        {
            float patchHalfSize = VPT_LOCAL_BOUNCE_CONTACT_SIZE;
            float patchHalfSizeSq = patchHalfSize * patchHalfSize;
            patchSolidAngle = (travel * travel) /
                max(travel * travel + patchHalfSizeSq, 1.0e-6);
        }

        vec3 secondaryTerm = outgoingRadiance * max(hitAlbedo, vec3(0.0)) *
            0.92 * vptLocalLightDistanceAttenuation(travel) *
            patchSolidAngle *
            vptSaturateGlassTransmission(glassTransmission);

        // 诊断（G 通道）：本地光二级弹射项的能量。
        if(DBG_LOCAL_TERM_MAP)
        {
            return vec3(0.0, dbgTermLuma(secondaryTerm), 0.0);
        }
        if(DBG_GLASS_DYE_VS_ENERGY_SECONDARY)
        {
            // R = 到达接收面的染料浓度（纯色⇒亮，白⇒暗）
            // G = 该项能量
            return vec3(
                dbgDyeConcentration(vptSaturateGlassTransmission(glassTransmission)),
                dbgTermLuma(secondaryTerm),
                0.0
            );
        }
        if(DBG_GLASS_PEAK_READOUT)
        {
            // 比值型读数：R = 染料纯度，G = 弱通道占比。
            // 读的是到达接收面的染色透射率本身（含 saturate），
            // 与该项能量无关，因此不受末端裁剪影响。
            return dbgHuePurity2(vptSaturateGlassTransmission(glassTransmission));
        }
        return toneKeepHueLocal(secondaryTerm);
    }
    return vec3(0.0);
}

// Fixed-cost voxel DDA.  Missing pages terminate the ray: treating an
// unloaded Section as air would leak light across the loaded-world boundary.
vec3 traceVPTEmitterDDA(vec3 origin, vec3 direction, out vec3 blockerAlbedo,
                         out vec3 blockerPos, out vec3 blockerNormal)
{
    ivec3 cell = ivec3(floor(origin));
    ivec3 step = ivec3(sign(direction));
    vec3 invAbs = 1.0 / max(abs(direction), vec3(1.0e-6));
    vec3 boundary = vec3(cell) + vec3(max(step, ivec3(0)));
    vec3 tMax = (boundary - origin) / direction;
    if(step.x == 0) tMax.x = 1.0e30;
    if(step.y == 0) tMax.y = 1.0e30;
    if(step.z == 0) tMax.z = 1.0e30;
    blockerAlbedo = vec3(0.0);
    blockerPos = origin;
    blockerNormal = vec3(0.0);
    // Stained panes crossed on the way to an emitter tint its light exactly
    // like the bake filter; without this the DDA read panes as air and torch
    // light behind coloured glass stayed raw white.
    vec3 glassTransmission = vec3(1.0);

    // 2026-10-13：增量游标（见 vptMakeCursor / vptCursorStep 的说明）。
    VptVoxelCursor vptCursor = vptMakeCursor(cell);

    for(int i = 0; i < 64; ++i)
    {
        int axis = tMax.x < tMax.y ? (tMax.x < tMax.z ? 0 : 2)
                                    : (tMax.y < tMax.z ? 1 : 2);
        float t = axis == 0 ? tMax.x : (axis == 1 ? tMax.y : tMax.z);
        if(t > 30.0) break;
        if(axis == 0) { cell.x += step.x; vptCursorStep(vptCursor,0,step.x); tMax.x += invAbs.x; blockerNormal=vec3(-step.x,0,0); }
        else if(axis == 1) { cell.y += step.y; vptCursorStep(vptCursor,1,step.y); tMax.y += invAbs.y; blockerNormal=vec3(0,-step.y,0); }
        else { cell.z += step.z; vptCursorStep(vptCursor,2,step.z); tMax.z += invAbs.z; blockerNormal=vec3(0,0,-step.z); }

        uint source;
        if(!vptReadSourceVoxelAt(vptCursor, source)) break;
        if((source & VPT_STAINED_GLASS_BIT) != 0u)
        {
            glassTransmission *=
                max(glassDecodeVoxelAlbedo(source), vec3(1.0 / 31.0));
        }
        uint emission = (source >> 2u) & 15u;
        if(emission > 0u)
        {
            return vliDecodeEmitterColor((source >> 6u) & 31u) *
                localLightProfileBrightness(
                    (source >> 6u) & 31u, float(emission)) * 3.2 *
                LOCAL_LIGHT_ENERGY_SCALE * localLightIntensity() *
                vptSaturateGlassTransmission(glassTransmission);
        }
        uint voxelClass = source & 3u;
        if(voxelClass == 3u)
        {
            // Slab / stairs / wall / fence: a partly occupied cell only dims the
            // emitter light, it does not extinguish it.  Same model as
            // transmissionToEmitter in rt_vpt_irradiance.comp.
            glassTransmission *=
                max(vec3(vptPartialTransmission(source)), vec3(1.0 / 31.0));
            continue;
        }
        if(voxelClass == 1u)
        {
            blockerAlbedo = glassDecodeVoxelAlbedo(source);
            blockerPos = origin + direction * t;
            return vec3(0.0);
        }
    }
    return vec3(0.0);
}

// 2026-11-01 stage 34 探针：GI 射线专用的固定成本体素 DDA。步进结构与
// traceVPTEmitterDDA 完全同型（64 步上限、30 格距离上限、未加载 Section =
// 打空），这样量出来的成本就是真实方案要付的那一份。命中 = 第一个满方块
// （class 1）；染色玻璃与部分遮挡格穿过（近似）。t 取的是进入该格的边界
// 交点距离，对面轴对齐的方块网格这就是精确命中距离。
bool traceVoxelGiProbeDDA(vec3 origin, vec3 direction, out float hitT,
                          out vec3 hitNormal)
{
    ivec3 cell = ivec3(floor(origin));
    ivec3 step = ivec3(sign(direction));
    vec3 invAbs = 1.0 / max(abs(direction), vec3(1.0e-6));
    vec3 boundary = vec3(cell) + vec3(max(step, ivec3(0)));
    vec3 tMax = (boundary - origin) / direction;
    if(step.x == 0) tMax.x = 1.0e30;
    if(step.y == 0) tMax.y = 1.0e30;
    if(step.z == 0) tMax.z = 1.0e30;
    hitT = 0.0;
    hitNormal = vec3(0.0);

    VptVoxelCursor vptCursor = vptMakeCursor(cell);
    for(int i = 0; i < 64; ++i)
    {
        int axis = tMax.x < tMax.y ? (tMax.x < tMax.z ? 0 : 2)
                                    : (tMax.y < tMax.z ? 1 : 2);
        float t = axis == 0 ? tMax.x : (axis == 1 ? tMax.y : tMax.z);
        if(t > 30.0) return false;
        if(axis == 0) { cell.x += step.x; vptCursorStep(vptCursor,0,step.x); tMax.x += invAbs.x; hitNormal=vec3(-step.x,0,0); }
        else if(axis == 1) { cell.y += step.y; vptCursorStep(vptCursor,1,step.y); tMax.y += invAbs.y; hitNormal=vec3(0,-step.y,0); }
        else { cell.z += step.z; vptCursorStep(vptCursor,2,step.z); tMax.z += invAbs.z; hitNormal=vec3(0,0,-step.z); }

        uint source;
        if(!vptReadSourceVoxelAt(vptCursor, source)) return false;
        if((source & VPT_STAINED_GLASS_BIT) != 0u) continue;
        uint voxelClass = source & 3u;
        if(voxelClass == 3u) continue;
        if(voxelClass == 1u)
        {
            hitT = t;
            return true;
        }
    }
    return false;
}

vec3 evaluateVPTPrimaryIndirect(vec3 hitPos, vec3 hitNormal, vec3 hitAlbedo,
                                vec3 direction, inout uint rngState)
{
    vec3 blockerAlbedo, blockerPos, blockerNormal;
    vec3 first = traceVPTEmitterDDA(hitPos + hitNormal * 0.02, direction,
        blockerAlbedo, blockerPos, blockerNormal);
    if(max(first.r, max(first.g, first.b)) > 0.0)
        return hitAlbedo * first;

    // The second DDA exists only after a real non-emissive voxel hit.  It is
    // not a second full-screen ray or a global-light search.
    if(max(blockerAlbedo.r, max(blockerAlbedo.g, blockerAlbedo.b)) > 0.0)
    {
        vec3 secondAlbedo, secondPos, secondNormal;
        vec3 second = traceVPTEmitterDDA(blockerPos + blockerNormal * 0.02,
            sampleHemisphereCosine(blockerNormal, rngState), secondAlbedo,
            secondPos, secondNormal);
        return hitAlbedo * blockerAlbedo * second * 0.55;
    }
    return vec3(0.0);
}


// Fixed northern-latitude equinox path. Minecraft +X is east and +Z is south:
// 0.0 = due-east sunrise, 0.25 = due-south noon at 55 degrees altitude,
// 0.5 = due-west sunset, 0.75 = midnight. Seasonal declination is deliberately
// not introduced here; it will be added as a separate, explicit stage.
const float SOLAR_LATITUDE_35_SIN = 0.57357643635;
const float SOLAR_LATITUDE_35_COS = 0.81915204429;

// 2026-10-07 末地光源球开关（定义见 sky_model_common.glsl，本文件在其
// include 之前就用，这里提前兜底；重复定义同值合法）。
#ifndef END_ORB_ENABLE
#define END_ORB_ENABLE 1
#endif

vec3 getTimeDrivenSunDirection()
{
    const float TWO_PI = 6.28318530718;
    float dayAngle =
        fract(cam.historyParams.w) * TWO_PI;

#if END_ORB_ENABLE
    // 2026-10-18 末地光源球：直射方向 = 固定天顶（只自转、不公转）
    // （endOrbDirection，见 sky_model_common.glsl；此处内联字面量是因为
    // 那个头在本函数之后才 include）。影子/高光/GI 全部跟着这根向量走，
    // 与 rmiss 里的可见球同一几何。非末地逐位不变。
    // ⚠ 六个方向副本必须同一向量，否则可见球与直射光方向分家。
    if(abs(cam.weatherParams.z - 3.0) < 0.25)
    {
        // 2026-10-18：光源球固定在末地天顶（只自转、不公转）。
        return vec3(0.0, 1.0, 0.0);
    }
#endif

    return vec3(
        cos(dayAngle),
        SOLAR_LATITUDE_35_COS * sin(dayAngle),
        SOLAR_LATITUDE_35_SIN * sin(dayAngle)
    );
}

// Preserve the former 3.2 clear-noon irradiance on a horizontal surface
// while keeping the confirmed 55-degree solar altitude.  At noon NdotL on
// flat ground is SOLAR_LATITUDE_35_COS, so 1/cos(35deg) exactly compensates
// the geometric incidence loss instead of raising the historical ground-energy
// baseline.  This restores a clear, hard sun without deliberately overdriving
// bright terrain.  Moonlight remains independently controlled below.
const float TIME_DRIVEN_SUN_NOON_SCALE = 1.22077458876;
// 0.05 was the prior selected midnight value.  Reduce it by 40% without
// changing the day-light BRDF path or the noon sun energy.
const float TIME_DRIVEN_MOON_NOON_SCALE = 0.03;
// 2026-10-09 末地光源球：用户报"天上玻璃球提供的亮度太高了、有点过曝，暗一点"，
// 并且明确只压**它给末地打的直射光**（球体本身在天空里的观感不动，那部分在
// rt_test.rmiss）。末地的直射方向就是光源球方向（getTimeDrivenSunDirection 的
// 末地分支）。2026-10-18 球移到天顶：lightScale 里的 elevation 项从 0.866 升到
// 1.0（×1.155），水平面 NdotL 也从 0.866 升到 1.0（×1.155），地面照度合计
// ×1.333 ⇒ 0.8 / 1.333 = 0.6 把它拉回用户调好的"压暗一档"档位。
// 想更暗继续往下调，0 = 末地没有直射光（只剩星空环境光，见 END_GALAXY_AMBIENT_LIFT）。
const float END_ORB_SUN_LIGHT_SCALE = 0.6;

// Atmosphere C1 keeps the reference pack's weather response deliberately
// compact: sky 20%, direct sunlight 10%, and fog density 1 + 3 * rain^2 at
// full rain.  Weather is strictly an Overworld effect in this stage.
const float WEATHER_RF_SKY_BRIGHTNESS = 0.20;
const float WEATHER_RF_SUN_BRIGHTNESS = 0.10;
const float WEATHER_RF_DENSITY = 1.0;
const vec3 WEATHER_THUNDER_COLD_TINT = vec3(0.72, 0.78, 0.86);

float getTimeDrivenSunElevation()
{
    const float TWO_PI = 6.28318530718;
#if END_ORB_ENABLE
    // 末地光源球固定天顶 ⇒ 末地恒"白天"：昼夜翻转 / 暮色染色 /
    // 月光档都不再参与末地（与 rmiss 同一份判据）。
    if(abs(cam.weatherParams.z - 3.0) < 0.25)
    {
        return 1.0;
    }
#endif
    return SOLAR_LATITUDE_35_COS *
        sin(fract(cam.historyParams.w) * TWO_PI);
}

float getOverworldRainStrength()
{
    return abs(cam.weatherParams.z - 1.0) < 0.25
        ? clamp(cam.weatherParams.x, 0.0, 1.0)
        : 0.0;
}

float getOverworldThunderStrength()
{
    return abs(cam.weatherParams.z - 1.0) < 0.25
        ? clamp(cam.weatherParams.y, 0.0, 1.0)
        : 0.0;
}

float getWeatherSkyRadianceFactor()
{
    return mix(1.0, WEATHER_RF_SKY_BRIGHTNESS, getOverworldRainStrength());
}

float getWeatherSunRadianceFactor()
{
    return mix(1.0, WEATHER_RF_SUN_BRIGHTNESS, getOverworldRainStrength());
}

vec3 getWeatherSkyTint()
{
    return mix(vec3(1.0), WEATHER_THUNDER_COLD_TINT, getOverworldThunderStrength());
}

// =====================================================
// Rain wall run-off tuning
//
// Split in two:
//
//   - the *shape* of the effect stays compile-time here.  The rivulet lattice
//     geometry and the material response are what make the wall read as water
//     rather than as dirt, and none of them is a taste decision a player should
//     have to make;
//   - the *dial* values live in cam.rainWallParams0/1, filled every frame from
//     RTXSettingsConfig.RainWallSettings, so the look can be judged in game
//     with no rebuild.
//
// Four of the dials are scale factors with a 1.0 identity value, which is what
// keeps the constants below meaningful: at 1.0 the effective parameter is
// exactly the constant.  Density and distance are absolute instead, because
// "no rivulets" and "this far" have no natural identity.
//
// Cost shape is unchanged by the dials: they move distances and scales, never
// sample counts.
//   - the film is one evaluateContinuousRainWetnessNoise call on (tangent,
//     height) -- the same cost the wet ground already pays;
//   - the droplets add three rainPuddleHash calls per pixel;
//   - the one new ray per pixel is bounded by the effect distance, so it never
//     runs on the far field and never traverses a full open-sky column.
//
// Accessors rather than file-scope variables on purpose: a global with a
// non-constant initialiser has to be ordered against this block at link time,
// and the compiler inlines these calls away anyway.
// =====================================================

bool rainWallEnabled()
{
    return cam.rainWallParams0.x > 0.5;
}

// Scales the film's albedo darkening and its pull towards the film roughness in
// one number, so "wetness" cannot be pushed into an inconsistent pair.
float rainWallWetnessScale()
{
    return clamp(cam.rainWallParams0.y, 0.0, 2.0);
}

// Fraction of the rivulet columns that actually run.  Zero leaves the static
// film everywhere and no droplets at all.
float rainWallDripDensity()
{
    return clamp(cam.rainWallParams0.z, 0.0, 1.0);
}

float rainWallDripSpeedScale()
{
    return clamp(cam.rainWallParams0.w, 0.1, 4.0);
}

// 2026-10-07（用户要求）：墙面雨滴的**大小**旋钮，接管已退役的"拖尾长度"档。
//
// 这个 lane（rainWallParams1.x）原来是 RAIN_WALL_DRIP_HEARTFELT=0 旧档（水柱 trail
// 模型）的周期倍率；旧档整段删除后它正好空出来，于是"大小"直接接手 —— 不新增 lane、
// 不改结构体布局、不碰静态断言。
//
// 语义：它是**场域缩放的倒数倍率** —— heartfeltDrops 里三个 scale 都除以它，
// 所以值越大 ⇒ 场域越小 ⇒ 水滴越大（并连带把格距变疏；要与密度分开调就用
// "墙面水滴密度"）。1.0 = 出厂观感。
//
// 0 ⇒ 视为 1.0：这是"从未下发过"的哨兵（未初始化的 lane 写 0、旧 DLL 写 1.0，
// 两种都要安全）。
float rainWallDripSize()
{
    float raw = cam.rainWallParams1.x;
    return raw > 0.0 ? clamp(raw, 0.25, 4.0) : 1.0;
}

float rainWallDripBumpScale()
{
    return clamp(cam.rainWallParams1.z, 0.0, 2.0);
}

// The single distance dial.  It is read as "how far from the camera the effect
// still runs" and drives all three gates below, so they can never cross each
// other.  Cost is linear in this value only through the sky-exposure ray.
float rainWallEffectDistance()
{
    return clamp(cam.rainWallParams1.y, 16.0, 160.0);
}

// =====================================================
// Water style dials (Waterlight turquoise look).
// Same accessor pattern as the rain-wall block above: the native side fills
// waterStyleParams every frame, the JNI setter validates the ranges, and
// these clamps are only the safety net for a stale buffer.
// =====================================================

// Uniform scale on every natural wave band.  The closest-hit paths and the
// caustic pass scale identically, so caustics keep tracking the normals.
float waterStyleWaveScale()
{
    return clamp(cam.waterStyleParams0.x, 0.0, 2.0);
}

// 0.0 = the legacy blue-teal water, 1.0 = the turquoise Waterlight look.
// Density scale rides on absorption so "clearer / murkier" is one dial.
vec3 waterAbsorptionColor()
{
    return mix(
        vec3(0.18, 0.055, 0.018),
        vec3(0.24, 0.045, 0.055),
        clamp(cam.waterStyleParams0.y, 0.0, 1.0)
    ) * clamp(cam.waterStyleParams0.z, 0.25, 4.0);
}

vec3 waterScatterColor()
{
    return mix(
        vec3(0.05, 0.22, 0.28),
        vec3(0.05, 0.34, 0.30),
        clamp(cam.waterStyleParams0.y, 0.0, 1.0)
    );
}

float waterScatteringAmount()
{
    return mix(0.3076923, 0.38, clamp(cam.waterStyleParams0.y, 0.0, 1.0));
}

float waterStyleCausticStrength()
{
    return clamp(cam.waterStyleParams0.w, 0.0, 4.0);
}

// Droplets need their trail to be resolvable, so they cut out earlier than the
// static film does.  A distant wall may stay wet -- the film is one noise fetch
// -- but it must not animate, because a droplet trail near the sub-pixel limit
// reads as flicker rather than as flow.  At the 64 block default the ratio
// reproduces the original hand-tuned 64 / 48 / 48 / 64 split exactly.
const float RAIN_WALL_DRIP_DISTANCE_RATIO = 0.75;

float rainWallWetnessDistance()
{
    return rainWallEffectDistance();
}

float rainWallDripDistance()
{
    return rainWallEffectDistance() * RAIN_WALL_DRIP_DISTANCE_RATIO;
}

float rainWallExposureDistance()
{
    return rainWallEffectDistance() * RAIN_WALL_DRIP_DISTANCE_RATIO;
}

float rainWallExposureRange()
{
    return rainWallEffectDistance();
}

// Film response.  Roughness drops well below the wet ground's 0.075 because a
// vertical film is thin but reads as far smoother to the eye.  These are the
// reference values the wetness scale multiplies or mixes towards.
const float RAIN_WALL_ALBEDO_DARKENING = 0.30;
const float RAIN_WALL_FILM_ROUGHNESS = 0.10;

// 2026-10-07 退役：这一段原是旧"水柱/河沟 trail"模型的常量
//   RAIN_WALL_DRIP_COLUMN_WIDTH / _SPEED_MIN,_MAX / _PERIOD /
//   _TRAIL_STRENGTH / _HEAD_WIDTH
// 旧档（RAIN_WALL_DRIP_HEARTFELT=0）整段删除后它们没有任何消费者，一并移除。
// 现存墙面雨滴是 Heartfelt 水珠场，标定见下面 RAIN_WALL_HEARTFELT_* 与
// rainWallDripSize()。

// 2026-10-07：原来这里还有一条 RAIN_WALL_DRIP_BUMP（旧档"整列往外顶"的 bump 系数），
// 随旧"水柱"模型删除后已无消费者，一并移除。下面这条仍是活代码 —— 湿膜与水珠共用。
const float RAIN_WALL_DRIP_ROUGHNESS = 0.045;

// Per-column salts.  These only need to decorrelate the column lookups from
// one another; any distinct constants work.
// =====================================================
// 2026-10-03（用户要求）：**雨可见度统一 2× 增益**。
// 只影响强度，不改机制、不加取样、不加开销；觉得过头/不够，只动这一个数。
// 作用点三处：
//   · rgen「雨滴涟漪」（evaluateRainPuddleRippleGradient，水面/地面的雨点圈）
//   · rgen「墙面雨痕 bump」（RAIN_WALL_DRIP_BUMP 那条）
//   · rchit「雨条本体的 albedo」（rt_test.rchit 的 isRtWeatherRain 分支，
//     同名常量在那边重复定义，两边必须一起改）
// =====================================================
const float RAIN_VISIBILITY_GAIN = 2.0;

#if 0
// Superseded by the camera UBO dials above; kept as the record of the
// hand-tuned look the defaults were calibrated against.
//
//   RAIN_WALL_WETNESS_DISTANCE   -> rainWallWetnessDistance()
//   RAIN_WALL_DRIP_DISTANCE      -> rainWallDripDistance()
//   RAIN_WALL_EXPOSURE_DISTANCE  -> rainWallExposureDistance()
//   RAIN_WALL_EXPOSURE_RANGE     -> rainWallExposureRange()
//   RAIN_WALL_DRIP_COLUMN_COVERAGE -> rainWallDripDensity()
const float RAIN_WALL_WETNESS_DISTANCE = 64.0;
const float RAIN_WALL_DRIP_DISTANCE = 48.0;
const float RAIN_WALL_EXPOSURE_DISTANCE = 48.0;
const float RAIN_WALL_EXPOSURE_RANGE = 64.0;
const float RAIN_WALL_DRIP_COLUMN_COVERAGE = 0.38;
#endif

// Stable, low-frequency wet-patch field.  It is evaluated only after a
// primary opaque hit has already used its existing sun-visibility rays.
float rainPuddleHash(vec2 p)
{
    p = fract(p * vec2(0.1031, 0.11369));
    p += dot(p, p.yx + 19.19);
    return fract((p.x + p.y) * p.x);
}

// =====================================================
// 2026-10-07 墙面雨滴换成 Heartfelt 风格（Martijn Steinrucken "Heartfelt",
// Shadertoy, CC BY-NC-SA 3.0）。移植说明：
//   · 原版是屏幕域 + 背景纹理折射；这里只移植"水珠形状场"（StaticDrops +
//     两层 DropLayer2：主水珠 + 摆动 + 尾迹 + 卫星水珠），域接现有
//     wallUV（tangent, height），水珠自然向下流、不随相机游动。
//   · 雾玻璃 / 闪电 / 爱心段落对不透明墙面不适用，未移植。
//   · "expensive normals"：对场做两次偏移采样求梯度，在应用处把法线沿
//     切平面倾斜（替代旧的"整列往外顶"bump），这是水珠圆润高光的来源。
//   · 旋钮映射：dripDensity→rainAmount 分层权重，dripSpeedScale→时间步，
//     dripBumpScale→法线幅度；wetness/drip 距离门与天空暴露门全部沿用。
//   · 旋钮映射补一条（2026-10-07）：`rainWallParams1.x` = **雨滴大小**（场域缩放的
//     倒数倍率，见 rainWallDripSize）。
//   · 2026-10-07 退役：原来 RAIN_WALL_DRIP_HEARTFELT 置 0 可逐位回**旧档**（水柱/河沟
//     trail 模型：列哈希 + 周期下落 + 窄亮头 + 拖尾）。该模型连同它专用的常量
//     （COLUMN_WIDTH / SPEED_MIN,MAX / PERIOD / TRAIL_STRENGTH / HEAD_WIDTH / 三个
//     SALT）以及它的"拖尾长度"设置一起删除，宏本身也不再存在。
// =====================================================
// 2026-10-07：RAIN_WALL_DRIP_HEARTFELT 宏与它的 #if/#else 回退已随旧"水柱"档一起
// 删除 —— 从这里往下是**唯一**的墙面雨滴实现（原 #if 分支那一段）。
// World-space calibration.  The original domain is normalised screen height;
// SCALE maps one main-layer cell to 2 blocks tall / 1/3 block wide, keeping
// the original cell aspect (6:1) so droplets stay round.
const float RAIN_WALL_HEARTFELT_SCALE = 0.25;
const float RAIN_WALL_HEARTFELT_STATIC_SCALE = 0.15;
const float RAIN_WALL_HEARTFELT_FLOW_SCALE = 0.4;
const float RAIN_WALL_HEARTFELT_TIME_SCALE = 0.2;
const float RAIN_WALL_HEARTFELT_NORMAL_EPSILON = 0.004;
const float RAIN_WALL_HEARTFELT_BUMP = 6.0;

// 2026-11-04：拖尾接回。heartfeltDropLayer 一直返回 .y = trail（水珠头后方的细流），
// 但 2026-10-07 移植时调用处只取 .x，拖尾成了死计算（旧的"水柱 trail"模型同日退役，
// 画面上从那天起就没有拖尾）。这条权重把 .y 并回场域：1.0 = 原版观感（拖尾本身
// 已比主水珠细且弱）；0.0 = 逐位回到接回前的无拖尾画面。
const float RAIN_WALL_HEARTFELT_TRAIL = 1.0;

vec3 heartfeltN13(float p)
{
    vec3 p3 = fract(vec3(p) * vec3(0.1031, 0.11369, 0.13787));
    p3 += dot(p3, p3.yzx + 19.19);
    return fract(vec3(
        (p3.x + p3.y) * p3.z,
        (p3.x + p3.z) * p3.y,
        (p3.y + p3.z) * p3.x
    ));
}

float heartfeltN(float t)
{
    return fract(sin(t * 12345.564) * 7658.76);
}

float heartfeltSaw(float b, float t)
{
    return smoothstep(0.0, b, t) * smoothstep(1.0, b, t);
}

float heartfeltStaticDrops(vec2 uv, float t)
{
    uv *= 40.0;

    vec2 id = floor(uv);
    uv = fract(uv) - 0.5;

    vec3 n = heartfeltN13(id.x * 107.45 + id.y * 3543.654);
    vec2 p = (n.xy - 0.5) * 0.7;
    float d = length(uv - p);

    float fade = heartfeltSaw(0.025, fract(t + n.z));
    return smoothstep(0.3, 0.0, d) * fract(n.z * 10.0) * fade;
}

vec2 heartfeltDropLayer(vec2 uv, vec2 flowUv, float t)
{
    uv.y += t * 0.75;

    vec2 a = vec2(6.0, 1.0);
    vec2 grid = a * 2.0;
    vec2 id = floor(uv * grid);

    uv.y += heartfeltN(id.x);

    id = floor(uv * grid);
    vec3 n = heartfeltN13(id.x * 35.2 + id.y * 2376.1);
    vec2 st = fract(uv * grid) - vec2(0.5, 0.0);

    float x = n.x - 0.5;
    float y = flowUv.y * 20.0;
    float wiggle = sin(y + sin(y));
    x += wiggle * (0.5 - abs(x)) * (n.z - 0.5);
    x *= 0.7;

    float ti = fract(t + n.z);
    y = (heartfeltSaw(0.85, ti) - 0.5) * 0.9 + 0.5;
    vec2 p = vec2(x, y);

    float d = length((st - p) * a.yx);
    float mainDrop = smoothstep(0.4, 0.0, d);

    float r = sqrt(smoothstep(1.0, y, st.y));
    float cd = abs(st.x - x);
    float trail = smoothstep(0.23 * r, 0.15 * r * r, cd);
    float trailFront = smoothstep(-0.02, 0.02, st.y - y);
    trail *= trailFront * r * r;

    y = fract(flowUv.y * 10.0) + (st.y - 0.5);
    float dd = length(st - vec2(x, y));
    float droplets = smoothstep(0.3, 0.0, dd);
    float m = mainDrop + droplets * r * trailFront;

    return vec2(m, trail);
}

// 2026-10-07：多了 sizeScale（用户"雨滴大小"旋钮，lane 见 rainWallDripSize）。
// 三个场域缩放**同时**除以它，于是各自的宽高比不变 —— 上面 SCALE 那行注释的
// "one main-layer cell = 2 blocks tall / 1/3 block wide"（6:1）标定在任意 size 下
// 都成立，水滴仍是圆的，只是整体变大变小。sizeScale = 1.0 时逐位回到出厂观感。
// 第二层的 uv * 1.85 与 heartfeltDropLayer 内部的固定网格故意不动：它们是"同一场域里
// 的第二层 / 层内形状"，跟着主域一起缩放才对。
vec2 heartfeltDrops(vec2 wallUV, float t, float l0, float l1, float l2, float sizeScale)
{
    float inverseSize = 1.0 / max(sizeScale, 1.0e-3);
    vec2 uv = wallUV * (RAIN_WALL_HEARTFELT_SCALE * inverseSize);
    vec2 flowUv = wallUV * (RAIN_WALL_HEARTFELT_FLOW_SCALE * inverseSize);

    float s = heartfeltStaticDrops(
        wallUV * (RAIN_WALL_HEARTFELT_STATIC_SCALE * inverseSize), t) * l0;

    vec2 m1 = heartfeltDropLayer(uv, flowUv, t) * l1;
    vec2 m2 = heartfeltDropLayer(uv * 1.85, flowUv, t) * l2;

    float c = s + m1.x + m2.x;
    return vec2(smoothstep(0.3, 1.0, c), max(m1.y * l0, m2.y * l1));
}

float evaluateRainPuddlePattern(vec2 worldXZ)
{
    vec2 p = worldXZ * 0.31;
    vec2 cell = floor(p);
    vec2 f = fract(p);
    vec2 blend = f * f * (3.0 - 2.0 * f);

    float n00 = rainPuddleHash(cell);
    float n10 = rainPuddleHash(cell + vec2(1.0, 0.0));
    float n01 = rainPuddleHash(cell + vec2(0.0, 1.0));
    float n11 = rainPuddleHash(cell + vec2(1.0, 1.0));
    float broad = mix(mix(n00, n10, blend.x), mix(n01, n11, blend.x), blend.y);
    float detail = rainPuddleHash(floor(worldXZ * 1.73));
    return smoothstep(0.56, 0.82, broad * 0.80 + detail * 0.20);
}

// Reference wetness uses a continuous noise modulation, never a binary
// puddle mask.  The reference values are preserved here: world XZ is scaled
// by 5.0, the second octave is 0.37x with weight 3.0, and the final wetness
// multiplier is saturate(1 - n * 0.25) * 0.7 + 0.3.  The hash-backed value
// field is used only until block 2 installs the reference pack's noise image.
float evaluateContinuousRainWetnessNoise(vec2 worldXZ)
{
    vec2 p0 = worldXZ * 5.0;
    vec2 cell0 = floor(p0);
    vec2 frac0 = fract(p0);
    vec2 blend0 = frac0 * frac0 * (3.0 - 2.0 * frac0);
    float n00 = rainPuddleHash(cell0);
    float n10 = rainPuddleHash(cell0 + vec2(1.0, 0.0));
    float n01 = rainPuddleHash(cell0 + vec2(0.0, 1.0));
    float n11 = rainPuddleHash(cell0 + vec2(1.0, 1.0));
    float n0 = mix(mix(n00, n10, blend0.x), mix(n01, n11, blend0.x), blend0.y);

    vec2 p1 = p0 * 0.37;
    vec2 cell1 = floor(p1);
    vec2 frac1 = fract(p1);
    vec2 blend1 = frac1 * frac1 * (3.0 - 2.0 * frac1);
    float n20 = rainPuddleHash(cell1);
    float n30 = rainPuddleHash(cell1 + vec2(1.0, 0.0));
    float n21 = rainPuddleHash(cell1 + vec2(0.0, 1.0));
    float n31 = rainPuddleHash(cell1 + vec2(1.0, 1.0));
    float n1 = mix(mix(n20, n30, blend1.x), mix(n21, n31, blend1.x), blend1.y);

    float n = n0 + n1 * 3.0;
    return clamp(1.0 - n * 0.25, 0.0, 1.0) * 0.7 + 0.3;
}

// Wet ground uses the same no-allocation model as the water-rain path: one
// deterministic impact per world-space cell, evaluated only on an already
// visible, rain-exposed upward opaque surface.  It adds neither particles,
// textures nor ray queries, and stays stable for RR/DLSS reprojection.
vec2 evaluateRainPuddleRippleGradient(vec2 worldXZ)
{
    float rain = getOverworldRainStrength();
    if(rain <= 0.01)
    {
        return vec2(0.0);
    }

    // All rain-impact dimensions are 40% smaller than the current dense
    // field.  The matching frequency preserves the same ring count in the
    // reduced footprint.
    const float CELL_SIZE = 0.432;
    const float RING_SPEED = 0.336;
    const float RING_FREQUENCY = 66.66667;
    float time = uintBitsToFloat(cam.padding);
    vec2 baseCell = floor(worldXZ / CELL_SIZE);
    vec2 gradient = vec2(0.0);

    for(int y = -1; y <= 1; ++y)
    {
        for(int x = -1; x <= 1; ++x)
        {
            vec2 cell = baseCell + vec2(float(x), float(y));
            float seedX = rainPuddleHash(cell + vec2(17.0, 43.0));
            float seedZ = rainPuddleHash(cell + vec2(71.0, 29.0));
            float age = fract(time * mix(0.42, 1.08, rain) +
                rainPuddleHash(cell + vec2(113.0, 7.0)));
            vec2 impact = (cell + vec2(seedX, seedZ)) * CELL_SIZE;
            vec2 delta = worldXZ - impact;
            float distanceToImpact = length(delta);
            float envelope = (1.0 - smoothstep(0.52, 1.0, age)) *
                (1.0 - smoothstep(0.12, 0.204, distanceToImpact));
            if(envelope <= 0.0 || distanceToImpact <= 1.0e-4)
            {
                continue;
            }

            float radius = age * RING_SPEED;
            float slope = cos((distanceToImpact - radius) * RING_FREQUENCY);
            gradient += normalize(delta) * slope * envelope;
        }
    }

    // Keep the confirmed visible normal amplitude while reducing the ring
    // footprint.  This remains a nine-cell analytic evaluation with no extra
    // ray, texture, allocation, or dispatch cost.
    // 2026-10-03（用户要求）：雨滴涟漪可见度 ×2（RAIN_VISIBILITY_GAIN）。
    return gradient * (0.060 * rain) * RAIN_VISIBILITY_GAIN;
}

// -------------------------------------------------------------------------
// Tyndall-derived cloud field for secondary rays and cloud shadows
// -------------------------------------------------------------------------
// Secondary rays use fewer samples of the same curved density field.
const int C3_CLOUD_HQ_SAMPLES = 16;
const int C3_CLOUD_LQ_SAMPLES = 5;
const int C3_CLOUD_SUN_SAMPLES = 5;
#define C3_CLOUD_BOTTOM cam.cloudParams0.x
#define C3_CLOUD_THICKNESS cam.cloudParams0.y
#define C3_CLOUD_ENABLED cam.cloudParams1.w
#define C3_CLOUD_EXTINCTION cam.cloudParams2.z
const float C3_CLOUD_BASIC_SHADOWLIGHT = 0.10;
const float C3_CLOUD_BASIC_SKYLIGHT = 0.10;
const float C3_CLOUD_FADE_DISTANCE = 30000.0;
const float C3_CLOUD_MIN_TRANSMITTANCE = 0.20;
const float C3_CLOUD_MIN_SUN_TRANSMITTANCE = 0.10;

float c3Saturate(float value)
{
    return clamp(value, 0.0, 1.0);
}

#include "tyndall_cloud_field.glsl"

float c3CloudDensity(vec3 worldPos, bool simplified)
{
    return tyndallDensity(worldPos, simplified, 0.0);
}

// 云影总开关（CLOUD_SHADOWS，默认 1；置 0 回纯透射桩 = 无云影）。
// 实现原本就在（此前被注释停用）：沿受光方向穿过云壳段取 5 个 cheap 密度
// 样本积分透射率；8 个消费点（水面高光/POM/玻璃/DH 远场）早已乘好该系数，
// 本体启用即全线生效。性能：仅主世界 + 光源在地平线上时走；浓影早退
// （transmittance<0.10 即 break）；每次 ≈15 次 noise 读，只付给被直射
// 命中的表面像素，不进 GI/反射循环。
#ifndef CLOUD_SHADOWS
#define CLOUD_SHADOWS 1
#endif
// =====================================================
// 2026-10-02（帧率优化 B3）：云影透射的**单入口缓存**
//
// 每次 c3CloudSunTransmittance 都要做 C3_CLOUD_SUN_SAMPLES(=5) 次带 mip 的 3D 采样
// （tyndallDensity → textureLod），而同一个着色点在一帧里常被**多处**重复查询：
// 太阳直射的两个入口（6757 / 17394）、玻璃与水面的高光/透射（12607 / 6659 / 11719）、
// 同一个 GI 顶点的多次估计（18608）、DH 远场（19715）……
//
// 缓存键 = 世界位置 + 太阳方向；位置用**很松的容差**（默认 0.05 格），因为各调用点
// 对同一个点用的是不同的小偏移（+L*0.001 / +N*0.035 / 不加偏移），只有松容差才能让
// 它们命中同一条。云影场是公里尺度、在 0.05 格内可视为常量 ⇒ 复用与重算**视觉等价**
// （不是逐位相同 —— 这点如实标明；要逐位相同就把容差设成 0，命中率会掉到只剩
// "位置完全一致"的那几对）。
//
// 作用域：raygen 全局 = per-invocation，线程间不共享，也不跨像素。
// A/B：-DVPT_CLOUD_SUN_CACHE=0 回到每次重算。
// =====================================================
#ifndef VPT_CLOUD_SUN_CACHE
#define VPT_CLOUD_SUN_CACHE 1
#endif
#ifndef VPT_CLOUD_SUN_CACHE_TOLERANCE
#define VPT_CLOUD_SUN_CACHE_TOLERANCE 0.05
#endif

float c3CloudSunTransmittanceUncached(vec3 worldPos, vec3 sunDirection);

bool g_c3CloudSunCacheValid = false;
vec3 g_c3CloudSunCachePos = vec3(0.0);
vec3 g_c3CloudSunCacheSun = vec3(0.0);
float g_c3CloudSunCacheValue = 1.0;

float c3CloudSunTransmittance(vec3 worldPos, vec3 sunDirection)
{
#if VPT_CLOUD_SUN_CACHE
    if(g_c3CloudSunCacheValid &&
       dot(sunDirection, g_c3CloudSunCacheSun) > 0.999999 &&
       max(abs(worldPos.x - g_c3CloudSunCachePos.x),
           max(abs(worldPos.y - g_c3CloudSunCachePos.y),
               abs(worldPos.z - g_c3CloudSunCachePos.z))) <=
           VPT_CLOUD_SUN_CACHE_TOLERANCE)
    {
        return g_c3CloudSunCacheValue;
    }
    float cachedValue =
        c3CloudSunTransmittanceUncached(worldPos, sunDirection);
    g_c3CloudSunCacheValid = true;
    g_c3CloudSunCachePos = worldPos;
    g_c3CloudSunCacheSun = sunDirection;
    g_c3CloudSunCacheValue = cachedValue;
    return cachedValue;
#else
    return c3CloudSunTransmittanceUncached(worldPos, sunDirection);
#endif
}

float c3CloudSunTransmittanceUncached(vec3 worldPos, vec3 sunDirection)
{
#if CLOUD_SHADOWS
    if(abs(cam.weatherParams.z - 1.0) >= 0.25 || sunDirection.y <= 1.0e-5)
    {
        return 1.0;
    }
    // Sample only the nearby cloud-shell segment, never the far side.
    float entryDistance;
    float exitDistance;
    if(!tyndallInterval(worldPos, sunDirection, entryDistance, exitDistance))
        return 1.0;
    float stepLength = (exitDistance - entryDistance) / float(C3_CLOUD_SUN_SAMPLES);
    float transmittance = 1.0;
    for(int i = 0; i < C3_CLOUD_SUN_SAMPLES; ++i)
    {
        vec3 samplePos = worldPos + sunDirection *
            (entryDistance + stepLength * (float(i) + 0.5));
#if C3_CLOUD_SHADOW_GATE_ON
        // 云影密度门控（tyndall_cloud_field.glsl 单一真源）：只有大块云核
        // 参与投影，薄云/碎云/云须贡献清零，地面影子成块跟随云团。
        float opticalDepth = tyndallShadowGate(c3CloudDensity(samplePos, true)) *
            C3_CLOUD_EXTINCTION * stepLength;
#else
        float opticalDepth = c3CloudDensity(samplePos, true) *
            C3_CLOUD_EXTINCTION * stepLength;
#endif
        transmittance *= exp2(-opticalDepth * 1.44269504089);
        if(transmittance < C3_CLOUD_MIN_SUN_TRANSMITTANCE)
        {
            break;
        }
    }
    return c3Saturate((transmittance - C3_CLOUD_MIN_SUN_TRANSMITTANCE) /
        (1.0 - C3_CLOUD_MIN_SUN_TRANSMITTANCE));
#else
    return 1.0;
#endif
}

float getClearTimeDrivenSkyLightRadianceScale()
{
    float elevation = getTimeDrivenSunElevation();
    // Keep the existing noon source-energy calibration.  Surface incidence
    // and atmospheric traversal still use the true 35-degree-latitude angle.
    float normalizedCycleElevation =
        abs(elevation) / SOLAR_LATITUDE_35_COS;
    return elevation >= 0.0
        ? normalizedCycleElevation * TIME_DRIVEN_SUN_NOON_SCALE
        : normalizedCycleElevation * TIME_DRIVEN_MOON_NOON_SCALE;
}

float getTimeDrivenSkyLightRadianceScale()
{
    float clearScale = getClearTimeDrivenSkyLightRadianceScale();
    float lightScale = getTimeDrivenSunElevation() >= 0.0
        // C2 remains a high visual plane.  Receiver lighting is now derived
        // only from the sampled C3 density field below, not player-position
        // attenuation from the older plane-cloud stage.
        ? clearScale * getWeatherSunRadianceFactor()
        : clearScale;
    // 2026-10-09 末地：直射光只来自光源球 ⇒ 按用户要求整体压暗一档
    // （见 END_ORB_SUN_LIGHT_SCALE 的注释）。非末地不乘 ⇒ 主世界/下界逐位不变。
    if(abs(cam.weatherParams.z - 3.0) < 0.25)
    {
        lightScale *= END_ORB_SUN_LIGHT_SCALE;
    }
    return lightScale;
}

vec3 getTimeDrivenSkyLightDirection()
{
    // At night the physical light source is the moon, opposite the sun and
    // therefore above the horizon.  This prevents below-world "sun" rays.
    return getTimeDrivenSunElevation() >= 0.0
        ? getTimeDrivenSunDirection()
        : -getTimeDrivenSunDirection();
}

// 黎明与黄昏的色相是分开的。旧版只看高度角，太阳上升与下降经过同一高度时
// 颜色完全相同，所以黎明和黄昏无法分辨。现在按太阳在升还是在落选色。
// phase 0 = 日出、0.25 = 正午、0.5 = 日落、0.75 = 午夜，所以
// cos(2π·phase) > 0 表示太阳在上升（黎明侧）。
// 数值必须与 sky_atmosphere.comp / volumetric_clouds.comp / volumetric_light.comp
// 保持一致，否则天空、云、光柱与地形受光会各说各话。
// 注意：全局 PI 在本文件后段才声明，这里沿用函数内 TWO_PI 的既有写法。
// 2026-09-30 用户定档纯橘偏红：拂晓/黄昏 tint 同步推红（色相 ~19-25°），
// 五处副本逐字同步；拂晓前的冷紫不受影响。
#include "sky_model_common.glsl"

#include "sky_sun_common.glsl"
// 2026-10-06 极光：需要 AURORA_* 常量（照进夜天光颜色）与 evaluateAurora
// （极光进天空 LUT 的那份由 sky_atmosphere.comp 写，这里只用常量与函数定义）。
#include "aurora_common.glsl"

// Direct sunlight keeps a neutral high-noon white, then moves continuously
// toward orange-gold near the horizon.  Night uses a cool lunar tint; its
// actual energy remains controlled solely by TIME_DRIVEN_MOON_NOON_SCALE.
vec3 getTimeDrivenSkyLightColorRaw()
{
    float elevation = getTimeDrivenSunElevation();
    if(elevation < 0.0)
    {
#if SKY_DAY_PHASE
        // 拂晓/傍晚（太阳在地平线下）：夜蓝向暮色调色板连续过渡，越贴近
        // 地平线暮色越浓，与日出/日落瞬间（e >= 0 分支）无缝衔接；深夜
        // 保持冷月蓝。0.72 与上方 >= 0 侧的调色板混合系数一致，交接处
        // 无色阶。能量侧本就随 |e| 归零，不改变夜晚整体亮度。
        float twilight = smoothstep(-0.22, -0.005, elevation);
        vec3 twilightTint = mix(TWILIGHT_DAWN_TINT, TWILIGHT_DUSK_TINT,
            twilightEveningWeight());
        return mix(vec3(0.46, 0.56, 1.00), twilightTint, twilight * 0.72);
#else
        return vec3(0.46, 0.56, 1.00);
#endif
    }

#if SKY_SUN_TRANSMITTANCE_COLOR
    // 物理闭式基色（sky_sun_common.glsl 单一真源，与 A1 的 airmass 同式）。
    // 日落变红由透射率自动给出；下方暮色调色板混合保持原样。
    vec3 base = skySunPhysicalBaseColor(elevation);
#else
    float highSun = smoothstep(0.08, 0.68, elevation);
    vec3 base = mix(
        vec3(1.00, 0.56, 0.24),
        vec3(1.00, 0.97, 0.90),
        highSun
    );
#endif
    float sunset = 1.0 - smoothstep(0.04, 0.22, elevation);
    vec3 twilightTint = mix(TWILIGHT_DAWN_TINT, TWILIGHT_DUSK_TINT,
        twilightEveningWeight());
#if SKY_DAY_PHASE
    // 日照金山：黎明/日落两相对直射阳光做金色高饱和（天空/云/反射四处
    // 消费点同步接入），早晨/下午/中午平滑退场，正午标定不动。
    vec3 lightColor = mix(base, twilightTint, sunset * 0.72);
    return skySunGoldenTint(lightColor, elevation);
#else
    return mix(base, twilightTint, sunset * 0.72);
#endif
}

// 2026-10-05 末地月食：直射光的颜色项乘上遮挡因子 —— 太阳被地球完全挡住时整条
// 直射链同步归零（地面变暗、影子消失、水面高光消失），与 rmiss 里可见日盘用的是
// 同一个几何（同一个常量、同一份太阳方向函数）。
// ⚠ 必须放在 sky_model_common.glsl 的 include 之后（END_* 常量与
//   endEarthEclipseFactor 都在那里），这就是它被单独包一层的原因。
// 非末地恒乘 1.0 ⇒ 主世界/下界逐位不变。
vec3 getTimeDrivenSkyLightColor()
{
#if END_ORB_ENABLE
    // 2026-10-07 地球退役 ⇒ 末地月食链移除（遮挡因子非末地本来恒 1.0）。
    vec3 color = getTimeDrivenSkyLightColorRaw();
#else
    vec3 color = getTimeDrivenSkyLightColorRaw() *
        endEarthEclipseFactor(getTimeDrivenSunDirection(), endEarthDirection());
#endif
    // 2026-10-06 极光（雪地 / 云杉群系）：夜里极光是月光之外主要的一份夜天光源
    // —— 雪面在极光下泛青就来自这一段。它必须加在"天空光颜色"上，而不是只写进
    // 天空 LUT：本引擎的天空 LUT 只有可见天空与低 Fresnel 玻璃反射两个消费者，
    // 光靠 LUT 照亮不了世界。白天 auroraNight = 0、非寒冷群系 auroraParams.x = 0
    // ⇒ 其余场景逐位不变。
    // 2026-10-10 亮度滑杆：乘 auroraParams.y（用户「极光亮度」，默认 1），
    // 否则把亮度拉到 0 时天空极光灭了、这里的环境补光还留着（不一致）。
    float auroraNight = smoothstep(0.06, -0.20, getTimeDrivenSunElevation());
    color += AURORA_LIGHT_COLOR *
        (AURORA_AMBIENT_STRENGTH * clamp(cam.auroraParams.x, 0.0, 1.0) *
         clamp(cam.auroraParams.y, 0.0, 3.0) * auroraNight);
    return color;
}

// =====================================================
// 地表环境底亮度 —— **近场与远场必须共用这一条公式**
// =====================================================
// 这一项是"与时间无关"的基线；真正的昼夜/天气由**直射项**负责
// （getTimeDrivenSkyLightRadianceScale：太阳 1.2208、月亮 0.03、雨天再压）。
// 两边共用 ⇒ 交接处不会出现亮度台阶。
//
// ⚠ 抽成函数就是为了防止"两侧各写一份、然后漂移"：DH 远场此前用的是
//    key/reference 这种**相对**调制，分子分母都在当前时刻求值 ⇒ 比值恒 ≈ 1
//    ⇒ 夜里一点都不变暗，与我们的近场差了 2.2 倍（实测），交接处一条明显圆弧。
//
// ⚠ 用户旋钮 = cam.cameraParams.w（设置界面的 ambient base brightness）。
//    高日照时按 noonShadowContrast 降到 0.55，让被遮挡的面与受光面能分开。
float getSurfaceAmbientBase()
{
    float base = clamp(cam.cameraParams.w, 0.0, 1.0);
    float noonShadowContrast = smoothstep(
        0.35,
        SOLAR_LATITUDE_35_COS,
        max(getTimeDrivenSunElevation(), 0.0)
    );
    float ambient = base * mix(1.0, 0.55, noonShadowContrast);
    // 2026-10-05 末地地照（earthshine，很弱）：地球被照亮的比例越高，补光越强
    //（全食时恰为 0 ✓、地球满地时最大 ✓）。非末地恒乘 1.0 ⇒ 逐位不变。
    // 近场与 DH 远场共用本函数（见上方注释），所以交接处不会出现台阶。
#if !END_ORB_ENABLE
    // 2026-10-07 地球退役 ⇒ 末地地照随之下线（本来就很弱，0.03）。
    if(abs(cam.weatherParams.z - 3.0) < 0.25)
    {
        ambient *= 1.0 + END_EARTHSHINE_STRENGTH *
            endEarthPhase(getTimeDrivenSunDirection(), endEarthDirection());
    }
#endif
    return ambient;
}

// =====================================================
// 2026-10-09 末地星空的环境底光（"让星空也进入 LUT 贡献"）
//
// 与极光那次同一个事实：**天空 LUT 只有两个消费者**（可见天空 + 低菲涅尔玻璃的
// 解析天空反射）⇒ 把星空写进 LUT **照不亮世界**。所以星空的照明贡献落在环境
// 底光上：末地是真空、没有大气散射，用户的环境底光滑块（noDirectLightAmbient）
// 默认只有 0.01，末地此前几乎只有光源球的直射光 ⇒ 阴影死黑、星空"太暗"。
// 2026-10-18 银河视觉退役，这层底光保留（颜色/强度沿用银河时代，观感不变）。
// 这边加的是**带颜色的**底光（银河色），于是阴影里能看见银河的味道。
//
// 非末地 lift = vec3(0)、getSurfaceAmbientRadiance() 逐位等于旧的标量底光
// （vec3(base) 与 float base 在逐分量乘法下等价）⇒ 主世界/下界一分不变。
// ⚠ 近场 / DH 远场必须共用 getSurfaceAmbientRadiance()（近远场公式漂移过会在
//   地平线交接处留下亮度台阶，见 getSurfaceAmbientBase 上方的注释）。
// =====================================================
vec3 endGalaxyAmbientLift()
{
    if(abs(cam.weatherParams.z - 3.0) >= 0.25)
    {
        return vec3(0.0);
    }
    return END_GALAXY_LIGHT_COLOR * END_GALAXY_AMBIENT_LIFT;
}

vec3 getSurfaceAmbientRadiance()
{
    return vec3(getSurfaceAmbientBase()) + endGalaxyAmbientLift();
}

// -------------------------------------------------------------------------
// Atmosphere A1: clear-sky aerial perspective
// -------------------------------------------------------------------------
// This has no payload or secondary-trace dependency.  It is deliberately
// evaluated only for the camera segment after its primary radiance is
// complete; reflections and GI misses already receive the same physical sky
// from rmiss.  Keeping it outside the diffuse loop preserves the established
// SER payload/reorder lifetime exactly.
// 2026-10-10 例外（#2，出厂 0 = 关）：视线遮挡衰减会读远场太阳阴影图
// （sunShadowMapFar）——那是一处**纹理描述符读**，但**不**碰 payload、**不**发
// 次级光线，且仍在本段（主辐亮度完成之后、漫射循环之外）执行，所以上面那句
// "no descriptor dependency" 对它已不成立，而 SER payload/reorder 生命周期不变。
// 滑杆为 0 时整段短路 ⇒ 描述符读取一次都不发生。
// 2026-10-10：数学本体已抽到 clear_sky_aerial.glsl（rgen 的地形 A1 与
// volumetric_clouds.comp 的「云层空气透视」共用同一份）。下面只剩**参数绑定** ——
// 把 rgen 的 time-driven 调色板栈喂给参数化核心，逐项对应：
//   getTimeDrivenSkyLightColor()             → skyLightColor
//   getClearTimeDrivenSkyLightRadianceScale()→ skyLightRadianceScale
//   getWeatherSkyRadianceFactor()/Tint()     → 天气因子 / 雷暴冷色
// 同一表达式、同一顺序 ⇒ 观感与抽出去之前一致。
#include "clear_sky_aerial.glsl"

vec3 samplePhysicalClearSkyForAerialPerspective(vec3 rayDir)
{
    // Keep direct sunlight at its own weather factor.  Sky scattering uses
    // the softer 20%-at-full-rain reference response instead.
    return clearSkyInscatter(
        rayDir,
        getTimeDrivenSunElevation(),
        getTimeDrivenSkyLightDirection(),
        getTimeDrivenSkyLightColor(),
        getClearTimeDrivenSkyLightRadianceScale(),
        getWeatherSkyRadianceFactor(),
        getWeatherSkyTint());
}

// =====================================================
// 基础晴空消透的标度（2026-10-01）
// =====================================================
// 这是"远场泛白"的真正来源。（原「边界雾」= cloudParams4.yzw 那条已于
// 2026-10-02 整链退役，出厂 gain 本就是 0、短路恒不执行，删掉不改观感。）
//   本项 = 逐通道消光 vec3(3.0e-5, 5.2e-5, 9.0e-5) × 距离，永远生效；
// 实测（heightDensity 平视 ≈0.9~1.0）被替换成天空色的比例：
//   1000 格 3%/5%/9%、3000 格 9%/15%/24%、6000 格 17%/27%/42%。
// 蓝通道衰减最快 ⇒ **越远越发蓝白**。俯瞰时 heightDensity 还会被放大到 2.23 倍
// （midpointY ≤ 31 即顶满），3000 格就能到 18%/45%。
//
// 1.0 = 出厂值；0.0 = 完全关掉这条基础晴空消透（当前选择）。
// 只关这一项不影响雨天雾（rainFogAmount，另一条路）。
//
// 2026-10-10：这条标度从**编译期常量提升为 GUI 滑杆**
// （CameraUBO.cloudAerialParams.y，「地面大气透视」）。常量保留为**编译期地板**
// （当前 0.0）⇒ 滑杆 = 0 时与抽出滑杆之前逐位一致（= 全链关闭）。
const float AP_BASE_EXTINCTION_SCALE = 0.0;

// =====================================================
// #2 视线遮挡衰减（2026-10-10）
// =====================================================
// 参考 LandAtmosphericScattering：
// 沿视线对阴影图累 shadowLength += step(solidDepth, z)，再
// shadowDist = dist - shadowLength * stepLen —— "被地形挡住的那段空气不产生
// 太阳散射"。这里把同一个量折算成 in-scatter 的乘子：沿视线取 N 个**空气点**
// 查太阳可见性，返回被遮挡的比例。
//
// ⚠ 两处与参考不同，都是本项目条件决定的：
//   · 参考查 shadowtex0（太阳视图的**几何深度**）；rgen 只有远场太阳阴影图
//     （sunShadowMapFar，extent ±384 格 / 1024²）。它在"**表面**采样点"上会恒判
//     全遮挡（见上面 binding 58 的说明）—— 本函数查的是**空气点**，那条失效模式
//     不适用；超出 ±384 格时图外返回 1.0（视为可见）⇒ 本项只对 384 格内的近场
//     大气有效（远场泛白主要由上面那条 AP 强度本身决定）。
//   · 出厂滑杆 = 0 ⇒ 整段不执行（不查图、不追线），画面逐位旧档。
const int AP_OCCLUSION_STEPS = 6;

float clearSkyViewOcclusion(vec3 origin, vec3 direction, float distance)
{
    float d = clamp(distance, 1.0, 10000.0);
    vec3 lightDir = getTimeDrivenSkyLightDirection();
    float occluded = 0.0;
    for(int i = 0; i < AP_OCCLUSION_STEPS; ++i)
    {
        float t = (float(i) + 0.5) / float(AP_OCCLUSION_STEPS) * d;
        vec3 samplePosition = origin + direction * t;
        occluded += 1.0 - sunShadowFarVisibility(samplePosition, lightDir, i);
    }
    return occluded / float(AP_OCCLUSION_STEPS);
}

vec3 applyClearSkyAerialPerspective(
    vec3 surfaceRadiance,
    vec3 cameraOrigin,
    vec3 cameraDirection,
    float cameraDistance
)
{
    // A height-aware analytic segment.  It gives distant terrain its blue
    // atmospheric lift without a marching loop or a new temporal buffer.
    float distance = clamp(cameraDistance, 0.0, 10000.0);
    float heightDensity = clearSkyAerialHeightDensity(
        cameraOrigin, cameraDirection, distance);

    float rainStrength = getOverworldRainStrength();
    float weatherFogDensity = 1.0 + WEATHER_RF_DENSITY *
        3.0 * rainStrength * rainStrength;
    float apBaseScale = AP_BASE_EXTINCTION_SCALE +
        clamp(cam.cloudAerialParams.y, 0.0, 2.0);
    vec3 extinction = ATM_AP_BASE_EXTINCTION *
        apBaseScale * heightDensity * weatherFogDensity;
    vec3 transmittance = exp(-extinction * distance);
    vec3 inscatter = samplePhysicalClearSkyForAerialPerspective(cameraDirection);
    // #2 视线遮挡衰减：滑杆 0 ⇒ 恒不衰减（逐位旧档）。远影图未启用时 host 会往
    // binding 58 绑占位图（读出来是垃圾）⇒ 用 sunShadowFarParams.w 门控。
    float occlusionStrength = clamp(cam.cloudAerialParams.z, 0.0, 1.0);
    if(occlusionStrength > 0.001 && cam.sunShadowFarParams.w > 0.5)
    {
        inscatter *= mix(1.0,
            1.0 - clearSkyViewOcclusion(cameraOrigin, cameraDirection, distance),
            occlusionStrength);
    }
    vec3 clearWeatherResult = surfaceRadiance * transmittance +
        inscatter * (vec3(1.0) - transmittance);

    // Individual streak cards cannot resolve into the distance: they become
    // sub-pixel long before the terrain horizon.  Follow the reference pack's
    // rainy Mie extinction with a cheap analytic distance fog, evaluated once
    // after the primary hit (no volume march and no additional ray queries).
    float rainOpticalDepth = distance * rainStrength * WEATHER_RF_DENSITY *
        heightDensity * 0.0018;
    float rainFogAmount = 1.0 - exp(-rainOpticalDepth);
    // 2026-10-21 贴地雨雾：沿视线最低点（相机/落点取低者）再加一层指数薄雾，
    // 让低空的雨幕在贴地视线上更浓。rainStrength=0 时不进分支 ⇒ 晴天逐位旧档。
    if(rainStrength > 0.001)
    {
        float lowBandHeight = min(
            cameraOrigin.y,
            cameraOrigin.y + cameraDirection.y * distance);
        float lowBand = exp(-max(lowBandHeight - 58.0, 0.0) / 24.0);
        float lowBandOpticalDepth =
            distance * rainStrength * lowBand * 0.0009;
        rainFogAmount = 1.0 - (1.0 - rainFogAmount) *
            exp(-lowBandOpticalDepth);
    }
    vec3 rainFogColor = mix(
        vec3(0.34, 0.40, 0.46),
        inscatter,
        0.45
    );

    return mix(clearWeatherResult, rainFogColor, rainFogAmount);
}


// =====================================================
// 水下视角（相机在水里）。参考 waterFog* 三件套
// 吸收与散射分开算 —— 吸收是逐通道 Beer-Lambert，散射乘一个"抬头最亮"的
// 前向瓣与天光强度。
//
// 水柱长度取主射线的第一段行程就够了：向下/平视看到水底时它是相机到实心表面
// 的距离；向上看时它是相机到水面**下表面**的距离，而 rgen 顺着水面追出来的
// 空中辐亮度也穿过了这段水，两者共用一个量。唯一例外是主射线真的 miss（我们的
// TLAS 在那个方向没有几何），此时按深水兜底。
//
// 复用与水面折射完全相同的 waterAbsorptionColor()/waterScatterColor()/
// waterScatteringAmount()，所以「水色浓度」「水色倾向」两个滑杆自动管到水下 ——
// 不需要新设置项、GUI 或 UBO 通道（cameraInWater 本来就在 waterSimState.w）。
//
// 与一处刻意不同：把"天空像素"的深度换成 114514，于是抬头
// 看到的是**纯水色**，一点天空都留不下。这里按真实水柱算，贴着水面抬头仍能看见
// 亮的水面（那才是真实的 Snell 窗）；想换成那种激进观感，把
// applyUnderwaterWaterColumn() 里的 waterDistance 直接改成
// UNDERWATER_DEEP_COLUMN 即可。
// =====================================================

// 真 miss 时的兜底深度。60 格时红通道已衰减到 e^-10.8，视觉上等于全吸收。
const float UNDERWATER_DEEP_COLUMN = 60.0;
// 散射前向瓣用 g = 0.4，喂进去的是视方向的**垂直分量**而不是太阳
// 夹角：抬头最亮、低头最暗。这正是水下的观感来源。
const float UNDERWATER_SCATTER_G = 0.4;
// 用 exp(-16 * (1 - skyLight) * beta) 把夜间的散射压掉，否则水下到了
// 半夜还是亮青色。
const float UNDERWATER_NIGHT_CRUSH = 16.0;
// =====================================================
// 2026-09-30 水下视角 = 体积雾 + 体积光（用户对照参考图定档）
//
// 旧档被用户判为"太清澈"：只有一层淡淡的青绿染色，十几格外地形仍清晰可见，
// 没有雾也没有光。水下视角要的是**浓介质**，两根杠杆都在这里：
//   1) 远处沉进水色 —— 消光按通道加密。原 absorption (0.24,0.045,0.055)/格
//      的绿/蓝太弱，20 格外还有 ~40% 透过率，画面读作"清水"。这里给绿/蓝
//      各乘 2.2 倍（红保持），5 格内仍接近原色、20 格起沉进雾里。
//   2) 雾自己发光 —— 入散射乘 4。否则加密后的远处是死黑而不是"水色的雾"；
//      夜晚由 NIGHT_CRUSH 压回黑暗，月光下只剩极淡的蓝绿。
// 体积光（光柱）在 volumetric_light.comp 的水下分支，两边按来源分账：
// 水柱管天空穹顶的环境雾色，光柱管太阳/月亮的方向性光束，不重复计账。
// =====================================================
const vec3 UNDERWATER_COLUMN_EXTINCTION = vec3(1.0, 2.2, 2.0);
const float UNDERWATER_COLUMN_SCATTER_BOOST = 4.0;

// PI 在 5305 行才声明，这里用字面量（与 atmosphereMiePhase 同一做法）。
float underwaterHGPhase(float cosine, float g)
{
    float g2 = g * g;
    float denominator = max(1.0e-4, 1.0 + g2 - 2.0 * g * cosine);
    return (1.0 - g2) / (4.0 * 3.14159265359 * denominator * sqrt(denominator));
}

vec3 underwaterAbsorption(float waterDistance)
{
    // 绿/蓝消光加密（见 UNDERWATER_COLUMN_EXTINCTION 处的说明）。
    return exp(-waterDistance * waterAbsorptionColor() *
        UNDERWATER_COLUMN_EXTINCTION);
}

// skyColor 传的是**正上方**的天空辐亮度，不是视线
// 方向的天空色：内散射来自整个天穹的漫射光，用上方的值既稳又省一次方向依赖。
vec3 underwaterScatter(
    vec3 worldDirection,
    vec3 skyColor,
    float waterDistance,
    float skyLight
)
{
    // 批次3-P4（waterParams.w，0=旧档）：HPWater 物理相位 —— 5% Rayleigh
    //（β 光谱比例，散射偏蓝）+ 95% Mie（太阳/月亮方向 HG），再混 35% 常数
    // 做多次散射各向同性化（HP"透射率低→相位各向同性"的简化版）。旧档是
 // HG(视线垂直分量)：抬头亮低头暗，不随光源走。
    vec3 phase;
    if(cam.waterParams.w > 0.5)
    {
        float cosSun = dot(worldDirection, getTimeDrivenSkyLightDirection());
        float rayleigh = (3.0 / (4.0 * 3.14159265359)) * (1.0 + cosSun * cosSun);
        float mie = underwaterHGPhase(cosSun, 0.6);
        vec3 phase3 = vec3(0.18, 0.42, 1.0) * (rayleigh * 0.05) + vec3(mie * 0.95);
        phase = mix(phase3, vec3(1.0), 0.35);
    }
    else
    {
        phase = vec3(underwaterHGPhase(worldDirection.y, UNDERWATER_SCATTER_G));
    }
    vec3 scatterColor = waterScatterColor() * waterScatteringAmount() * skyLight;
    vec3 absorbed = vec3(1.0) - underwaterAbsorption(waterDistance);
    vec3 nightCrush = exp(-vec3(UNDERWATER_NIGHT_CRUSH) *
        (1.0 - skyLight) * waterAbsorptionColor());
    // 入散射增强：加密后的介质必须"雾里带光"，否则远处沉成死黑（见
    // UNDERWATER_COLUMN_SCATTER_BOOST 处的说明）。夜晚仍由 nightCrush 压制。
    return scatterColor * phase * skyColor * absorbed * nightCrush *
        UNDERWATER_COLUMN_SCATTER_BOOST;
}

vec3 applyUnderwaterWaterColumn(
    vec3 radiance,
    vec3 worldDirection,
    float hitDistance
)
{
    if(cam.waterSimState.w == 0u)
    {
        return radiance;
    }
    float waterDistance = hitDistance > 0.0
        ? min(hitDistance, 512.0)
        : UNDERWATER_DEEP_COLUMN;
    // 归一化到 0（地平线/夜）..1（正午）的天光，与云层用的 daylight 同源。
    float skyLight = clamp(
        getClearTimeDrivenSkyLightRadianceScale() / TIME_DRIVEN_SUN_NOON_SCALE,
        0.0, 1.0);
    vec3 skyColor = samplePhysicalClearSkyForAerialPerspective(vec3(0.0, 1.0, 0.0));
    return radiance * underwaterAbsorption(waterDistance) +
        underwaterScatter(worldDirection, skyColor, waterDistance, skyLight);
}


VPTDirectHistory vptReadPrimaryHistory(uint index)
{
    return cam.historyReadIndex == 0u
        ? vptDirectHistoryBuffer0.entries[index]
        : vptDirectHistoryBuffer1.entries[index];
}


void vptWritePrimaryHistory(uint index, VPTDirectHistory value)
{
    if(cam.historyReadIndex == 0u)
    {
        vptDirectHistoryBuffer1.entries[index] = value;
    }
    else
    {
        vptDirectHistoryBuffer0.entries[index] = value;
    }
}


bool vptReprojectPreviousPixel(
    vec3 worldPosition,
    ivec2 renderSize,
    out uint previousIndex
)
{
    previousIndex = 0u;
    if(cam.historyValid == 0u)
    {
        return false;
    }

    mat4 previousWorldToView = inverse(cam.prevViewInverse);
    mat4 previousViewToClip = inverse(cam.prevProjInverse);
    vec4 previousClip = previousViewToClip *
        previousWorldToView * vec4(worldPosition, 1.0);
    if(previousClip.w <= 1.0e-5)
    {
        return false;
    }

    vec2 ndc = previousClip.xy / previousClip.w;
    vec2 uv = vec2(ndc.x * 0.5 + 0.5, 0.5 - ndc.y * 0.5);
    if(any(lessThan(uv, vec2(0.0))) || any(greaterThanEqual(uv, vec2(1.0))))
    {
        return false;
    }

    ivec2 previousPixel = ivec2(floor(uv * vec2(renderSize)));
    previousPixel = clamp(previousPixel, ivec2(0), renderSize - ivec2(1));
    previousIndex = uint(previousPixel.y * renderSize.x + previousPixel.x);
    return true;
}


// =====================================================
// 2026-09-30：位置判据的帧抖动补偿
//
// 主命中位置是在**抖动后的像素中心**上求出的（rgen 用 getDLSSFrameJitter 偏移
// 像素中心），于是同一个世界点在相邻两帧记录下来的位置，天然差一个
// 「抖动差 × 该深度上一个像素的世界尺寸」。远距离时这个差会超过原判据的
// 0.35 格固定容差 ⇒ vptPrimaryHistoryMatches 逐帧假否定 ⇒ 历史反复重来。
// 这正是 2026-09-29 主路径时域复用"反而更噪"的实测原因（见 LOCAL_RIS_
// PRIMARY_TEMPORAL 处的记载），也是本轮"移动就脏"要修掉的那一环。
//
// 补偿量按抖动差与该点视深放大，判据本身（世界位置 + 法线）不动：
// 抖动量级只有亚像素，所以近处补偿≈0，100+ 格处才有几十分之一格。
// VPT_SCREEN_JITTER_MATCH_PIXELS 是给"上一帧条目取自最近像素"留的余量：
// 重投影落点做 floor() 后取到的那一格，最远与本像素差 ~0.7 个渲染像素，
// 斜面上折算成世界位移就有量级相当的一格；调大可进一步压噪，但远处更容易
// 接受错误历史（拖影/横向糊），调小会回到"假否定逐帧翻转"。
// =====================================================
#ifndef VPT_SCREEN_JITTER_MATCH_PIXELS
#define VPT_SCREEN_JITTER_MATCH_PIXELS 0.75
#endif

// Defined far below (next to the Halton helpers); declared here because this
// early history helper needs it (GLSL single-pass compilation).
vec2 getDLSSFrameJitter(uint frameIndex);

float vptJitterCompensatedPositionEpsilon(vec3 hitPosition)
{
    vec2 jitterCurrent =
        getDLSSFrameJitter(cam.frameCount);

    // 上一帧：抖动序列按 frameIndex % 32 循环，用 +31 走"上一相位"，
    // 与宿主 GetDLSSFrameJitter(frameIndex) 同源（宿主的 frameCount 是 uint32，
    // 这里的 cam.frameCount 同源）。
    vec2 jitterPrevious =
        getDLSSFrameJitter(cam.frameCount + 31u);

    float jitterPixels = max(
        abs(jitterCurrent.x - jitterPrevious.x),
        abs(jitterCurrent.y - jitterPrevious.y)
    );

    // 一个渲染像素在该视深上的世界尺寸：focalPixels = H / (2 tan(fov/2))。
    float focalPixels =
        float(rtLaunchSize().y) /
        (2.0 * max(tan(cam.cameraParams.z * 0.5), 0.05));

    // 相机前向 = -Z（viewInverse 是 camera->world，与宿主 cameraFwd 同约定）。
    vec3 cameraForward =
        normalize(-cam.viewInverse[2].xyz);

    float hitViewDepth =
        max(dot(hitPosition - cam.viewInverse[3].xyz, cameraForward), 0.0);

    return
        VPT_SCREEN_POSITION_EPSILON +
        (jitterPixels + VPT_SCREEN_JITTER_MATCH_PIXELS) *
        hitViewDepth /
        max(focalPixels, 1.0);
}

bool vptPrimaryHistoryMatches(
    VPTDirectHistory history,
    vec3 hitPosition,
    vec3 hitNormal,
    float positionEpsilon
)
{
    return history.hitPositionAndValid.w > 0.5 &&
        // 2026-10-26：WRS reservoir 条目在 v1.w 写 2.0；EMA 只认 < 1.5。
        // 模式 0 下历史里全是 EMA 条目（w = 1.0），该判据不改变任何结果。
        history.hitPositionAndValid.w < 1.5 &&
        history.radianceAndSampleCount.w > 0.0 &&
        length(history.hitPositionAndValid.xyz - hitPosition) <= positionEpsilon &&
        dot(normalize(history.normalAndPadding.xyz), hitNormal) >= VPT_SCREEN_NORMAL_COSINE;
}


vec3 evaluateVPTPrimaryTemporal(
    vec3 hitPosition,
    vec3 hitNormal,
    vec3 hitAlbedo,
    vec3 direction,
    inout uint rngState,
    ivec2 pixelCoord,
    ivec2 renderSize
)
{
    uint currentIndex = uint(pixelCoord.y * renderSize.x + pixelCoord.x);
    uint previousIndex = 0u;
    VPTDirectHistory previousHistory;
    bool reuseHistory = vptReprojectPreviousPixel(
        hitPosition,
        renderSize,
        previousIndex
    );
    if(reuseHistory)
    {
        previousHistory = vptReadPrimaryHistory(previousIndex);
        reuseHistory = vptPrimaryHistoryMatches(
            previousHistory,
            hitPosition,
            hitNormal,
            vptJitterCompensatedPositionEpsilon(hitPosition)
        );
    }

    uint phase = uint(pixelCoord.x & 1) | (uint(pixelCoord.y & 1) << 1u);
    bool traceCandidate = !reuseHistory || phase == (cam.frameCount & 3u);

    vec3 filteredRadiance = reuseHistory
        ? previousHistory.radianceAndSampleCount.rgb
        : vec3(0.0);
    float sampleCount = reuseHistory
        ? previousHistory.radianceAndSampleCount.w
        : 0.0;

    if(traceCandidate)
    {
        vec3 candidateRadiance = evaluateVPTPrimaryIndirect(
            hitPosition,
            hitNormal,
            hitAlbedo,
            direction,
            rngState
        );
        float nextCount = min(sampleCount + 1.0, VPT_SCREEN_MAX_HISTORY);
        float alpha = reuseHistory ? (1.0 / nextCount) : 1.0;
        filteredRadiance = mix(filteredRadiance, candidateRadiance, alpha);
        sampleCount = nextCount;
    }

    VPTDirectHistory outputHistory;
    outputHistory.radianceAndSampleCount = vec4(filteredRadiance, sampleCount);
    outputHistory.hitPositionAndValid = vec4(hitPosition, 1.0);
    outputHistory.normalAndPadding = vec4(hitNormal, 0.0);
    vptWritePrimaryHistory(currentIndex, outputHistory);
    return filteredRadiance;
}

// =====================================================
// Transparent receivers get the same screen-space history as an opaque one.
//
// A path that was retraced through a pane
// (tracePrimaryGenericTransparentRadiance) or through the water transport
// (tracePrimaryTransparentRadiance) cannot write the primary G-buffer, so its
// direct-light term never reaches NRD.  Until now those call sites used the
// bare evaluateVPTRISDirectLighting and therefore kept the raw 1-spp RIS
// estimate -- white noise with no temporal average behind it.  That is the
// "everything behind glass is noisy" symptom: the opaque pixel next to it is
// averaged over VPT_SCREEN_MAX_HISTORY frames, the pane's pixel is not, while
// both are written into the same HDR buffer and upscaled by the same DLSS
// pass.
//
// The history contract already protects this: vptPrimaryHistoryMatches()
// rejects the previous entry unless BOTH the receiver world position and the
// receiver normal agree, so a pixel that alternates between a pane receiver
// and its own opaque hit can never blend the two.
//
// -DGI_TRANSPARENT_RECEIVER_TEMPORAL=0 restores the bare 1-spp estimate, which
// is the A/B baseline for measuring what the temporal average buys back.
// =====================================================
#ifndef GI_TRANSPARENT_RECEIVER_TEMPORAL
#define GI_TRANSPARENT_RECEIVER_TEMPORAL 1
#endif

// =====================================================
// 2026-09-30：玻璃/水后面接收面的直射历史长度
//
// 为什么单独给这一条路径加长，而不动 VPT_SCREEN_MAX_HISTORY(8)：
//   - 不透明主命中的直射是 1spp，但它的**时域平均来自 DLSS-RR**（长历史 +
//     空间核），实测"本地光没有任何噪点"，所以那条路径一个字都不用改。
//   - 透明接收面走的是完全不同的通道：它写不进主 G-buffer，RR 拿到的是一条
//     折线路径的内容，能真正累积它的只有这份 rgen 世界空间历史 ⇒ 原来 8 帧
//     的上限就是"玻璃里的噪点"的**全部**样本数。8 帧把 1spp 白噪声只压到
//     1/sqrt(8)≈0.35，静止时 RR 还能再叠一层于是看起来干净，相机一动 RR 那层
//     失效，剩下的正好回到 0.35 倍 ⇒「静止能压住、移动就冒噪点」。
//   - 历史用**世界位置 + 法线**做匹配（vptPrimaryHistoryMatches），所以加长
//     不产生拖影：同一个世界点从不同屏幕像素取回同一条历史；换成别的接收面
//     时判据直接拒绝并重置。
// 8 → 64：噪声降到 1/sqrt(64)≈0.125（相对现在约 1/2.83），代价是光照变化后
// 的收敛时间约 1 秒（60fps），静态场景无感。
//
// 2026-09-30 用户侧实测：玻璃里的噪点"采样数和候选怎么调都还在" ⇒ 它根本
// 不是这份估计器的方差（调采样数/候选数都动不了它），历史长度也就无从改善。
// 该测量把 8→64 一并退回，基线回归 8；嫌疑转向**与采样无关的确定性来源**
// （烘焙查表，见 GI_GLASS_REFLECTION_LEGACY 处的记载）。
//
// A/B：-DVPT_TRANSPARENT_HISTORY_FRAMES=8 回到短历史。
//
// 2026-10-01 第二步（现在才真正生效）：8 -> 48。
// 当时把 8 抬到 64 之所以"毫无改善"，原因已经查明并经修复：那份世界空间历史的
// **键**用的是接收面位置，而相机是**穿过折射**看到接收面的，它的针孔投影并不落在
// 同一个像素上 ⇒ 位置判据恒不成立 ⇒ 历史逐帧被拒、从未复用 ⇒ 抬长度当然没有
// 任何效果（复用的是 0 个条目）。现在键已改成"主射线在玻璃面上的原始交点"
// （VPT_TRANSPARENT_HISTORY_KEY），判据精确成立，历史第一次真的在累积，
// 长度才第一次有意义：8 -> 48 把这份内容的方差再降到 1/sqrt(48)≈0.144
// （相对 8 帧的 0.354 约 2.45 倍），代价是光照变化后的收敛约 0.8 秒（60fps）。
//
// 为什么这是治"均匀残留颗粒"的正解：这份内容写不进主 G-buffer，RR 拿不到它的
// 表面记录，它的时域平均**只有**这一份 rgen 历史；RR 只能在空间上再帮一层。
// =====================================================
// 2026-10-24：48 -> 96。这是"透过玻璃/水看到的接收面"唯一的时域平均，残余方差
// 1/sqrt(N)：48 帧 ≈14%、96 帧 ≈10%。本地光发射体（火把等）静态，长历史没有
// 拖影代价；动态光源不走这份历史（evaluateDynamicLightRISDirect 每帧现算）。
// 与 VPT_TRANSPARENT_RECEIVER_RIS_SAMPLES=4 相乘，总残余约为此前的 1/2.9。
// 代价：玻璃后光照突变（放/拆火把）的收敛约 1.6 秒（60fps）。
// A/B：-DVPT_TRANSPARENT_HISTORY_FRAMES=48 回到上一档。
#ifndef VPT_TRANSPARENT_HISTORY_FRAMES
#define VPT_TRANSPARENT_HISTORY_FRAMES 96.0
#endif


// =====================================================
// 2026-09-30：透明接收面历史的**键**
//
// 之前的键是接收面自己的世界位置。对"相机看穿玻璃"这件事它是错的：像素 p 看到
// 的接收面 W 是**折射后**的结果，W 的针孔投影落在 q ≠ p（差量 ≈ 玻璃厚度 ×
// 折射横移，屏幕上常有数像素）。用 W 重投影取到的上一帧条目 q，存的是 q 自己
// 那条透射射线的接收面 W_q ≠ W ⇒ 位置判据 length(W_q - W) > ε 恒不成立 ⇒
// **历史逐帧被拒、从未复用**，这份内容的时域平均实际上是 0 帧，永远是 1spp。
// 这一条同时解释了用户报的四件事：
//   · 玻璃里的均匀白噪（就是 1spp 直射噪声本身）；
//   · "采样数和候选怎么调都还在"（RIS 候选数不改变每帧 1 个样本的方差，
//     而加长历史没有条目可复用 ⇒ 8→64 也毫无改善）；
//   · 静止被 DLSS-RR 的时域压住、相机一动就回来；
//   · 有阳光照射时看不见（太阳项把这份噪声压成相对很小）。
//
// 键改用**透明面自身**的命中点：普通几何面，针孔重投影精确；而且同一个玻璃面
// 点唯一决定它后面的接收面 ⇒ 取回的上一帧条目就是同一个接收面。接收面法线判据
// 保留，用来拒绝"玻璃面同点但接收面变了"（视向变化引起的内部视差）。
//
// A/B：-DVPT_TRANSPARENT_HISTORY_KEY=0 回到"用接收面位置当键"（即上述失效态）。
// =====================================================
#ifndef VPT_TRANSPARENT_HISTORY_KEY
#define VPT_TRANSPARENT_HISTORY_KEY 1
#endif

// =====================================================
// 2026-10-18：透明接收面历史判据必须与写入端同源（修"玻璃里的噪点"老问题）
//
// 写入端（evaluateVPTCandidateDirectTemporal 末尾的 outputHistory）存的是
// **接收面**的世界位置 hitPosition；而 VPT_TRANSPARENT_HISTORY_KEY=1 时重投影
// 键 matchPosition 是第一层透明面（玻璃/水面）的命中点。旧判据拿"上一帧的接收面
// 位置"去比"本帧的透明面位置"——除非接收面就贴在玻璃上（< 0.35 格），这个差
// 恒大于容差 ⇒ positionOk 每帧为假 ⇒ 历史每帧清零 ⇒ 玻璃/水后面的本地光恒为
// 1 spp 白噪声。这同时解释了用户侧"采样数/候选数怎么调都不动、加长历史也没用"。
//
// 重投影仍用透明面点（它才精确落在本像素）；身份判据改比接收面↔接收面 ——
// 与不透明主路径 vptPrimaryHistoryMatches 的口径一致。
// A/B：-DVPT_TRANSPARENT_HISTORY_RECEIVER_MATCH=0 ⇒ 逐位回到旧口径。
// =====================================================
#ifndef VPT_TRANSPARENT_HISTORY_RECEIVER_MATCH
#define VPT_TRANSPARENT_HISTORY_RECEIVER_MATCH 1
#endif

// =====================================================
// 2026-10-17：多层（≥2 个）透明面之后，历史键必须是**相机可见的第一层**
//
// VPT_TRANSPARENT_HISTORY_KEY 把键从"接收面位置"改成"透明面自身的命中点"，
// 理由是：键点的针孔投影必须精确落在本像素上。该修复只覆盖了"一层"的调用点
// —— 那里 startOrigin 恰好就是相机射线打到的第一层透明面。
//
// 嵌套路径没有跟上：玻璃后撞到水面时，玻璃分支把**水面命中点**当 startOrigin
// 传进水体走查，走查又拿它当历史键。水面在玻璃后面、位置还带折射横移 ⇒ 它的
// 投影落在**别的像素**上 ⇒ vptReprojectPreviousPixel 取回的是那个像素上一帧的
// 条目，位置判据恒失败 ⇒ 历史长度恒为 0 ⇒ 接收面本地直射退回 1spp 白噪声。
// 现象正是"透过一层没事，透过两层/三层就出现噪点"。
//
// 本开关把**第一层透明面的原始命中点**一路带进水体走查，作为唯一的历史键；
// 它与 VPT_TRANSPARENT_HISTORY_KEY 的原始论据一致：同一个第一层表面点唯一
// 决定它后面那条链的接收面。
// A/B：-DTRANSPARENT_HISTORY_KEY_FIRST_SURFACE=0 ⇒ 逐位回到"用 startOrigin"。
// =====================================================
#ifndef TRANSPARENT_HISTORY_KEY_FIRST_SURFACE
#define TRANSPARENT_HISTORY_KEY_FIRST_SURFACE 1
#endif

// 身份判据用哪种法线（见 evaluateVPTCandidateDirectTemporal 的 matchNormal）：
//   1 = 接收面的**几何面法线**（同一面上恒定，判据只拒绝真正换面）
//   0 = 接收面的着色法线（带浮雕/POM 扰动 ⇒ 按纹理图案反复假否定）
// A/B：-DVPT_TRANSPARENT_HISTORY_GEOM_NORMAL=0
#ifndef VPT_TRANSPARENT_HISTORY_GEOM_NORMAL
#define VPT_TRANSPARENT_HISTORY_GEOM_NORMAL 1
#endif

// =====================================================
// 2026-10-01（探针实测驱动）：玻璃片的历史身份判据改用**玻璃面自身的法线**
//
// 色码探针在用户的场景上给出的读数：
//   · 大片**白**（复用成功、已积满 48 帧）—— 正常；
//   · 一块**与玻璃后内容同形**的**黄**（复用成功但计数短：< 0.9*48）—— 就是
//     用户看到的"玻璃里的均匀颗粒"：这些像素的历史**反复被打断**，长期停在小
//     几个样本上，等效 1~3 spp；
//   · **绿**的细线（法线判据失败）出现在内容边棱上 —— 证实这条判据确实在拒历史。
//
// 为什么"用接收面法线做身份判据"对玻璃片是错的：键已经换成**玻璃面自身的点**
// （见 VPT_TRANSPARENT_HISTORY_KEY），而玻璃面上一个点**唯一决定**它后面的接收面，
// 所以"接收面身份"这一层判据在几何上是多余的；它唯一在做的事，是把"隔着玻璃的
// 亚像素抖动在远处放大成换了一格面"读成换面并逐帧拒史 —— 越是有棱有面的内容
// （也就是越噪的那块）越容易触发。玻璃面自身是静止几何，法线在整片内恒定，
// 只在像素真的换到另一片玻璃/水面时才拒绝。
//
// 水路径不吃这个改动（water 的调用点不写这份法线 ⇒ 保持旧行为），因为水面法线
// 本身随波浪起伏。
//
// A/B：-DVPT_TRANSPARENT_HISTORY_PANE_NORMAL=0 回到"接收面（几何）法线"。
// =====================================================
#ifndef VPT_TRANSPARENT_HISTORY_PANE_NORMAL
#define VPT_TRANSPARENT_HISTORY_PANE_NORMAL 1
#endif

// 透明面自身的法线，由玻璃调用点写入（raygen 全局 = per-invocation）。
// vec3(0) = 没有这份信息 ⇒ 判据回落到旧行为。
vec3 vptTransparentSurfaceNormal = vec3(0.0);

// =====================================================
// 2026-10-01（第二次探针实测驱动）：法线判据失败 ⇒ **按帧衰减**，不再硬清零
//
// 色码探针在放大近看时的读数：玻璃区是**黄底 + 白色细点**，没有红/青/蓝/绿。
//   黄 = 位置判据通过、计数短（< 0.9*48）；白 = 计数已到顶。
// 也就是说：这些像素的历史**每一帧都通过位置判据、也在复用**，但计数长期攒不满
// ⇒ 存在**间歇性**的失败（失败那一帧计数被砸回 1，之后要 43 帧连续成功才回到顶）。
// 位置判据通过 = 同一个世界点、同一片几何；此时把整份历史扔掉是过度反应，正确做法
// 是按帧衰减（丢失几帧的权重，而不是全部）。
//
// 位置判据**失败**仍然硬清零：那才是真的换面/换像素（视差断层、相机切面）。
//
// 0.5 ⇒ 每失败一帧保留一半样本权重（等效"每两帧丢一帧的权重"），连续失败约 5~6 帧
// 就衰减到 1 以下，与硬清零几乎无异 ⇒ 不会引入拖影。
//
// A/B：-DVPT_TRANSPARENT_HISTORY_NORMAL_DECAY=0 回到硬清零。
// =====================================================
#ifndef VPT_TRANSPARENT_HISTORY_NORMAL_DECAY
#define VPT_TRANSPARENT_HISTORY_NORMAL_DECAY 0.5
#endif

// =====================================================
// 2026-10-17：玻璃光学总开关的默认值集中到文件前部
//
// 这两个宏原先各自声明在使用点附近，而染料块
// （tracePrimaryGenericTransparentRadiance，约 14590）在同一文件的**更早**
// 位置就要判断它们。预处理器按顺序展开 ⇒ 使用点之后的 #define 对前面的
// #if 不可见，会静默走错分支。默认值统一放在这里，使用点只留 #if 与注释。
// =====================================================
#ifndef GI_GLASS_DIELECTRIC
#define GI_GLASS_DIELECTRIC 1
#endif
#ifndef GI_GLASS_WALK
#define GI_GLASS_WALK 1
#endif

// =====================================================
// 2026-10-01（用户指出的方向）：玻璃片不吃 POM / 浮雕位移
//
// 玻璃片上那份"内部折射"是用纹理浮雕高度做的 POM 位移，它是**逐 texel 量化**
// 的：视向一动，采到的 texel 一翻，透过玻璃看到的那一面（接收面）就整体跳一格。
// 于是玻璃上出现与玻璃纹理**同形**、且只跟着本地直射光走的颗粒（太阳面被
// shadowTransmittance 压掉，所以"有阳光就没噪点"），采样数/候选数怎么调都动
// 不了它 —— 它不是采样噪声，是这份量化位移。
// 置 0 后玻璃面的命中点回到**纯几何交点**：所有下游（历史键、RR 深度、
// 透射起点）都不再带纹理量化的跳变。
//
// 1 = 保留（旧行为）；A/B：-DGI_GLASS_PANE_POM=1
// =====================================================
#ifndef GI_GLASS_PANE_POM
#define GI_GLASS_PANE_POM 0
#endif

// =====================================================
// 2026-10-01：玻璃/水后面那份内容的 RR guide 粗糙度下限
//
// 用户要求"顺便让 RR 处理试试"。guide 粗糙度决定 DLSS-RR 空间核半径：下限抬高
// ⇒ 核更宽 ⇒ 透过玻璃的那份内容被 RR 平均得更狠（代价：玻璃里内容变软）。
// 0.2 = 原 RR_GUIDE_ROUGHNESS_FLOOR（通用下限）。
// A/B：-DGI_GLASS_RR_ROUGHNESS_FLOOR=0.2
//
// 2026-10-01 第二步：0.2 -> 0.35 -> **0.7**。
// 位置量化那条线（POM 假折射）已经拔掉，玻璃里剩下的只有"均匀颗粒"。它是 1spp
// 级别的残留，唯一还能吃它的就是 RR 的空间核，而核半径由 guide 粗糙度决定
// （本文件自己的注释就写着 RR 的 roughness->radius 映射"widens quickly"）。
// 0.35 实测不够 ⇒ 直接抬到 0.7 做一次**方向性**确认：
//     用邻居法线放宽核半径"的定向版本，把全局柔化收回去；
//   * 颗粒纹丝不动 ⇒ 噪声不在 RR 的平滑里，转回历史复用/端点平面那条线。
// 代价：透过玻璃看到的内容更软（可回退）。
// =====================================================
#ifndef GI_GLASS_RR_ROUGHNESS_FLOOR
#define GI_GLASS_RR_ROUGHNESS_FLOOR 0.2
#endif


// =====================================================
// 2026-09-30：玻璃历史复用探针（诊断视图，不是画面）
//
// 目的：一次运行回答"玻璃后面那份直射的时域历史到底有没有被复用"。它是
// 「采样数/候选怎么调都不动」的唯一自洽解释之一：如果历史从未复用，那份直射
// 就永远是 1spp，任何采样数/候选/历史长度都无从改善。
//
// 玻璃像素被涂成：
//   R 恒为 1（底色，保证 RR 混合后红/黄可辨）
//   G = 0                  ⇒ 本帧**没有**复用历史（1spp）        ⇒ 偏红
//   G = 0.5 + 0.5*N/上限   ⇒ 复用了，越白历史越长                ⇒ 偏黄→白
//   B = 1                  ⇒ cam.historyValid = 1（外闸通过）
//   读到的像素若不是玻璃后可到达的接收面（没有这一项）就保持正常画面。
//
// 默认 0；本版为诊断特意置 1。
// =====================================================
// ⚠️ 2026-10-01 已跑完，默认回到 0。这一轮的诊断结论（留给下一次查同类问题）：
//
// 1) 先跑"旧口径"（R=1，G=复用深度，B=historyValid）：玻璃区是**大片白 + 与玻璃后
//    内容同形的品红块** ⇒ 复用是通的，坏的是那一块像素的历史撑不起来。
// 2) 换成**自解释色码**后确认：没有红（位置判据失败）/青（historyValid=0）/蓝
//    （重投影失败），只有绿（**法线判据失败**）—— 且后来放大近看只剩"黄底+白细点"：
//    位置判据一直通过、在复用，但计数长期 **<= 0.9*上限** ⇒ 失败是**间歇性**的，
//    而每一次失败都把计数砸回 1（要 43 帧连续成功才能回顶）⇒ 等效 1~3 spp 的颗粒。
// 3) 两处修复（都在本文件，开关见各自注释）：
//    · VPT_TRANSPARENT_HISTORY_PANE_NORMAL：玻璃片身份判据改用**玻璃面自身**法线
//      （键已是玻璃面自身的点，接收面由它唯一决定）⇒ 绿线基本消失；
//    · VPT_TRANSPARENT_HISTORY_NORMAL_DECAY：位置判据通过时，法线失败只**按帧衰减**
//      不清零 ⇒ 黄色块**全部转白**（用户实测确认），计数第一次爬到满 48 帧。
//
// 本探针的色码：青=historyValid=0 / 蓝=重投影失败 / 红=位置判据失败 /
// 绿=法线判据失败 / 黄=复用中未满 / 白=已满。
#ifndef DBG_GLASS_HISTORY_PROBE
#define DBG_GLASS_HISTORY_PROBE 0
#endif

// 每个像素一份（raygen 全局变量是 per-invocation），未设时 x < 0。
vec3 dbgGlassHistoryProbe = vec3(-1.0, 0.0, 0.0);
bool dbgGlassHistoryProbeWanted = false;


// GLSL needs this before the wrapper below; the definition follows it.
vec3 evaluateVPTCandidateDirectTemporal(
#if VPT_TRANSPARENT_HISTORY_KEY
    vec3 historyKeyPosition,
#endif
    vec3 hitPosition,
    vec3 hitNormal,
    vec3 hitAlbedo,
    vec3 receiverGeometricNormal,
    ivec2 pixelCoord,
    ivec2 renderSize
);


// One entry point for every receiver reached through glass or water, so the
// three call sites cannot drift apart the way the sun-march / camera-path
// pane splits once did.
vec3 evaluateTransparentReceiverDirectLighting(
    // The transparent surface's own hit point (pane / water surface).  Used as
    // the history key -- see VPT_TRANSPARENT_HISTORY_KEY.  The receiver's own
    // world position cannot be used for that: the camera reaches it through
    // refraction, so its pinhole projection is NOT the pixel it is seen at.
    vec3 transparentSurfacePosition,
    // Geometric face normal of the receiver (NOT the relief/POM shading normal).
    // Passed straight into the local-light RIS so its cosine cannot see past the
    // geometric horizon -- the same bound the opaque primary path already uses
    // (see VPT_LOCAL_GEOMETRIC_COSINE_BOUND).  vec3(0) keeps the old behaviour.
    vec3 receiverGeometricNormal,
    vec3 hitPosition,
    vec3 hitNormal,
    vec3 hitAlbedo,
    uint risSeedSalt
)
{
#if GI_TRANSPARENT_RECEIVER_TEMPORAL
#if GI_HALFRES
    // 2026-10-31（第六轮）：gi_half 变体的 gl_LaunchIDEXT 是半分辨率坐标，
    // 而 26/27 历史按**全分辨率像素**索引 —— 这里若走时域，会把被着色像素
    // (2i,2j) 的 pane/水面历史写进 (i,j) 槽位：键必然失配（历史永久重置），
    // 还会把主变体 (i,j) 的历史槽位覆盖成错误表面的数据（玻璃/水面椒盐噪点
    // 的根因之一，与玻璃 G-buffer 写入的坐标腐蚀同源）。退回单帧 RIS：
    // 无历史读写，时域由主变体独占。
    uint giHalfRisSeed =
        uint(gl_LaunchIDEXT.x) * 1973u +
        uint(gl_LaunchIDEXT.y) * 9277u ^
        cam.frameCount * 26699u;
    pcg_hash(giHalfRisSeed);
    return evaluateVPTRISDirectLighting(
        hitPosition,
        hitNormal,
        hitAlbedo,
        receiverGeometricNormal,
        vec3(-1.0), -1.0, 1.0,
        giHalfRisSeed);
#else
    // The salt is unused here: reuse is decided by the history match on the
    // receiver's own world position and normal, not by keeping two sample
    // streams apart.
    return evaluateVPTCandidateDirectTemporal(
#if VPT_TRANSPARENT_HISTORY_KEY
        transparentSurfacePosition,
#endif
        hitPosition,
        hitNormal,
        hitAlbedo,
        receiverGeometricNormal,
        ivec2(gl_LaunchIDEXT.xy),
        ivec2(rtLaunchSize())
    );
#endif
#else
    // The pre-2026-09-25 stream, kept bit-exact so -D...TEMPORAL=0 is a true
    // A/B: the water call sites pass 0x57424F54u so the receiver never shares
    // the opaque pixel's sample sequence.
    uint risSeed =
        uint(gl_LaunchIDEXT.x) * 1973u +
        uint(gl_LaunchIDEXT.y) * 9277u ^
        cam.frameCount * 26699u ^
        risSeedSalt;
    pcg_hash(risSeed);
    // 这条时域缓存路径（LOCAL_RIS_PRIMARY_TEMPORAL，出厂关）拿不到材质 ⇒ 哨兵。
    return evaluateVPTRISDirectLighting(
        hitPosition,
        hitNormal,
        hitAlbedo,
        receiverGeometricNormal,
        vec3(-1.0), -1.0, 1.0,
        risSeed
    );
#endif
}


// VPT-3.3C.4: reuse the existing world-space reprojection contract for the
// direct area-light integral.  Every valid pixel traces all 48 current-frame
// DDA paths; history only combines distinct deterministic sample groups.
vec3 evaluateVPTCandidateDirectTemporal(
#if VPT_TRANSPARENT_HISTORY_KEY
    vec3 historyKeyPosition,
#endif
    vec3 hitPosition,
    vec3 hitNormal,
    vec3 hitAlbedo,
    vec3 receiverGeometricNormal,
    ivec2 pixelCoord,
    ivec2 renderSize
)
{
#if VPT_TRANSPARENT_HISTORY_KEY
    // 键 = 透明面自身的命中点（针孔重投影精确）。见 VPT_TRANSPARENT_HISTORY_KEY。
    vec3 matchPosition = historyKeyPosition;
#else
    vec3 matchPosition = hitPosition;
#endif

    // Identity normal for the history match.
    //
    // The receiver's shading normal carries its relief (POM) perturbation, and
    // the per-texel refraction displacement inside the pane flips which texel is
    // sampled every frame.  Testing that normal therefore false-negatives in the
    // *relief's own pattern*: measured on the probe, only ~44-57% of glass pixels
    // reached the full 8-frame history, the rest kept resetting between 1 and 6.
    // The receiver's GEOMETRIC face normal is constant across one face, so the
    // match only rejects a genuine face change.  vec3(0) (caller has no
    // geometric normal) falls back to the shading normal = old behaviour.
#if VPT_TRANSPARENT_HISTORY_GEOM_NORMAL
    vec3 matchNormal =
        dot(receiverGeometricNormal, receiverGeometricNormal) > 0.25
            ? normalize(receiverGeometricNormal)
            : normalize(hitNormal);
#else
    vec3 matchNormal = hitNormal;
#endif

#if VPT_TRANSPARENT_HISTORY_PANE_NORMAL
    // 玻璃片专用：键是玻璃面自身的点，它唯一决定后面的接收面 ⇒ 身份判据改用
    // **玻璃面**的法线（静止几何面、整片恒定）。用接收面法线做判据时，隔着玻璃的
    // 亚像素抖动在远处放大成"换了一格面"，判据逐帧假否定，历史长期停在小样本上
    // —— 探针实测的黄色块（短历史、与背后内容同形）正是它。见
    // VPT_TRANSPARENT_HISTORY_PANE_NORMAL 处的完整记载。
    if(dot(vptTransparentSurfaceNormal, vptTransparentSurfaceNormal) > 0.25)
    {
        matchNormal = normalize(vptTransparentSurfaceNormal);
    }
#endif

    uint currentIndex = uint(pixelCoord.y * renderSize.x + pixelCoord.x);
    uint previousIndex = 0u;
    // 2026-10-01：拆成两级判据分别记录，专门给 DBG_GLASS_HISTORY_PROBE 用
    // （语义与原来的 vptPrimaryHistoryMatches 完全一致：valid && count>0 &&
    //  位置在容差内 && 法线夹角通过）。探针需要知道**是哪一级**失败的 —— 探针
    // 实测显示玻璃上大片像素能积累到满帧（白），但另有一块**形状跟玻璃后内容一致**
    // 的像素逐帧被拒、永远停在 1spp（品红），那块就是用户看到的"均匀颗粒"。
    bool reprojectOk = vptReprojectPreviousPixel(
        matchPosition, renderSize, previousIndex
    );
    bool positionOk = false;
    bool normalOk = false;
    VPTDirectHistory previousHistory;
    bool reuseHistory = reprojectOk;
    if(reuseHistory)
    {
        previousHistory = vptReadPrimaryHistory(previousIndex);
        // 身份判据必须与写入端存的是同一个量。写入端存接收面 hitPosition；
        // 重投影键 matchPosition 在 VPT_TRANSPARENT_HISTORY_KEY=1 时是透明面
        // （玻璃/水面）——拿它去比接收面位置恒失败。见上方宏的完整记载。
        vec3 identityPosition =
#if VPT_TRANSPARENT_HISTORY_RECEIVER_MATCH
            hitPosition;
#else
            matchPosition;
#endif
        positionOk =
            previousHistory.hitPositionAndValid.w > 0.5 &&
            // 2026-10-26：排除 WRS reservoir 条目（v1.w = 2.0），模式切换后
            // 不会把灯样本误当成 EMA 辐射度。模式 0 下 w 恒为 1.0。
            previousHistory.hitPositionAndValid.w < 1.5 &&
            previousHistory.radianceAndSampleCount.w > 0.0 &&
            length(previousHistory.hitPositionAndValid.xyz - identityPosition) <=
                vptJitterCompensatedPositionEpsilon(identityPosition);
        normalOk =
            dot(normalize(previousHistory.normalAndPadding.xyz), matchNormal) >=
            VPT_SCREEN_NORMAL_COSINE;
        reuseHistory = positionOk && normalOk;
    }

    uint temporalSeed = uint(pixelCoord.x) * 1973u +
        uint(pixelCoord.y) * 9277u ^ cam.frameCount * 26699u;
    // The receiver's geometric face normal rides along so the local-light cosine
    // is bounded by the real face (relief texels tilted past the horizon no
    // longer light up).  vec3(0) = old behaviour.
    // 2026-10-07：透明接收路径拿不到材质 ⇒ 哨兵（移动光源退回纯 Lambert）。
    // 2026-10-24：改走多样本变体（见 evaluateVPTRISDirectLightingMultiSample 处
    // 的完整推导）—— 本函数是它的唯一消费者；rngState 链式推进，样本相互独立。
    vec3 currentRadiance = evaluateVPTRISDirectLightingMultiSample(
        hitPosition, hitNormal, hitAlbedo, receiverGeometricNormal,
        temporalSeed
    );

#ifndef VPT_TRANSPARENT_FIREFLY_CLAMP
#define VPT_TRANSPARENT_FIREFLY_CLAMP 1
#endif
#if VPT_TRANSPARENT_FIREFLY_CLAMP
    // =====================================================
    // 2026-10-24：火萤钳制（修"静止时玻璃上/后的孤立亮点"）。
    //
    // 2026-09-25 消融对同形症状（"sparse bright specks behind glass"）的结论：
    // 孤立亮点 = 大方差估计量的**重尾样本**，不是滤波/引导问题。多样本（4）
    // 把方差压了 2 倍（用户实测"变少了"），但重尾仍在：RIS 选中"半遮挡的亮
    // 发射体"时，该帧样本远超均值，进历史后被 EMA 拉成一串缓慢衰减的亮点，
    // 静止时尤其显眼（DLSS-RR 把它当信号反复平均）。
    //
    // 这里把当帧样本的亮度钳到**历史均值的 8 倍**：静态火把场景几乎无偏
    // （真实直射不会跳到 8 倍均值以上并停住），而重尾直接消失。三个护栏：
    //   · 只在位置判据通过（同一接收面）时钳 —— 此时历史均值才有意义；
    //   · 历史计数 < 4 或历史亮度 <= 1e-3 时不钳（均值未立起/纯黑起点，
    //     否则 8×0=0 会把第一盏灯永久压黑）；
    //   · 只压亮度标量，不动色度方向。
    // 代价：玻璃后光照真跳变（放一盏更亮的灯）的收敛慢几帧（钳顶逐帧让位）。
    // A/B：-DVPT_TRANSPARENT_FIREFLY_CLAMP=0 回到无钳制。
    // =====================================================
    if(reprojectOk && positionOk &&
        previousHistory.radianceAndSampleCount.w >= 4.0)
    {
        float historyLuma =
            dot(
                max(previousHistory.radianceAndSampleCount.rgb, vec3(0.0)),
                vec3(0.2126, 0.7152, 0.0722)
            );
        if(historyLuma > 1.0e-3)
        {
            float sampleLuma =
                dot(
                    max(currentRadiance, vec3(0.0)),
                    vec3(0.2126, 0.7152, 0.0722)
                );
            float fireflyCeiling =
                8.0 * historyLuma;
            if(sampleLuma > fireflyCeiling)
            {
                currentRadiance *= fireflyCeiling / sampleLuma;
            }
        }
    }
#endif

    // 历史携带量（见 VPT_TRANSPARENT_HISTORY_NORMAL_DECAY）：
    //   位置判据通过 + 法线通过 ⇒ 全额携带；
    //   位置判据通过 + 法线失败 ⇒ 按比例衰减（间歇失配不该扔掉整份历史）；
    //   位置判据失败（或不可重投影）⇒ 0 ⇒ 硬清零（真换面）。
    float carriedCount = 0.0;
    if(reprojectOk && positionOk)
    {
        carriedCount = previousHistory.radianceAndSampleCount.w *
            (normalOk ? 1.0 : VPT_TRANSPARENT_HISTORY_NORMAL_DECAY);
    }
    float oldCount = carriedCount;
#if DBG_GLASS_HISTORY_PROBE
    // 2026-10-01：把探针改成**自解释色码**（原来是 R/G/B 三档灰度，读不出是哪一级
    // 判据失败的）。玻璃区出现哪种纯色，就是哪一级把历史拒了：
    //   青 (0,1,1) = cam.historyValid = 0        → 时域复用的外闸整帧关着
    //   蓝 (0,0,1) = 重投影失败（uv 越界 / w<=0）→ 键/矩阵这一路
    //   红 (1,0,0) = 位置判据失败               → 键在世界上逐帧移动（或容差不够）
    //   绿 (0,1,0) = 法线判据失败               → 接收面身份变了（隔着玻璃的亚像素
    //                                             抖动把接收面翻面）
    //   黄 (1,1,0) = 复用成功、正在积累          → 正常，越黄越久
    //   白 (1,1,1) = 复用成功且已积累满          → 正常
    vec3 probeColor = vec3(1.0, 1.0, 0.0);
    if(cam.historyValid == 0u)
    {
        probeColor = vec3(0.0, 1.0, 1.0);
    }
    else if(!reprojectOk)
    {
        probeColor = vec3(0.0, 0.0, 1.0);
    }
    else if(!positionOk)
    {
        probeColor = vec3(1.0, 0.0, 0.0);
    }
    else if(!normalOk)
    {
        probeColor = vec3(0.0, 1.0, 0.0);
    }
    else if(oldCount >= VPT_TRANSPARENT_HISTORY_FRAMES * 0.9)
    {
        probeColor = vec3(1.0, 1.0, 1.0);
    }
    dbgGlassHistoryProbe = probeColor;
#endif
    // 这条路径只有透明接收面（玻璃/水后面的接收面）在用，见
    // VPT_TRANSPARENT_HISTORY_FRAMES 处的说明：它是这份内容**唯一**的时域
    // 平均来源（RR 拿不到它的 G-buffer 记录），所以这里必须给足帧数。
    //
    // =====================================================
    // 2026-10-24 第三轮补丁：运动自适应历史封顶（修"残影滞留"）
    //
    // 拖尾机制：静止时历史收敛、没有拖尾；相机移动时，位置判据的容差
    // （抖动差 + 0.75px 邻像素余量，按接收面视深放大）会让"接收面缓慢漂移"
    // 的每一帧都判通过 —— 于是长历史以**全权重**拖着几十帧前那个接收面的旧
    // 光照走。以前 1spp 噪声大，拖尾被颗粒盖住；16 提案把噪底压干净之后
    // 拖尾就显形了（用户报告的"残影滞留"）。
    //
    // 修法：用玻璃面点在**前后两帧投影的屏幕滑移**（像素）当运动信号，历史
    // 封顶按滑移缩短 —— 走动（滑移大）时历史立刻掉到几帧，拖尾当场消失；
    // 静止（滑移 ≈ 两帧 jitter 差 ≤ ~1px）时满历史不变，噪点收益不受损。
    // 两帧投影各自带本帧/上帧 jitter，其差 ≤ ~1px，用 1.5px 死区吞掉，
    // 不依赖 jitter 的符号约定。封顶平滑无阈值跳变：cap = 96 / (1 + 超出
    // 死区的滑移 × 8)。alpha 随 cap 立即变大 ⇒ 旧值几帧内被冲掉；运动停止
    // 后计数从 cap 重新爬回满。这同时修掉火萤钳制在"亮区入场"时的爬升慢：
    // 运动中 alpha 变大，钳顶跟着历史均值快速让位。
    // A/B：-DVPT_TRANSPARENT_MOTION_CAP=0 回到固定历史（有拖尾）。
    // =====================================================
#ifndef VPT_TRANSPARENT_MOTION_CAP
#define VPT_TRANSPARENT_MOTION_CAP 1
#endif
    float historyCap = VPT_TRANSPARENT_HISTORY_FRAMES;
#if VPT_TRANSPARENT_MOTION_CAP
    mat4 slipPreviousWorldToClip =
        inverse(cam.prevProjInverse) *
        inverse(cam.prevViewInverse);
    mat4 slipCurrentWorldToClip =
        inverse(cam.projInverse) *
        inverse(cam.viewInverse);
    vec4 slipPreviousClip =
        slipPreviousWorldToClip * vec4(matchPosition, 1.0);
    vec4 slipCurrentClip =
        slipCurrentWorldToClip * vec4(matchPosition, 1.0);
    if(slipPreviousClip.w > 1.0e-5 && slipCurrentClip.w > 1.0e-5)
    {
        float slipPixels = length(
            (slipCurrentClip.xy / slipCurrentClip.w -
                slipPreviousClip.xy / slipPreviousClip.w) *
            (0.5 * vec2(renderSize))
        );
        historyCap = VPT_TRANSPARENT_HISTORY_FRAMES /
            (1.0 + max(slipPixels - 1.5, 0.0) * 8.0);
    }
#endif
    // 2026-10-25（回退轮补丁）：封顶下限 8 帧。纯封顶在快速转视角时把历史压到
    // ~1 帧 ⇒ 透过玻璃的内容几乎裸 1spp（用户实测"非常大的噪点"）。下限 8 保留
    // ~1/2.8 的时域平滑；拖尾权重 (7/8)^n 在 8 帧后剩 0.34、16 帧后剩 0.12
    // ⇒ 拖尾仍然只有 ~0.13-0.27 秒，第四轮要修的"残影滞留"不会回来。
    historyCap =
        max(historyCap, 8.0);
    float nextCount = min(oldCount + 1.0, historyCap);
    float alpha = 1.0 / nextCount;
    // 只有真的携带到历史（位置判据通过）时才混合；硬清零那一路保持"当帧即结果"。
    vec3 filteredRadiance = (oldCount > 0.0)
        ? mix(previousHistory.radianceAndSampleCount.rgb, currentRadiance, alpha)
        : currentRadiance;

    VPTDirectHistory outputHistory;
    outputHistory.radianceAndSampleCount = vec4(filteredRadiance, nextCount);
    // 存的是**接收面**的世界位置（身份判据用），不是重投影键 —— 重投影键每帧由
    // 几何重新算出，不必也不该存进历史（见上面 positionOk 处的说明）。
    // =================================================
    // 2026-10-10（A-3 修复）：这里必须存**与下一帧判据同源的那个量**。
    //
    // 判据在 5073 是把"当前帧重算出的 matchPosition（重投影键 / 几何量）"与这里
    // 存下的值相比；而原来存的是 hitPosition —— **含 POM 位移行程**的着色位置
    // （hitPos = startOrigin + dir * (hitDistance + hitParallaxRayTravel)）。
    // 两者口径不同：浮雕 texel 一翻，hitPosition 就跳一档（上限 0.2 格，
    // 见 getPOMDepthScale），轻易越过 vptJitterCompensatedPositionEpsilon
    // ⇒ 历史被逐帧拒 ⇒ 该像素永远回落到 1 spp
    // ⇒ 噪点形状 = 浮雕纹理（用户描述"形状跟 POM 差不多"）。
    //
    // 紧邻的两行法线**已经**按这个原则对齐过（5151-5153：
    // "Store the same normal the match tests, so the comparison is like-for-like"），
    // 位置这一项当时漏了 ⇒ 现在按同一原则补上：存 matchPosition。
    // 语义变化：POM 位移只影响**着色**，不再影响**身份判据** —— 这才是它该在的位置。
    // ⚠ 只改这一处（透明接收面）；4690 那处是另一条路径（它存的是着色法线
    //   hitNormal，另一套约定），不在本次改动范围内。
    // =================================================
    // =================================================
    // 2026-10-10 **回退**：本行曾改成存 matchPosition（A-3 修复），而实测结果是
    // "玻璃全是噪点" —— 也就是**每个像素的历史都被判据拒掉、全部回落 1 spp**。
    // 说明 matchPosition 并不是下一帧判据要用的那个量（至少要满足更多约束），
    // 我基于"存与判据同源的量"这个推断去改是错的。
    // 已恢复原口径。下一轮**不许再盲改**：先用作者留的自解释探针
    //（DBG_GLASS_HISTORY_PROBE，见上方色码：红=位置判据失败 / 绿=法线失败 /
    //  蓝=重投影失败 / 黄=正常积累 / 白=积累满）跑一次，看**是哪一级**在拒，
    // 再决定改容差还是改键。
    // =================================================
    outputHistory.hitPositionAndValid = vec4(hitPosition, 1.0);
    // Store the same normal the match tests, so the comparison is
    // like-for-like (geometric vs geometric).
    outputHistory.normalAndPadding = vec4(matchNormal, 0.0);
    vptWritePrimaryHistory(currentIndex, outputHistory);
    return filteredRadiance;
}


// =====================================================
// 2026-10-26 RTXDI 式直接光时域 reservoir（设置项：直接光模式 = 1）
//
// 结构照 RTX Remix 的 RTXDI 调用序列搬运：
//   rtxdi_initial_sampling.comp.slang：
//     RTXDI_EmptyReservoir → 提案采样 → RTXDI_CombineReservoirs(..., targetPdf)
//     →（延迟的）RTXDI_UpdateSelectedReservoirVisibility ← 合并后只发 1 条可见性射线
//   rtxdi_temporal_reuse.comp.slang：
//     RAB_LoadReservoir → RTXDI_TemporalResampling（重投影 + 深度/法线判据
//     + maxHistoryLength）→ RAB_StoreReservoir
//
// RTXDI SDK 本体不在仓里（_ref/dxvk-remix/submodules/rtxdi 是未初始化的空
// 子模块），所以合并公式按 Remix 调用侧暴露的契约本地等价实现：
//   weightSum = Σ target/pdf，M = 候选数，W = weightSum/(M·target)。
// 读历史时先用**当前接收面**重算该样本的 target，把 W 还原成 weightSum，
// 再按 weightSum 占比二选一 —— 与 RTXDI_CombineReservoirs 的语义一致。
//
// 与 2026-09-29/09-30 两次被否的跨帧 EMA 本质不同：那条混的是**颜色**
// （辐射度），输出支撑集被上一帧颜色改写 ⇒ 结构性噪点；这里混的是
// **选哪个灯**（reservoir），输出仍是"一个样本 × 无偏权重"，样本来自更长的
// 候选集。这也是官方 ReSTIR DI 与"时间降噪"的分界。
//
// 失效：灯内容 revision（localLightBuffer.header.y，即宿主
// g_localLightRevision，内容不变时不递增）与历史不同 ⇒ 丢弃历史。官方用
// light hash 做逐灯身份验证；本工程的 block emitter 没有稳定 light index，
// 改用整表 revision + 世界坐标/类型/发射强度重建，开关灯的陈旧上限 = 1 帧。
// =====================================================
// 2026-10-26 完全对齐 dxvk-remix 的 RTXDI 调用契约。
//
// maxHistoryLength = 4（rtx_rtxdi_rayquery.h:79）与"每帧 M = 1"
// （rtxdi_initial_sampling.comp.slang:115 `state.M = 1`）是**一对**参数：
// M 是候选数，每帧只 +1 ⇒ 4 就是 4 帧历史。我们此前每帧按提案数（16）计入 M，
// 又没有在钳位时缩放 weightSum ⇒ W 逐帧上涨、画面被降噪器钳成萤火虫。
#ifndef VPT_DIRECT_WRS_HISTORY_LENGTH
// RTXDI 的 rtx.di.maxHistoryLength 默认值。
#define VPT_DIRECT_WRS_HISTORY_LENGTH 4.0
#endif
#ifndef VPT_DIRECT_WRS_NORMAL_COSINE
// rtxdi_temporal_reuse.comp.slang:123 tparams.normalThreshold = 0.8
#define VPT_DIRECT_WRS_NORMAL_COSINE 0.8
#endif
// 空间复用（rtxdi_spatial_reuse.comp.slang:118-131 + rtx_rtxdi_rayquery.h:71-75）
#ifndef VPT_DIRECT_WRS_SPATIAL_SAMPLES
#define VPT_DIRECT_WRS_SPATIAL_SAMPLES 2
#endif
#ifndef VPT_DIRECT_WRS_SPATIAL_SAMPLES_DISOC
#define VPT_DIRECT_WRS_SPATIAL_SAMPLES_DISOC 4
#endif
#ifndef VPT_DIRECT_WRS_SPATIAL_RADIUS
// sparams.samplingRadius = 30（像素）
#define VPT_DIRECT_WRS_SPATIAL_RADIUS 30
#endif
#ifndef VPT_DIRECT_WRS_SPATIAL_NORMAL
// sparams.normalThreshold = 0.5（比时域的 0.8 松，Remix 原值）
#define VPT_DIRECT_WRS_SPATIAL_NORMAL 0.5
#endif
#ifndef VPT_DIRECT_WRS_SPATIAL_DEPTH
// sparams.depthThreshold = 0.1（按相机距离的相对量）
#define VPT_DIRECT_WRS_SPATIAL_DEPTH 0.1
#endif
#ifndef VPT_DIRECT_WRS_DISOCLUSION_FRAMES
// rtx.di.disocclusionFrames = 8
#define VPT_DIRECT_WRS_DISOCLUSION_FRAMES 8
#endif
// 时域重投影的探测次数（RTXDI_TemporalResampling :432-467 固定 9 次）。
// 1 = 旧行为（只试运动矢量像素）。
#ifndef VPT_DIRECT_WRS_TEMPORAL_ATTEMPTS
#define VPT_DIRECT_WRS_TEMPORAL_ATTEMPTS 9
#endif
// best-light sampling（Remix 的 RtxdiBestLights，见 initial_sampling.comp:102-105）。
// 0 = 关。⚠ 我们用的是"格锚点像素的上一帧 reservoir"，不是 argmax(照度)，
// 原因见 tail 里的长注释（没有 per-tile SSBO / 没有 G-buffer）。
#ifndef VPT_DIRECT_WRS_BEST_LIGHT
#define VPT_DIRECT_WRS_BEST_LIGHT 1
#endif
// 2026-11-02 稀疏瘦身：非活跃像素（不写颜色）跳过空间复用与 best-light，
// 只保留 temporal + history 落盘。0 = 回到"非活跃像素也跑全套"的旧行为（A/B 用）。
#ifndef VPT_SPARSE_INACTIVE_THIN
#define VPT_SPARSE_INACTIVE_THIN 1
#endif
#ifndef VPT_DIRECT_WRS_BEST_LIGHT_TILE
// Remix 的 RTXDI_GRAD_FACTOR 是 8 的整数倍口径；这里用 8×8。
#define VPT_DIRECT_WRS_BEST_LIGHT_TILE 8
#endif
// RAY_TRACED bias correction（Remix 的 rtx.di.enableRayTracedBiasCorrection 默认 true）：
// 选中的历史样本要重验一次可见性，不可见则把它的 p̂ 置 0。
#ifndef VPT_DIRECT_WRS_RAY_TRACED_BC
#define VPT_DIRECT_WRS_RAY_TRACED_BC 1
#endif
#ifndef VPT_DIRECT_WRS_CONFIDENCE_LENGTH
// rtxdi_temporal_reuse.comp.slang:144 的 kReprojectionConfidenceHistoryLength。
// ⚠ 参考仓库里只有这个符号的**用法**（预编译 shader 内联），没有定义 ⇒ 取 8，
// 与 disocclusionFrames 同值：语义是"连续重投影成功 8 帧视为收敛"。
#define VPT_DIRECT_WRS_CONFIDENCE_LENGTH 8.0
#endif

// =====================================================
// 2026-11-02 per-tile best-light 寻址（详见 binding 80 处的说明）。
// =====================================================
uint vptBestLightTileIndex(ivec2 pixelCoord, out uint halfOffset, out uint tileSize)
{
    const uint tile = uint(VPT_DIRECT_WRS_BEST_LIGHT_TILE);
    const uvec2 size = uvec2(rtLaunchSize());
    const uint tileColumns = max((size.x + tile - 1u) / tile, 1u);
    const uint tileRows = max((size.y + tile - 1u) / tile, 1u);
    halfOffset = tileColumns * tileRows;
    tileSize = tile;
    const uint column = min(uint(pixelCoord.x) / tile, tileColumns - 1u);
    const uint row = min(uint(pixelCoord.y) / tile, tileRows - 1u);
    return row * tileColumns + column;
}

// 读：返回上一帧本 tile 里贡献最大的像素。没写过 / 代际不符 ⇒ false。
bool vptBestLightRead(ivec2 pixelCoord, out ivec2 bestPixel)
{
    bestPixel = pixelCoord;
    uint halfOffset = 0u;
    uint tileSize = 0u;
    const uint tileIndex = vptBestLightTileIndex(pixelCoord, halfOffset, tileSize);
    // 读的那半 = 上一帧写的那半 = 与 history 的读同向。
    const uint readHalf = cam.historyReadIndex == 0u ? 0u : 1u;
    const uint key = vptBestLightBuffer.tiles[readHalf * halfOffset + tileIndex];
    if(key == 0u)
    {
        return false;
    }
    // 代际校验：两帧前的残留与本帧期望的奇偶位相反，直接拒绝。
    if((key & 1u) != ((cam.frameCount + 1u) & 1u))
    {
        return false;
    }
    const uint localIndex = (key >> 1u) & (tileSize * tileSize - 1u);
    const ivec2 tileOrigin = (pixelCoord / int(tileSize)) * int(tileSize);
    bestPixel = tileOrigin +
        ivec2(int(localIndex % tileSize), int(localIndex / tileSize));
    return true;
}

// 写：用本像素最终的直射贡献亮度参与本 tile 的 argmax，写另一半。
void vptBestLightInsert(ivec2 pixelCoord, float luma)
{
    if(!(luma > 0.0))
    {
        // 全黑 / 被遮挡的像素不该成为 best light，否则下一帧拿到的候选 p̂ = 0。
        return;
    }
    uint halfOffset = 0u;
    uint tileSize = 0u;
    const uint tileIndex = vptBestLightTileIndex(pixelCoord, halfOffset, tileSize);
    const uint writeHalf = cam.historyReadIndex == 0u ? 1u : 0u;
    const uint localIndex =
        (uint(pixelCoord.y) % tileSize) * tileSize + (uint(pixelCoord.x) % tileSize);
    // 26 bit 量化亮度：*256 后钳到 2^26-1（HDR 直射项足够）。
    const uint quantized = uint(clamp(luma * 256.0, 0.0, 67108863.0));
    if(quantized == 0u)
    {
        return;
    }
    const uint key = (quantized << 7u) | (localIndex << 1u) | (cam.frameCount & 1u);
    atomicMax(vptBestLightBuffer.tiles[writeHalf * halfOffset + tileIndex], key);
}

// 按当前接收面重算一个灯样本的无阴影贡献（与 RIS 提案循环的 scale 逐项一致）。
bool vptLocalEmitterContributionAt(
    vec3 hitPos,
    vec3 N,
    bool waterColumnReceiver,
    bool geometricFaceKnown,
    vec3 geometricFaceRecovered,
    vec3 samplePosition,
    uint emission,
    uint typeCode,
    out vec3 contribution
)
{
    contribution = vec3(0.0);
    if(emission == 0u)
    {
        return false;
    }
    vec3 toLight = samplePosition - hitPos;
    float distanceSquared = dot(toLight, toLight);
    if(distanceSquared <= 1.0e-6)
    {
        return false;
    }
    float distanceToLight = sqrt(distanceSquared);
    float emissionLevel = float(emission);
    // 距离闸与提案循环同口径（那里量的是**发射体中心**到接收点，不是采样点），
    // 否则 max range 边缘那一圈采样的 target 会被本函数判 0，合并出一个偏置。
    vec3 emitterCenter = floor(samplePosition) + vec3(0.5);
    if(length(emitterCenter - hitPos) > vptLocalLightRange(typeCode, emissionLevel))
    {
        return false;
    }
    vec3 lightDirection = toLight / distanceToLight;
    float cosine = waterColumnReceiver
        ? 1.0
        : max(dot(N, lightDirection), 0.0);
#if VPT_LOCAL_GEOMETRIC_COSINE_BOUND
    cosine = min(
        cosine,
        vptLocalFaceSetCosineBound(
            geometricFaceKnown,
            geometricFaceRecovered,
            hitPos,
            lightDirection
        )
    );
#endif
    if(cosine <= 0.0)
    {
        return false;
    }
    float scale = 3.2 * LOCAL_LIGHT_ENERGY_SCALE * localLightIntensity() *
        localLightProfileBrightness(typeCode, emissionLevel) *
        vptLocalLightDistanceAttenuation(distanceToLight) *
        vptLocalLightRangeFade(distanceToLight, typeCode, emissionLevel);
    contribution = vliDecodeEmitterColor(typeCode) * scale * cosine;
    return true;
}

// 与 RIS 尾部完全相同的可见性/染色模型（见 evaluateVPTRISDirectLightingSingle
// 的长注释），只对合并后的**一个**样本发一次射线。
vec3 vptLocalEmitterSampleTransmittance(
    vec3 hitPos,
    vec3 selectedSample
)
{
    ivec3 selectedBlock = ivec3(floor(selectedSample));
    vec3 neeRayDirection = normalize(selectedSample - hitPos);
    vec3 receiverOrigin = hitPos + neeRayDirection * 0.001;

    bool sampledPointInsideEmitterVoxel =
        all(greaterThanEqual(selectedSample, vec3(selectedBlock))) &&
        all(lessThanEqual(
            selectedSample,
            vec3(selectedBlock) + vec3(1.0)
        ));
    float targetVoxelEntryDistance = vptEmitterVoxelEntryDistance(
        receiverOrigin, selectedSample, selectedBlock
    );
    if(!sampledPointInsideEmitterVoxel || targetVoxelEntryDistance < 0.0)
    {
        targetVoxelEntryDistance = distance(selectedSample, receiverOrigin);
    }

    vec3 transmittance = VPT_LOCAL_NEE_VISIBILITY_RAY
        ? traceVptLocalLightVisibility(
            receiverOrigin,
            selectedSample,
            targetVoxelEntryDistance,
            0xffu
        )
        : vptTraceGlassTransmissionToEmitter(
            receiverOrigin,
            selectedSample,
            targetVoxelEntryDistance
        );
#if VPT_LOCAL_CONSERVATIVE_VOXEL_OCCLUSION
    if(vptVoxelPathBlocked(
        receiverOrigin,
        selectedSample,
        selectedBlock,
        targetVoxelEntryDistance
    ))
    {
        return vec3(0.0);
    }
#endif
    return transmittance;
}

// RTXDI_GetTemporalReprojectionOffset（:397-410）：radius=5，offset∈[-2.5,2.5)，
// 强转 int 后落在 {-2,-1,0,1,2}。
ivec2 vptTemporalReprojectionOffset(inout uint rngState)
{
    const float radius = 5.0;
    const vec2 offsetRandom = vec2(rand(rngState), rand(rngState));
    return ivec2((offsetRandom - vec2(0.5)) * radius);
}

// 历史条目与当前接收面是否同一个面（= RTXDI_IsValidNeighbor 的世界空间等价判据）。
bool vptReservoirReceiverMatches(
    VPTDirectHistory history,
    vec3 hitPos,
    vec3 receiverNormal,
    float positionEpsilon,
    float normalCosine)
{
    return length(history.normalAndPadding.xyz - hitPos) <= positionEpsilon &&
        dot(normalize(history.reservoirNormalAndPadding.xyz), receiverNormal) >=
            normalCosine;
}

// =====================================================
// 时域重投影探测：RTXDI_TemporalResampling:432-467 的 9 次尝试。
//
// 为什么必须 9 次：单次重投影在曲面玻璃、快速转动的边缘、以及深度不连续处几乎
// 必然失败，历史一丢就退回 1 样本 ⇒ 这就是"RTX DI 很吵"的主因。
// 第 9 次（i == 8）故意**不做**相似性判据：SDK 原注释说它是给 disocclusion 与
// 透过曲面玻璃看到的表面准备的兜底。
// =====================================================
bool vptProbeTemporalHistory(
    vec3 hitPos,
    vec3 receiverNormal,
    ivec2 pixelCoord,
    ivec2 renderSize,
    uint lightRevision,
    float positionEpsilon,
    float normalCosine,
    inout uint rngState,
    out ivec2 historyCoord,
    out bool fromMotionVector)
{
    historyCoord = ivec2(-1);
    fromMotionVector = false;

    uint reprojectedIndex = 0u;
    const bool hasReprojection =
        vptReprojectPreviousPixel(hitPos, renderSize, reprojectedIndex);
    const ivec2 reprojectedCoord = ivec2(
        int(reprojectedIndex % uint(renderSize.x)),
        int(reprojectedIndex / uint(renderSize.x)));

    for(int attempt = 0; attempt < VPT_DIRECT_WRS_TEMPORAL_ATTEMPTS; ++attempt)
    {
        ivec2 coord;
        bool requireSimilarity = true;

        // 只有"尝试次数 > 1"时，最后一次才是 SDK 的"同像素免判据"兜底；
        // 置 1 时退化成旧行为（只试运动矢量像素 + 相似性判据）。
        const bool lastAttempt =
            (attempt == VPT_DIRECT_WRS_TEMPORAL_ATTEMPTS - 1);
        if(VPT_DIRECT_WRS_TEMPORAL_ATTEMPTS > 1 && lastAttempt)
        {
            coord = pixelCoord;
            requireSimilarity = false;
        }
        else
        {
            if(!hasReprojection)
            {
                continue;
            }
            coord = reprojectedCoord +
                (attempt == 0 ? ivec2(0) : vptTemporalReprojectionOffset(rngState));
        }

        if(any(lessThan(coord, ivec2(0))) ||
           any(greaterThanEqual(coord, renderSize)))
        {
            continue;
        }

        const VPTDirectHistory probe = vptReadPrimaryHistory(
            uint(coord.y * renderSize.x + coord.x));

        if(abs(probe.hitPositionAndValid.w - 2.0) >= 0.5)
        {
            continue;
        }
        if(probe.hitPositionAndValid.y < 0.5)
        {
            continue;
        }
        // 灯表内容变了 ⇒ 灯身份不可验证（对应 SDK 的 TranslateLightIndex 失败）。
        if(abs(probe.hitPositionAndValid.z - float(lightRevision)) >= 0.5)
        {
            continue;
        }
        if(requireSimilarity &&
           !vptReservoirReceiverMatches(
               probe, hitPos, receiverNormal, positionEpsilon, normalCosine))
        {
            continue;
        }

        historyCoord = coord;
        fromMotionVector = requireSimilarity;
        return true;
    }

    return false;
}

// =====================================================
// 2026-10-26：RTXDI 语义的 reservoir 累积状态。
//
// 字段与 RTXDI_Reservoir（Reservoir.slangh:24-34）一一对应：
//   samplePos / sampleIdentity   ≈ lightIdx + uv（我们是一块发射体上的采样点）
//   weightSum                    combine 阶段的加权和（finalize 前口径）
//   M                            历史长度，单位**帧**（initial sampling 后 = 1）
//   targetPdf                    选中样本在**当前接收面**上的 p̂
//   pi / piSum                   BASIC bias correction 的 MIS 归一分子 / 分母
// =====================================================
struct VPTReservoirState
{
    vec3 samplePos;
    uint sampleIdentity;
    vec3 selectedContribution;
    float weightSum;
    float M;
    float piSum;
    float targetPdf;
    float pi;
    bool selectedPrevious;
};

VPTReservoirState vptReservoirStateEmpty()
{
    VPTReservoirState state;
    state.samplePos = vec3(0.0);
    state.sampleIdentity = 0u;
    state.selectedContribution = vec3(0.0);
    state.weightSum = 0.0;
    state.M = 0.0;
    state.piSum = 0.0;
    state.targetPdf = 0.0;
    state.pi = 0.0;
    state.selectedPrevious = false;
    return state;
}

// RTXDI_CombineReservoirs（ResamplingFunctions.slangh:66-95）逐行等价：
//   risWeight = targetPdf * candidateWeight * candidateM
//   M += candidateM；weightSum += risWeight；按占比做 WRS 抽取
bool vptCombineReservoir(
    inout VPTReservoirState state,
    vec3 candidateSample,
    uint candidateIdentity,
    vec3 candidateContribution,
    float candidateWeight,
    float candidateM,
    float candidateTargetPdf,
    inout uint rngState)
{
    const float risWeight =
        candidateTargetPdf * candidateWeight * candidateM;
    if(risWeight <= 0.0)
    {
        return false;
    }

    state.M += candidateM;
    state.weightSum += risWeight;

    if(rand(rngState) * state.weightSum >= risWeight)
    {
        return false;
    }

    state.samplePos = candidateSample;
    state.sampleIdentity = candidateIdentity;
    state.selectedContribution = candidateContribution;
    state.targetPdf = max(candidateTargetPdf, 1.0e-6);
    state.selectedPrevious = true;
    return true;
}

// 把一个历史 reservoir 合并进当前 state。时域与空间共用这一个入口，差别只有：
//   · historyClampM > 0 ⇒ 时域，按 maxHistoryLength（单位帧）钳候选 M；
//   · 空间的 piSum 用**邻居表面**的 p̂（SDK :797-810 同一口径），我们这里就是历史
//     条目里存的上一帧接收面。
bool vptMergeReservoirCandidate(
    inout VPTReservoirState state,
    ivec2 historyCoord,
    ivec2 renderSize,
    vec3 hitPos,
    vec3 N,
    vec3 receiverNormal,
    bool waterColumnReceiver,
    bool geometricFaceKnown,
    vec3 geometricFaceRecovered,
    uint lightRevision,
    float positionEpsilon,
    float normalCosine,
    float historyClampM,
    bool testVisibility,
    inout uint rngState,
    out float candidateConfidence)
{
    candidateConfidence = 0.0;

    if(any(lessThan(historyCoord, ivec2(0))) ||
       any(greaterThanEqual(historyCoord, renderSize)))
    {
        return false;
    }

    const uint historyIndex =
        uint(historyCoord.y * renderSize.x + historyCoord.x);
    const VPTDirectHistory history = vptReadPrimaryHistory(historyIndex);

    if(abs(history.hitPositionAndValid.w - 2.0) >= 0.5)
    {
        return false;
    }
    // 灯表 revision 不同 ⇒ 灯身份不可验证（对应 SDK 的 light hash / TranslateLightIndex）。
    if(abs(history.hitPositionAndValid.z - float(lightRevision)) >= 0.5)
    {
        return false;
    }
    if(history.hitPositionAndValid.y < 0.5)
    {
        return false;
    }
    if(length(history.normalAndPadding.xyz - hitPos) > positionEpsilon)
    {
        return false;
    }
    if(dot(normalize(history.reservoirNormalAndPadding.xyz), receiverNormal) <
       normalCosine)
    {
        return false;
    }

    const uint packedIdentity = uint(history.radianceAndSampleCount.w + 0.5);
    const vec3 candidateSample = history.radianceAndSampleCount.xyz;

    // p̂ 在当前接收面上（= SDK 的 RAB_GetLightSampleTargetPdfForSurface(candidate, surface)）
    vec3 contributionNow;
    if(!vptLocalEmitterContributionAt(
        hitPos,
        N,
        waterColumnReceiver,
        geometricFaceKnown,
        geometricFaceRecovered,
        candidateSample,
        packedIdentity >> 5u,
        packedIdentity & 31u,
        contributionNow))
    {
        return false;
    }
    const float targetNow = max(dot(contributionNow,
        vec3(0.2126, 0.7152, 0.0722)), 1.0e-6);

    // p̂ 在**上一帧接收面**上（= SDK 的 GetSurfaceForTemporalBiasCorrection + 重新求值）。
    // 这是 BASIC / RAY_TRACED bias correction 的分母项；求不出来就退化用 targetNow。
    float targetPreviousSurface = targetNow;
    {
        vec3 contributionPreviousSurface;
        if(vptLocalEmitterContributionAt(
            history.normalAndPadding.xyz,
            normalize(history.reservoirNormalAndPadding.xyz),
            waterColumnReceiver,
            false,
            vec3(0.0, 1.0, 0.0),
            candidateSample,
            packedIdentity >> 5u,
            packedIdentity & 31u,
            contributionPreviousSurface))
        {
            targetPreviousSurface = max(dot(contributionPreviousSurface,
                vec3(0.2126, 0.7152, 0.0722)), 1.0e-6);
        }
    }

    const float candidateWeight = max(history.hitPositionAndValid.x, 0.0);
    float candidateM = max(history.hitPositionAndValid.y, 1.0);
    if(historyClampM > 0.0 && candidateM > historyClampM)
    {
        candidateM = historyClampM;
    }
    if(candidateWeight <= 0.0 || candidateM <= 0.0)
    {
        return false;
    }

    // RAY_TRACED bias correction（SDK :598-611）：选中的历史样本重验一次可见性，
    // 不可见则把 temporalP 置 0 —— 它既影响 pi，也影响 piSum 的分母项。
    // 代价：每次时域复用最多 +1 条射线；空间复用不做（SDK 的空间那条要每邻域一条）。
#if VPT_DIRECT_WRS_RAY_TRACED_BC
    if(testVisibility && targetPreviousSurface > 0.0)
    {
        const vec3 previousVisibility = vptLocalEmitterSampleTransmittance(
            history.normalAndPadding.xyz,
            candidateSample);
        if(max(previousVisibility.r,
               max(previousVisibility.g, previousVisibility.b)) <= 0.0)
        {
            targetPreviousSurface = 0.0;
        }
    }
#endif

    // piSum 累加"该候选在自己接收面上"的 p̂×M（SDK :616 与 :810 同一口径）。
    state.piSum += targetPreviousSurface * candidateM;

    if(vptCombineReservoir(
        state,
        candidateSample,
        packedIdentity,
        contributionNow,
        candidateWeight,
        candidateM,
        targetNow,
        rngState))
    {
        // 选中的是这个候选 ⇒ 它的 pi 用上一帧接收面上的 p̂（SDK :614）。
        state.pi = targetPreviousSurface;
    }

    candidateConfidence = history.reservoirNormalAndPadding.w;
    return true;
}

vec3 evaluateVPTDirectLightReservoirTail(
    vec3 hitPos,
    vec3 N,
    vec3 hitAlbedo,
    bool waterColumnReceiver,
    bool geometricFaceKnown,
    vec3 geometricFaceRecovered,
    float currentWeightSum,
    vec3 currentContribution,
    vec3 currentSample,
    uint currentEmission,
    uint currentTypeCode,
    bool shadingActive,
    inout uint rngState
)
{
    const ivec2 pixelCoord = ivec2(gl_LaunchIDEXT.xy);
    const ivec2 renderSize = ivec2(rtLaunchSize());
    const uint currentIndex =
        uint(pixelCoord.y * renderSize.x + pixelCoord.x);
    const vec3 luminanceWeights = vec3(0.2126, 0.7152, 0.0722);

    vec3 receiverNormal = geometricFaceKnown
        ? normalize(geometricFaceRecovered)
        : N;

    // ---- initial sampling ----
    // SDK：RTXDI_FinalizeResampling(localState, 1.0, localState.M) 把 weightSum 归一成 W，
    // 随后 localState.M = 1（ResamplingFunctions.slangh:280-281）。所以每帧的 reservoir
    // 代表 1 帧历史，weightSum 进入 combine 时是 p̂·W 的口径。
    const float proposalCount = float(vptRisProposalCount());
    const float currentTargetPdf =
        max(dot(currentContribution, luminanceWeights), 1.0e-6);
    const float initialW =
        currentWeightSum / max(currentTargetPdf * proposalCount, 1.0e-6);

    VPTReservoirState state = vptReservoirStateEmpty();
    state.samplePos = currentSample;
    // 2026-10-31：档案 id 5 bit ⇒ emission 左移 5。整包 9 bit，仍远小于 24 bit
    // 的 float 尾数精度上限（历史做法见 state.sampleIdentity 的注释）。
    state.sampleIdentity = (currentEmission << 5u) | currentTypeCode;
    state.selectedContribution = currentContribution;
    state.weightSum = currentTargetPdf * initialW;
    state.M = 1.0;
    state.piSum = currentTargetPdf;
    state.targetPdf = currentTargetPdf;
    state.pi = currentTargetPdf;
    state.selectedPrevious = false;

    const uint lightRevision = localLightBuffer.header.y;
    const float receiverPositionEpsilon =
        vptJitterCompensatedPositionEpsilon(hitPos);
    const float cameraDistance = length(hitPos - cam.viewInverse[3].xyz);

    float accumulatedConfidence = 0.0;
    bool historyReprojected = false;
    float candidateConfidence = 0.0;

    // ---- temporal reuse ----
    if(cam.historyValid != 0u)
    {
        ivec2 historyCoord;
        bool fromMotionVector = false;
        if(vptProbeTemporalHistory(
            hitPos,
            receiverNormal,
            pixelCoord,
            renderSize,
            lightRevision,
            receiverPositionEpsilon,
            VPT_DIRECT_WRS_NORMAL_COSINE,
            rngState,
            historyCoord,
            fromMotionVector))
        {
            // historyLimit = maxHistoryLength * state.M（ResamplingFunctions.slangh:485）。
            // 单位是帧：maxHistoryLength=4、state.M=1 ⇒ 4。
            const float historyLimit = VPT_DIRECT_WRS_HISTORY_LENGTH * state.M;

            historyReprojected = vptMergeReservoirCandidate(
                state,
                historyCoord,
                renderSize,
                hitPos,
                N,
                receiverNormal,
                waterColumnReceiver,
                geometricFaceKnown,
                geometricFaceRecovered,
                lightRevision,
                receiverPositionEpsilon,
                VPT_DIRECT_WRS_NORMAL_COSINE,
                historyLimit,
                /*testVisibility=*/ true,
                rngState,
                candidateConfidence);

            // SDK: isGBufferSimilar = (i < 8) —— 只有运动矢量路径命中才算"重投影成功"，
            // 同像素兜底命中不推进置信度。
            if(historyReprojected && !fromMotionVector)
            {
                historyReprojected = false;
            }
        }
    }

    // ---- spatial reuse ----
    // SDK：中心样本先 Combine 进来（:682），再按 numSamples 抽邻域（:696-753），
    // 采样数由 3×3 平均置信决定（rtxdi_spatial_reuse.comp.slang:106-120）。
#if VPT_DIRECT_WRS_SPATIAL_SAMPLES > 0
    // 2026-11-02 稀疏瘦身：非活跃像素的颜色根本不写（见 sparseWriteImage），
    // 空间复用对它纯属带宽浪费 —— 每次 tap 都是一次 64 B/px 的随机读。
    // 只保留 temporal，足够让下一帧变活跃时有一份新鲜 reservoir；合并组合
    // 变化不影响无偏性，只影响那部分像素（本来就不输出）的样本方差。
    if(shadingActive || VPT_SPARSE_INACTIVE_THIN == 0)
    {
        float summedConfidence = 0.0;
        for(int sy = -1; sy <= 1; ++sy)
        {
            for(int sx = -1; sx <= 1; ++sx)
            {
                ivec2 neighbour = pixelCoord + ivec2(sx, sy);
                if(any(lessThan(neighbour, ivec2(0))) ||
                   any(greaterThanEqual(neighbour, renderSize)))
                {
                    continue;
                }
                summedConfidence += vptReadPrimaryHistory(
                    uint(neighbour.y * renderSize.x + neighbour.x))
                    .reservoirNormalAndPadding.w;
            }
        }
        const float historyFrames =
            summedConfidence * (VPT_DIRECT_WRS_CONFIDENCE_LENGTH / 9.0);
        const int spatialSampleCount =
            historyFrames < float(VPT_DIRECT_WRS_DISOCLUSION_FRAMES)
                ? VPT_DIRECT_WRS_SPATIAL_SAMPLES_DISOC
                : VPT_DIRECT_WRS_SPATIAL_SAMPLES;

        const float spatialPositionEpsilon = max(
            receiverPositionEpsilon,
            VPT_DIRECT_WRS_SPATIAL_DEPTH * max(cameraDistance, 1.0));

        float spatialConfidence = 0.0;
        for(int tap = 0; tap < spatialSampleCount; ++tap)
        {
            const float offsetX = rand(rngState) * 2.0 - 1.0;
            const float offsetY = rand(rngState) * 2.0 - 1.0;
            const ivec2 spatialOffset = ivec2(
                int(round(offsetX * float(VPT_DIRECT_WRS_SPATIAL_RADIUS))),
                int(round(offsetY * float(VPT_DIRECT_WRS_SPATIAL_RADIUS))));

            vptMergeReservoirCandidate(
                state,
                pixelCoord + spatialOffset,
                renderSize,
                hitPos,
                N,
                receiverNormal,
                waterColumnReceiver,
                geometricFaceKnown,
                geometricFaceRecovered,
                lightRevision,
                spatialPositionEpsilon,
                VPT_DIRECT_WRS_SPATIAL_NORMAL,
                0.0,
                /*testVisibility=*/ false,
                rngState,
                spatialConfidence);
        }
    }
#endif

    // ---- best-light sampling ----
    // SDK：RTXDI_SampleSingleLight（ResamplingFunctions.slangh:294-344）把"上一帧该格
    // 选中的灯"作为**额外一个候选**并入，invSourcePdf = 1.0、weightSum = targetPdf>0 ? 1 : 0。
    // Remix 在 initial_sampling.comp:102-105 里紧接着 SampleRandomLights 调它。
    //
    // 2026-11-02：这一版**不再偏离** Remix —— 上一帧每个 tile 的 argmax 由
    // vptBestLightInsert() 在写 history 后原子写入 binding 80，这里读回来即可。
    //   Remix: RTXDI_FindGradientSampleAndBestLight（:1330-1412）由 compute_gradients +
    //   filter_gradients 两个 pass 写 per-tile SSBO；本工程把这一步并进 shading
    //   dispatch（reservoir 与 shading 同 dispatch、没有 G-buffer），用 atomicMax
    //   直接以"本帧贡献亮度"选胜者，语义等价、少两个 pass。
    //   M 仍钳到 1（一个候选），piSum 用它自己接收面上的 p̂（helper 内计算）。
#if VPT_DIRECT_WRS_BEST_LIGHT
    // 同上：best-light 也是为"要被着色的像素"准备候选的，非活跃像素拿它没有意义。
    if(shadingActive || VPT_SPARSE_INACTIVE_THIN == 0)
    {
        ivec2 bestLightPixel = pixelCoord;
        if(cam.historyValid != 0u && vptBestLightRead(pixelCoord, bestLightPixel))
        {
            const bool bestLightInRange =
                all(greaterThanEqual(bestLightPixel, ivec2(0))) &&
                all(lessThan(bestLightPixel, renderSize));
            if(bestLightInRange && bestLightPixel != pixelCoord)
            {
                float bestLightConfidence = 0.0;
                vptMergeReservoirCandidate(
                    state,
                    bestLightPixel,
                    renderSize,
                    hitPos,
                    N,
                    receiverNormal,
                    waterColumnReceiver,
                    geometricFaceKnown,
                    geometricFaceRecovered,
                    lightRevision,
                    // 不要求同面：best light 本来就是从格内**别的像素**取样本。
                    1.0e9,
                    -1.0,
                    // M 钳到 1 帧，避免它压过时域历史。
                    1.0,
                    /*testVisibility=*/ false,
                    rngState,
                    bestLightConfidence);
            }
        }
    }
#endif

    accumulatedConfidence = historyReprojected
        ? min(candidateConfidence +
              1.0 / VPT_DIRECT_WRS_CONFIDENCE_LENGTH, 1.0)
        : 1.0 / VPT_DIRECT_WRS_CONFIDENCE_LENGTH;

    // 稀疏渲染关闭时的旧行为：非活跃像素跳过着色。
    if(!shadingActive && cam.sparseParams.z <= 0.5)
    {
        return vec3(0.0);
    }

    // ---- finalize（RTXDI_FinalizeResampling，:97-106）----
    //   weightSum = weightSum * pi / (targetPdf * piSum)
    // 未选中历史样本时 pi 就是当前样本自己的 p̂（:560/614）。
    const float piFinal = state.selectedPrevious
        ? state.pi
        : state.targetPdf;
    const float mergedWeightSum = state.weightSum;
    const float mergedM = max(state.M, 1.0);
    const float finalW = mergedWeightSum * piFinal /
        max(state.targetPdf * state.piSum, 1.0e-6);

    const vec3 selectedContribution = state.selectedContribution;
    const vec3 selectedSample = state.samplePos;
    const uint selectedEmission = state.sampleIdentity >> 5u;
    const uint selectedTypeCode = state.sampleIdentity & 31u;

    // reservoir 先落盘、再判可见性：被遮挡的样本下一帧仍可复用并重新测遮挡
    //（官方 temporal reuse 也是先存 reservoir，可见性只影响着色）。
    VPTDirectHistory outputHistory;
    outputHistory.radianceAndSampleCount = vec4(
        selectedSample,
        float((selectedEmission << 5u) | selectedTypeCode)
    );
    outputHistory.hitPositionAndValid = vec4(
        finalW,
        mergedM,
        float(lightRevision),
        2.0
    );
    // normalAndPadding.w 存 targetPdf（RTXDI_Reservoir 的必填字段，bias correction 要用），
    // reservoirNormalAndPadding.w 存重投影置信度（ReprojectionConfidence）。
    outputHistory.normalAndPadding = vec4(hitPos, state.targetPdf);
    outputHistory.reservoirNormalAndPadding =
        vec4(receiverNormal, accumulatedConfidence);
    vptWritePrimaryHistory(currentIndex, outputHistory);

    if(!shadingActive || mergedWeightSum <= 0.0)
    {
        return vec3(0.0);
    }

    // 合并后只发 1 条可见性射线。
    vec3 transmittance = vptLocalEmitterSampleTransmittance(
        hitPos, selectedSample);
    if(max(transmittance.r, max(transmittance.g, transmittance.b)) <= 0.0)
    {
        return vec3(0.0);
    }
    // 2026-11-02：把最终直射贡献的亮度记进本 tile 的 best-light 槽位。
    // 只有真正可见（transmittance > 0）的像素才参与 argmax —— 被遮挡的样本
    // 下一帧拿来当候选只会白花一次可见性测试。
    const vec3 localDirectTerm =
        selectedContribution * finalW * max(hitAlbedo, vec3(0.0)) * 0.92;
    const vec3 tintedTerm = applyLocalGlassTint(localDirectTerm, transmittance);
#if VPT_DIRECT_WRS_BEST_LIGHT
    vptBestLightInsert(pixelCoord, dot(tintedTerm, luminanceWeights));
#endif
    return tintedTerm;
}




// Each cache probe is only a few blocks from the receiver.  This short DDA
// prevents the scalar cache from trilinearly bleeding through a full block
// wall; it is intentionally cheaper than a hardware RT shadow ray.
bool vptCacheProbeVisible(vec3 origin, vec3 target)
{
    vec3 segment = target - origin;
    float maxDistance = length(segment);
    if(maxDistance <= 1.0e-4) return true;
    vec3 direction = segment / maxDistance;
    ivec3 cell = ivec3(floor(origin));
    ivec3 step = ivec3(sign(direction));
    vec3 invAbs = 1.0 / max(abs(direction), vec3(1.0e-6));
    vec3 boundary = vec3(cell) + vec3(max(step, ivec3(0)));
    vec3 tMax = (boundary - origin) / direction;
    if(step.x == 0) tMax.x = 1.0e30;
    if(step.y == 0) tMax.y = 1.0e30;
    if(step.z == 0) tMax.z = 1.0e30;

    for(int i = 0; i < 8; ++i)
    {
        int axis = tMax.x < tMax.y ? (tMax.x < tMax.z ? 0 : 2)
                                    : (tMax.y < tMax.z ? 1 : 2);
        float t = axis == 0 ? tMax.x : (axis == 1 ? tMax.y : tMax.z);
        if(t >= maxDistance) return true;
#if VPT_CACHE_PROBE_CONSERVATIVE
        // 见上面的 VPT_CACHE_PROBE_CONSERVATIVE：贴着棱通过 ⇒ 按遮挡处理，
        // 否则会从两个对角相接的实心块之间"穿过去"，在墙角画出一条亮线。
        {
            float otherA = axis == 0 ? tMax.y : tMax.x;
            float otherB = axis == 2 ? tMax.y : tMax.z;
            float cornerEps = VPT_CACHE_PROBE_CORNER_EPS * (1.0 + abs(t));
            if(min(abs(otherA - t), abs(otherB - t)) <= cornerEps)
            {
                return false;
            }
        }
#endif
        if(axis == 0) { cell.x += step.x; tMax.x += invAbs.x; }
        else if(axis == 1) { cell.y += step.y; tMax.y += invAbs.y; }
        else { cell.z += step.z; tMax.z += invAbs.z; }
        uint source;
        if(!vptReadSourceVoxel(cell, source)) return false;
        if((source & 3u) == 1u) return false;
    }
    return false;
}

vec3 vptDirectionalCacheAxis(uint directionIndex)
{
    if(directionIndex == 0u) return vec3( 1.0,  0.0,  0.0);
    if(directionIndex == 1u) return vec3(-1.0,  0.0,  0.0);
    if(directionIndex == 2u) return vec3( 0.0,  1.0,  0.0);
    if(directionIndex == 3u) return vec3( 0.0, -1.0,  0.0);
    if(directionIndex == 4u) return vec3( 0.0,  0.0,  1.0);
    return vec3(0.0, 0.0, -1.0);
}


// 2026-10-01：探针可见性作为乘子（不再"排除+重新归一化"）。见使用点处的说明。
#ifndef VPT_DUAL_VIS_WEIGHTED
#define VPT_DUAL_VIS_WEIGHTED 1
#endif

// VPT-3.3A.1: sample the direct and final secondary directional fields with
// the same short receiver-to-probe visibility test and trilinear weights.
void sampleVPTDualDirectionalIrradiance(
    vec3 worldPos,
    vec3 surfaceNormal,
    out vec3 outPrimary,
    out vec3 outSecondary
)
{
    outPrimary = vec3(0.0);
    outSecondary = vec3(0.0);

    ivec3 sectionCoord = ivec3(floor(worldPos / 16.0));
    // 2026-10-03 **"发光/间接"在 Section 边界断成硬直线的修复**。
    //
    // 旧实现：本 Section 探针页缺失就 `return`（整项归零）。接收点跨过 16 格
    // 边界时，一侧有页、另一侧没有 ⇒ 一侧有发光、另一侧直接黑 —— 屏幕上就是
    // 那条笔直的分界线（与 RIS 侧当年那条 "early return 0" 是同一个病，
    // 那条修了、这条没修）。
    //
    // 这里借**最近的有页邻居**（与 RIS 借目录完全同构）：探针页只提供
    // 9³ 的方向辐照场，借用邻居的场在最坏情况下等于"把边界那一层的采样值
    // 延伸到本 Section"，但**绝不会归零** ⇒ 分界线消失，代价为零额外取样。
    ivec3 probeSection = sectionCoord;
    uint pageIndex;
    if(!vliLookupSectionPage(probeSection, pageIndex))
    {
        bool borrowedProbePage = false;
        for(uint neighbourIndex = 0u; neighbourIndex < 6u; ++neighbourIndex)
        {
            ivec3 neighbour = sectionCoord + (
                neighbourIndex == 0u ? ivec3( 1,  0,  0) :
                neighbourIndex == 1u ? ivec3(-1,  0,  0) :
                neighbourIndex == 2u ? ivec3( 0,  1,  0) :
                neighbourIndex == 3u ? ivec3( 0, -1,  0) :
                neighbourIndex == 4u ? ivec3( 0,  0,  1) :
                                       ivec3( 0,  0, -1)
            );
            if(vliLookupSectionPage(neighbour, pageIndex))
            {
                probeSection = neighbour;
                borrowedProbePage = true;
                break;
            }
        }
        if(!borrowedProbePage)
        {
            return;
        }
    }

    // 局部探针坐标相对**真正取到的那一页**的 Section 计算（借用时自动落在
    // 该场的边缘格，clamp 到 7.999 即取边缘那一层的方向辐照）。
    vec3 localProbe = clamp(
        (worldPos - vec3(probeSection * 16)) * 0.5,
        vec3(0.0),
        vec3(7.999)
    );
    ivec3 base = ivec3(floor(localProbe));
    vec3 fraction = fract(localProbe);
    uint primaryPageBase = pageIndex * VLI_PAGE_WORDS + VLI_SOURCE_WORDS;
    uint secondaryPageBase = pageIndex * VPT_DIRECTIONAL_CACHE_WORDS;
    vec3 N = normalize(surfaceNormal);

    vec3 primaryAccum = vec3(0.0);
    vec3 secondaryAccum = vec3(0.0);
    float acceptedWeight = 0.0;

    for(int y = 0; y <= 1; ++y)
    for(int z = 0; z <= 1; ++z)
    for(int x = 0; x <= 1; ++x)
    {
        ivec3 probe = base + ivec3(x, y, z);
        uint index = uint(probe.x) + VLI_PROBE_EDGE * (
            uint(probe.z) + VLI_PROBE_EDGE * uint(probe.y)
        );
        vec3 weight3 = mix(
            vec3(1.0) - fraction,
            fraction,
            vec3(float(x), float(y), float(z))
        );
        float weight = weight3.x * weight3.y * weight3.z;
        vec3 probeWorldPos = vec3(sectionCoord * 16 + probe * 2) + vec3(1.0);

        vec3 primaryDirIrr = vec3(0.0);
        vec3 secondaryDirIrr = vec3(0.0);

        for(uint directionIndex = 0u;
            directionIndex < VPT_DIRECTION_COUNT;
            ++directionIndex)
        {
            float normalWeight = max(
                dot(N, vptDirectionalCacheAxis(directionIndex)),
                0.0
            );
            normalWeight *= normalWeight;

            // Pass 1: 一次直接光 (Binding 23)
            uint packedPrimary = vliPagesBuffer.words[
                primaryPageBase + directionIndex * VLI_PROBE_WORDS + index
            ];
            primaryDirIrr += vliUnpackRadiance(packedPrimary) * normalWeight;

            // Pass 2: final Surface Cache-derived secondary light.
            uint packedSecondary = vliSecondaryPagesBuffer.words[
                secondaryPageBase + directionIndex * VLI_PROBE_WORDS + index
            ];
            secondaryDirIrr += vliUnpackRadiance(packedSecondary) * normalWeight;
        }

        // 仅执行一次连通性 DDA 判定，双层共享该可见性
#if VPT_DUAL_VIS_WEIGHTED
        // 2026-10-01：可见性改为**乘子**，不再"把该探针整份排除后再按剩余权重归一化"。
        //
        // 旧写法在"某探针由可见变被遮挡"的那条线上有三个叠加效应：该探针的贡献被
        // 整份扣掉、分母 `acceptedWeight` 突变、`sum/total` 又把它放大一次 ⇒ 值沿
        // 那条线**突跳一条像素宽** —— 而这条线正好落在**几何棱/角**上（短 DDA 在棱上
        // 翻面，见 VPT_CACHE_PROBE_CONSERVATIVE），于是屏幕上就是"沿墙角的一条亮线"。
        //
        // 改成用户实测口径下的最小连续化：三线性权重**始终计入**（8 个权重之和恒为
        // 1），被遮挡的探针贡献 0。于是线上只丢"那一个探针的份额"，不再被归一化放大。
        // A/B：-DVPT_DUAL_VIS_WEIGHTED=0 回到旧写法。
        {
            float visibility =
                vptCacheProbeVisible(worldPos + surfaceNormal * 0.03, probeWorldPos)
                    ? 1.0
                    : 0.0;
            primaryAccum += primaryDirIrr * weight * visibility;
            secondaryAccum += secondaryDirIrr * weight * visibility;
            acceptedWeight += weight;
        }
#else
        if(vptCacheProbeVisible(worldPos + surfaceNormal * 0.03, probeWorldPos))
        {
            primaryAccum += primaryDirIrr * weight;
            secondaryAccum += secondaryDirIrr * weight;
            acceptedWeight += weight;
        }
#endif
    }

    if(acceptedWeight > 1.0e-5)
    {
        outPrimary = primaryAccum / acceptedWeight;
        outSecondary = secondaryAccum / acceptedWeight;
    }
}

// VPT-3.3A.1: solve the primary receiver response from the two fields.
void evaluateVPTDualLighting(
    vec3 hitPos,
    vec3 hitNormal,
    vec3 hitAlbedo,
    out vec3 localDirect,
    out vec3 localSecondary
)
{
    vec3 primaryIrr = vec3(0.0);
    vec3 secondaryIrr = vec3(0.0);
    sampleVPTDualDirectionalIrradiance(hitPos, hitNormal, primaryIrr, secondaryIrr);

    localDirect = primaryIrr * hitAlbedo * 0.92;
    localSecondary = secondaryIrr * hitAlbedo * 0.92;
}


const float LOCAL_LIGHT_GRID_CELL_SIZE =
    64.0;


const float LOCAL_LIGHT_MAX_RANGE =
    30.0;


uint localLightGridHash32(
    ivec3 cellCoord
)
{
    uint h =
        uint(cellCoord.x) *
        0x8da6b343u;

    h ^=
        uint(cellCoord.y) *
        0xd8163841u;

    h ^=
        uint(cellCoord.z) *
        0xcb1ab31fu;

    h ^= h >> 16u;
    h *= 0x7feb352du;
    h ^= h >> 15u;
    h *= 0x846ca68bu;
    h ^= h >> 16u;

    return
        h;
}


ivec3 localLightGridCellCoord(
    vec3 worldPos
)
{
    return
        ivec3(
            floor(
                worldPos /
                LOCAL_LIGHT_GRID_CELL_SIZE
            )
        );
}


int localLightGridNeighborMinOffset(
    float worldComponent
)
{
    float cellBase =
        floor(
            worldComponent /
            LOCAL_LIGHT_GRID_CELL_SIZE
        ) *
        LOCAL_LIGHT_GRID_CELL_SIZE;


    return
        worldComponent -
        cellBase <
        LOCAL_LIGHT_MAX_RANGE
            ? -1
            : 0;
}


int localLightGridNeighborMaxOffset(
    float worldComponent
)
{
    float cellBase =
        floor(
            worldComponent /
            LOCAL_LIGHT_GRID_CELL_SIZE
        ) *
        LOCAL_LIGHT_GRID_CELL_SIZE;


    return
        cellBase +
        LOCAL_LIGHT_GRID_CELL_SIZE -
        worldComponent <
        LOCAL_LIGHT_MAX_RANGE
            ? 1
            : 0;
}


uint localLightGridPackedIndexBase()
{
    return
        4u +
        localLightGridBuffer.words[2] *
        8u;
}


bool localLightGridLookupCell(
    ivec3 cellCoord,
    out uint firstLightIndex,
    out uint lightCount
)
{
    uint hashCapacity =
        localLightGridBuffer.words[2];


    if(hashCapacity == 0u)
    {
        firstLightIndex =
            0u;

        lightCount =
            0u;

        return
            false;
    }


    uint hashMask =
        hashCapacity -
        1u;


    uint slotIndex =
        localLightGridHash32(
            cellCoord
        ) &
        hashMask;


    for(
        uint probe = 0u;
        probe < hashCapacity;
        ++probe
    )
    {
        uint slotBase =
            4u +
            slotIndex *
            8u;


        if(
            localLightGridBuffer.words[
                slotBase +
                3u
            ] == 0u
        )
        {
            firstLightIndex =
                0u;

            lightCount =
                0u;

            return
                false;
        }


        if(
            int(
                localLightGridBuffer.words[
                    slotBase
                ]
            ) == cellCoord.x &&
            int(
                localLightGridBuffer.words[
                    slotBase +
                    1u
                ]
            ) == cellCoord.y &&
            int(
                localLightGridBuffer.words[
                    slotBase +
                    2u
                ]
            ) == cellCoord.z
        )
        {
            firstLightIndex =
                localLightGridBuffer.words[
                    slotBase +
                    4u
                ];

            lightCount =
                localLightGridBuffer.words[
                    slotBase +
                    5u
                ];

            return
                true;
        }


        slotIndex =
            (
                slotIndex +
                1u
            ) &
            hashMask;
    }


    firstLightIndex =
        0u;

    lightCount =
        0u;

    return
        false;
}


